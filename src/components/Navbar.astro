---
// src/components/Navbar.astro
---

<nav class="sticky top-0 z-50 bg-[#020617]/95 backdrop-blur-md border-b border-slate-700/50 py-4 px-6 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3">
        <img src="/images/logo.png" alt="SysArmor Tech Logo" class="h-10 w-auto" />
        <span class="text-xl font-bold tracking-tight text-white">
            SYSARMOR <span class="text-[#D4AF37]">TECH</span>
        </span>
    </a>

    <!-- Menú Desktop (Limpio y centrado en la navegación principal) -->
    <div class="hidden md:flex items-center gap-8 text-slate-300 font-medium">
        <a href="/#servicios" class="group relative hover:text-white transition-colors duration-300">
            Servicios
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/#enfoque-tecnico" class="group relative hover:text-white transition-colors duration-300">
            Enfoque Técnico
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/#casos-de-exito" class="group relative hover:text-white transition-colors duration-300">
            Casos de Éxito
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/#contacto" class="group relative hover:text-white transition-colors duration-300">
            Contacto
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
        </a>
        
        <!-- Botón CTA -->
        <a href="/#contacto" class="px-6 py-2.5 rounded-md bg-[#D4AF37] hover:bg-white text-[#020617] font-bold transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)] hover:shadow-[0_0_20px_rgba(255,255,255,0.2)]">
            Solicitar Evaluación Técnica
        </a>
    </div>

    <!-- Botón Hamburguesa -->
    <button id="menu-btn" class="md:hidden text-white p-2 focus:outline-none" aria-label="Abrir menú">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
    </button>
</nav>

<!-- Menú Mobile Overlay -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-0 top-[76px] bg-[#020617] p-6 flex flex-col gap-6 text-xl text-center z-40">
    <a href="/#servicios" class="text-white hover:text-[#D4AF37] py-2">Servicios</a>
    <a href="/#enfoque-tecnico" class="text-white hover:text-[#D4AF37] py-2">Enfoque Técnico</a>
    <a href="/#casos-de-exito" class="text-white hover:text-[#D4AF37] py-2">Casos de Éxito</a>
    <a href="/#contacto" class="text-white hover:text-[#D4AF37] py-2">Contacto</a>

    <a href="/#contacto" class="mt-2 px-5 py-4 rounded-lg bg-[#D4AF37] text-[#020617] font-bold text-lg hover:bg-white transition-colors">
        Evaluación Gratuita
    </a>
</div>

<script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');

    btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
    });

    menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            menu?.classList.add('hidden');
        });
    });
</script>