---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 h-[76px] w-full bg-[#0d1527] border-b border-slate-800">
  <nav class="w-full h-full px-4 sm:px-8 lg:px-12 flex items-center justify-between">
    <!-- LOGO CORPORATIVO CON ESCUDO CIRCULAR Y TEXTO -->
    <a href="/" class="flex items-center gap-3 py-1 group">
      <div class="relative h-11 w-11 sm:h-12 sm:w-12 rounded-full overflow-hidden border border-[#D4AF37]/50 shadow-[0_0_10px_rgba(212,175,55,0.2)] flex-shrink-0 bg-[#0d1527]">
        <img 
          src="/images/logo-navbar.webp" 
          alt="SysArmor Tech Logo" 
          class="h-full w-full object-cover scale-105"
        />
      </div>
      <span class="font-extrabold tracking-wider text-base sm:text-xl uppercase inline-flex items-center">
        <span class="text-white">SYSARMOR</span>
        <span class="text-[#D4AF37] ml-1.5">TECH</span>
      </span>
    </a>

    <!-- Menú Desktop -->
    <div class="hidden md:flex items-center gap-8 text-slate-300 font-medium">
      <a href="/#servicios" class="group relative hover:text-white transition-colors duration-300">
        Servicios
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/#enfoque-tecnico" class="group relative hover:text-white transition-colors duration-300">
        Enfoque Técnico
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/#casos-de-exito" class="group relative hover:text-white transition-colors duration-300">
        Casos de Éxito
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/blog" class="group relative hover:text-white transition-colors duration-300">
        Blog
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/tools" class="group relative hover:text-white transition-colors duration-300">
        Herramientas
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/#contacto" class="group relative hover:text-white transition-colors duration-300">
        Contacto
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#D4AF37] transition-all duration-300 group-hover:w-full"></span>
      </a>
      
      <a href="/#contacto" class="px-6 py-2.5 rounded-md bg-[#D4AF37] hover:bg-white text-[#020617] font-bold transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)]">
        Evaluación Técnica
      </a>
    </div>

    <!-- Botón Hamburguesa Móvil -->
    <button id="sys-menu-btn" type="button" class="md:hidden text-white p-2 focus:outline-none transition-transform active:scale-95" aria-label="Abrir menú">
      <svg id="sys-menu-icon" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16 M4 12h16 M17 18h-13" />
      </svg>
    </button>
  </nav>

  <!-- Menú Desplegable Móvil Sólido -->
  <div id="sys-mobile-dropdown" class="hidden md:hidden absolute top-[76px] inset-x-0 bg-[#0d1527] min-h-[calc(100vh-76px)] border-b border-slate-800 px-6 py-8 flex-col gap-4 text-lg text-center z-50 shadow-2xl">
    <a href="/#servicios" class="sys-link text-slate-200 hover:text-[#D4AF37] hover:bg-slate-800/40 py-3 rounded-lg transition-all">Servicios</a>
    <a href="/#enfoque-tecnico" class="sys-link text-slate-200 hover:text-[#D4AF37] hover:bg-slate-800/40 py-3 rounded-lg transition-all">Enfoque Técnico</a>
    <a href="/#casos-de-exito" class="sys-link text-slate-200 hover:text-[#D4AF37] hover:bg-slate-800/40 py-3 rounded-lg transition-all">Casos de Éxito</a>
    <a href="/blog" class="sys-link text-slate-200 hover:text-[#D4AF37] hover:bg-slate-800/40 py-3 rounded-lg transition-all">Blog</a>
    <a href="/tools" class="sys-link text-slate-200 hover:text-[#D4AF37] hover:bg-slate-800/40 py-3 rounded-lg transition-all">Herramientas</a>
    <a href="/#contacto" class="sys-link text-slate-200 hover:text-[#D4AF37] hover:bg-slate-800/40 py-3 rounded-lg transition-all">Contacto</a>

    <div class="pt-4 border-t border-slate-800 mt-2">
      <a href="/#contacto" class="sys-link block w-full py-3.5 px-4 rounded-xl bg-[#D4AF37] text-[#020617] font-bold text-base hover:bg-white transition-all shadow-md">
        Evaluación Gratuita
      </a>
    </div>
  </div>
</header>

<script>
  function initNavMenu() {
    const btn = document.getElementById('sys-menu-btn');
    const menu = document.getElementById('sys-mobile-dropdown');
    const icon = document.getElementById('sys-menu-icon');

    if (btn && menu && icon) {
      const freshBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(freshBtn, btn);

      const freshBtnElement = document.getElementById('sys-menu-btn');
      const freshIconElement = document.getElementById('sys-menu-icon');

      freshBtnElement?.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('hidden');
        menu.classList.toggle('flex');

        if (isOpen) {
          freshIconElement!.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16 M4 12h16 M17 18h-13" />`;
        } else {
          freshIconElement!.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6 M6 6l12 12" />`;
        }
      });

      menu.querySelectorAll('.sys-link').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          if (freshIconElement) {
            freshIconElement.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16 M4 12h16 M17 18h-13" />`;
          }
        });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initNavMenu);
  document.addEventListener('astro:page-load', initNavMenu);
</script>