---
// src/components/SuccessStories.astro
const successStories = [
  {
    category: "SECOPS & ENDPOINT SECURITY",
    title: "Blindaje ASR en +500 Dispositivos",
    description: "Despliegue de políticas avanzadas de Attack Surface Reduction (ASR) y afinamiento en Defender para entidad pública. Reducción drástica de la superficie de ataque y contención inmediata de vectores de riesgo."
  },
  {
    category: "IDENTITY & CLOUD SECURITY",
    title: "Gobierno PIM & Automatización Entra ID",
    description: "Implementación de acceso Just-In-Time (PIM) en entorno Multitenant bancario y automatización con PowerShell, reduciendo el tiempo de aprovisionamiento en un 50%."
  },
  {
    category: "VULNERABILITY MANAGEMENT",
    title: "Remediación Crítica Qualys / CVE",
    description: "Liderazgo del ciclo de remediación sobre parques de +200 servidores Windows. Hardening de llaves de registro, parcheo complejo y mitigación sin afectación operativa."
  }
];
---

<section id="casos-de-exito" class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-zinc-200 border-t border-zinc-300 flex flex-col justify-center items-center">
  <div class="max-w-[1400px] mx-auto space-y-12 w-full my-auto">
    
    <!-- Título de Sección -->
    <div class="text-center space-y-2">
      <h2 class="text-3xl font-display font-bold text-neutral-900 uppercase tracking-wide">Proyectos e Implementaciones</h2>
      <p class="text-zinc-700 font-medium text-base">Arquitectura, automatización e infraestructura de alto impacto.</p>
    </div>

    <!-- Grid simétrico de 3 columnas para los proyectos reales -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {successStories.map((story) => (
        <div class="p-6 md:p-7 rounded-xl border-2 bg-white text-neutral-900 border-zinc-300 shadow-md shadow-zinc-400/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="block text-xs font-bold tracking-wider uppercase truncate text-amber-700">
                {story.category}
              </span>
            </div>

            <h3 class="font-display font-bold mb-3 text-lg md:text-xl text-neutral-900">
              {story.title}
            </h3>

            <p class="text-sm leading-relaxed font-sans font-normal text-zinc-700">
              {story.description}
            </p>
          </div>
        </div>
      ))}
    </div>
    
  </div>
</section>