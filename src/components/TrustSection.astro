---
// src/components/TrustSection.astro

const skills = [
  { 
    name: "Windows Server / AD",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`
  },
  { 
    name: "GCP Cloud Eng.",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`
  },
  { 
    name: "Azure AZ-700 / 104",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`
  },
  { 
    name: "MS-500 / MS-100",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  },
  { 
    name: "MCSE / ITIL V3",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`
  },
];
---

<section id="certificaciones" class="w-full py-16 bg-slate-50 px-4 border-y border-slate-200 flex flex-col justify-center">
  <div class="max-w-6xl mx-auto space-y-10 text-center w-full">
    
    <!-- Título y Subtítulo -->
    <div class="space-y-2">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-slate-900 uppercase tracking-wide">
        Expertise Técnico & Certificaciones
      </h2>
      <p class="text-slate-600 font-medium text-base max-w-2xl mx-auto font-sans">
        Tecnologías y marcos de trabajo que domino para garantizar la resiliencia de tu infraestructura.
      </p>
    </div>
    
    <!-- Grid 5 Columnas -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
      {skills.map((skill) => (
        <div class="p-6 bg-white border border-slate-200 rounded-xl shadow-xs hover:shadow-md hover:border-blue-500 transition-all duration-300 flex flex-col items-center justify-center space-y-3">
          <div class="p-2.5 bg-blue-50 rounded-lg" Fragment set:html={skill.svg} />
          <span class="block font-bold text-slate-800 text-sm md:text-base font-sans">{skill.name}</span>
        </div>
      ))}
    </div>

  </div>
</section>