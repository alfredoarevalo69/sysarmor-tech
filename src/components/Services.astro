---
// src/components/Services.astro
const services = [
  {
    question: "¿Infraestructura expuesta o vulnerable?",
    title: "Evaluación & Hardening",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`,
    items: ["Microsoft 365", "Entra ID", "Defender & ASR", "PIM", "Vulnerabilidades"],
    cta: "Ver Documentación"
  },
  {
    question: "¿Fallas complejas en sistemas de nivel avanzado?",
    title: "Troubleshooting & Nivel 3",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    items: ["Troubleshooting Avanzado", "PowerShell & Scripting", "Windows Server", "Automatización & Recovery"],
    cta: "Ver Scripts & Herramientas"
  },
  {
    question: "¿Necesidad de migrar entornos sin afectar operación?",
    title: "Migración & Modernización",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>`,
    items: ["Azure", "Microsoft 365", "Servidores On-Premises", "Backup & Entornos Híbridos"],
    cta: "Ver Guías Técnicas"
  }
];
---

<section id="servicios" class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-zinc-200 border-t border-zinc-300 flex flex-col justify-center items-center scroll-mt-[76px]">
  <div class="max-w-6xl mx-auto space-y-8 w-full my-auto">
    
    <!-- Encabezado unificado -->
    <div class="text-center space-y-2">
      <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 tracking-tight">
        Áreas de Especialización y Enfoque Técnico
      </h2>
      <p class="text-zinc-700 font-medium text-xs sm:text-sm max-w-2xl mx-auto">
        Resolución de desafíos críticos en infraestructura, automatización y seguridad de sistemas heredados e híbridos.
      </p>
    </div>
    
    <!-- Tarjetas -->
    <div class="grid md:grid-cols-3 gap-6">
      {services.map((service) => (
        <article 
          class="bg-white border-2 border-zinc-300 rounded-xl overflow-hidden shadow-md shadow-zinc-400/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
        >
          
          <div class="p-6 space-y-4">
            <!-- Icono -->
            <div class="flex justify-center">
              <div class="w-12 h-12 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center shadow-xs">
                <Fragment set:html={service.iconSvg} />
              </div>
            </div>

            <!-- Pregunta Gancho + Título -->
            <div class="space-y-1.5 text-center">
              <h3 class="text-sm sm:text-base font-bold text-zinc-900 leading-snug">
                {service.question}
              </h3>
              
              <div class="text-[11px] font-bold text-amber-700 uppercase tracking-wider">
                {service.title}
              </div>
            </div>

            <hr class="border-zinc-200 my-2" />
            
            <!-- Checklist optimizado y proporcionado -->
            <ul class="space-y-2.5 text-zinc-700 text-xs sm:text-sm font-medium text-left w-full pl-2">
              {service.items.map((item) => (
                <li class="flex items-center gap-2.5">
                  <span class="text-amber-600 font-extrabold shrink-0" aria-hidden="true">✓</span> 
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <!-- Botón CTA -->
          <div class="p-6 pt-0">
            <a 
              href="/blog" 
              class="block w-full bg-zinc-900 hover:bg-zinc-800 text-white text-center py-2.5 rounded-lg font-bold transition-all duration-200 shadow-sm text-sm"
            >
              {service.cta}
            </a>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>