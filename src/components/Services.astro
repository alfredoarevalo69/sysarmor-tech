---
// src/components/Services.astro

const services = [
  {
    question: "¿Le preocupa que su infraestructura esté expuesta?",
    title: "Evaluación & Hardening",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`,
    items: ["Microsoft 365", "Entra ID", "Defender & ASR", "PIM", "Vulnerabilidades"],
    cta: "Evaluar Seguridad"
  },
  {
    question: "¿Su equipo de TI necesita ayuda con fallas complejas?",
    title: "Soporte Especializado Nivel 3",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    items: ["Troubleshooting Avanzado", "PowerShell & Scripting", "Windows Server", "Automatización & Recovery"],
    cta: "Solicitar Diagnóstico"
  },
  {
    question: "¿Necesita migrar sin interrumpir la operación?",
    title: "Migración & Modernización",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>`,
    items: ["Azure", "Microsoft 365", "Servidores On-Premises", "Backup & Entornos Híbridos"],
    cta: "Evaluar Migración"
  }
];
---

<!-- Reducido a scroll-mt-16 para subir la sección -->
<section id="servicios" class="py-12 bg-neutral-100 border-t border-neutral-200 px-4 scroll-mt-16">
  <div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Encabezado con texto en negrita/medio y más oscuro -->
    <div class="text-center space-y-1.5">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-neutral-900 tracking-wide uppercase">
        Soluciones a su medida
      </h2>
      <p class="text-slate-700 font-medium text-base max-w-2xl mx-auto">
        Resolvemos problemas críticos de infraestructura que impiden el crecimiento o comprometen la seguridad de su empresa.
      </p>
    </div>
    
    <!-- Tarjetas -->
    <div class="grid md:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class="bg-white border border-neutral-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          
          <div class="p-6 space-y-4">
            <!-- Icono -->
            <div class="flex justify-center">
              <div class="w-12 h-12 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center shadow-xs" Fragment set:html={service.iconSvg} />
            </div>

            <!-- Pregunta Gancho + Título -->
            <div class="space-y-1.5 text-center">
              <h3 class="text-base font-bold text-neutral-900 leading-snug">
                {service.question}
              </h3>
              
              <div class="text-[11px] font-bold text-amber-700 uppercase tracking-wider">
                {service.title}
              </div>
            </div>

            <hr class="border-neutral-100" />
            
            <!-- Checklist -->
            <ul class="space-y-2.5 text-slate-800 text-base font-semibold">
              {service.items.map((item) => (
                <li class="flex items-center gap-2.5 font-sans">
                  <span class="text-amber-600 font-extrabold text-base">✓</span> {item}
                </li>
              ))}
            </ul>
          </div>
          
          <!-- Botón -->
          <div class="p-6 pt-0">
            <a href="#contacto" 
               class="block w-full bg-slate-800 hover:bg-slate-900 text-white text-center py-2.5 rounded-lg font-bold transition-all duration-200 shadow-sm text-sm">
              {service.cta}
            </a>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>