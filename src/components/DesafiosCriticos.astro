---
// src/components/DesafiosCriticos.astro

const desafios = [
  { title: "Sistemas Legados", desc: "Plataformas fuera de soporte (EOL) que comprometen la estabilidad." },
  { title: "Brechas de Seguridad", desc: "Falta de estrategia de hardening (ASR/Defender) que deja data expuesta." },
  { title: "Ineficiencia Operativa", desc: "Procesos manuales y gestión de identidades desordenada que drenan el presupuesto." },
  { title: "Falta de Compliance", desc: "Ausencia de gobernanza bajo estándares ISO 27001 que bloquea sectores regulados." }
];
---

<!-- min-h-[calc(100vh-76px)] y centrado vertical exacto para escritorio, con flujo seguro en móvil -->
<section class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-100 border-y border-slate-200 flex flex-col justify-center items-center">
  <div class="max-w-6xl mx-auto w-full my-auto space-y-10">
    
    <!-- Encabezado -->
    <div class="text-center space-y-2">
      <h2 class="text-2xl md:text-3xl font-display font-bold text-neutral-900 tracking-wide uppercase">
        ¿Su infraestructura está limitando su crecimiento?
      </h2>
      <p class="text-neutral-600 font-medium text-base font-sans max-w-2xl mx-auto">
        Si su equipo enfrenta estos escenarios, necesita una intervención de Nivel 3.
      </p>
    </div>
    
    <!-- Grid de Desafíos -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {desafios.map(item => (
        <div class="bg-white p-6 md:p-8 rounded-xl border-t-4 border-blue-600 border-x border-b border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-display font-bold text-blue-700 mb-3">
              {item.title}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed font-sans">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>