---
// src/components/DesafiosCriticos.astro

const desafios = [
  { title: "Sistemas Legados", desc: "Plataformas fuera de soporte (EOL) que comprometen la estabilidad." },
  { title: "Brechas de Seguridad", desc: "Falta de estrategia de hardening (ASR/Defender) que deja data expuesta." },
  { title: "Ineficiencia Operativa", desc: "Procesos manuales y gestión de identidades desordenada que drenan el presupuesto." },
  { title: "Falta de Compliance", desc: "Ausencia de gobernanza bajo estándares ISO 27001 que bloquea sectores regulados." }
];
---

<section class="py-20 bg-slate-100 border-y border-slate-200 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-display font-bold text-neutral-900 mb-4 text-center">
      ¿Su infraestructura está limitando su crecimiento?
    </h2>
    <p class="text-center text-neutral-600 mb-12 font-sans">
      Si su equipo enfrenta estos escenarios, necesita una intervención de Nivel 3.
    </p>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {desafios.map(item => (
        <div class="bg-white p-8 rounded-lg border-t-4 border-blue-600 border-x border-b border-slate-200 shadow-sm hover:shadow-md transition-all">
          {/* Aquí aplicamos text-blue-700 para darle esa vida y saturación que buscabas */}
          <h3 class="text-lg font-display font-bold text-blue-700 mb-3">
            {item.title}
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed font-sans">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>