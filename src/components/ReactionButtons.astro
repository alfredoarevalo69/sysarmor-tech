---
// src/components/ReactionButtons.astro
interface Props {
  articleTitle: string;
}

const { articleTitle } = Astro.props;
---

<div class="reaction-wrapper my-8 p-6 bg-slate-900 border border-slate-800 rounded-2xl text-center shadow-md">
  <!-- Estado Inicial: Botones -->
  <div id="fb-initial-view">
    <p class="text-sm font-semibold text-slate-200 mb-3">¿Te resultó útil esta documentación?</p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-3">
      <button 
        type="button"
        class="reaction-btn flex items-center gap-2 px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 font-medium text-sm border border-slate-700 cursor-pointer transition-all active:scale-95" 
        data-vote="like"
        data-title={articleTitle}
      >
        👍 <span>Útil</span>
      </button>

      <button 
        type="button"
        class="reaction-btn flex items-center gap-2 px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-sm border border-slate-700 cursor-pointer transition-all active:scale-95" 
        data-vote="dislike"
        data-title={articleTitle}
      >
        👎 <span>No útil</span>
      </button>
    </div>
  </div>

  <!-- Tarjeta de Éxito (Voto Útil) -->
  <div id="fb-card-useful" class="hidden text-center py-2">
    <div class="text-emerald-400 font-semibold text-sm mb-1 flex items-center justify-center gap-2">
      <span>✨</span> ¡Muchas gracias por tu feedback positivo!
    </div>
    <p class="text-xs text-slate-400">Tu opinión nos ayuda a mejorar continuamente los manuales de infraestructura.</p>
  </div>

  <!-- Tarjeta de Feedback Negativo (Voto No Útil) -->
  <div id="fb-card-useless" class="hidden text-left max-w-md mx-auto py-2">
    <p class="text-xs font-semibold text-slate-200 mb-2 text-center">Ayúdanos a mejorar:</p>
    <div class="space-y-2">
      <select id="reason-select" class="w-full bg-slate-800 text-slate-200 text-xs rounded-lg border border-slate-700 p-2 focus:ring-1 focus:ring-amber-400 outline-none">
        <option value="Falta información o contexto">Falta información o contexto</option>
        <option value="No solucionó mi problema técnico">No solucionó mi problema técnico</option>
        <option value="Instrucciones desactualizadas o erróneas">Instrucciones desactualizadas o erróneas</option>
      </select>
      <button 
        type="button" 
        id="submit-reason-btn"
        class="w-full py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-semibold text-xs rounded-lg transition-all cursor-pointer"
      >
        Enviar comentario
      </button>
    </div>
  </div>

  <!-- Mensaje de agradecimiento final post-comentario -->
  <div id="fb-final-msg" class="hidden text-center py-2">
    <p class="text-xs text-emerald-400 font-semibold">¡Gracias por tus comentarios! Los hemos registrado correctamente.</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initialView = document.getElementById('fb-initial-view');
    const cardUseful = document.getElementById('fb-card-useful');
    const cardUseless = document.getElementById('fb-card-useless');
    const finalMsg = document.getElementById('fb-final-msg');
    const buttons = document.querySelectorAll('.reaction-btn');
    const reasonSelect = document.getElementById('reason-select') as HTMLSelectElement;
    const submitReasonBtn = document.getElementById('submit-reason-btn');

    let currentVoteData = { vote: '', articleTitle: '' };

    buttons.forEach((button) => {
      button.addEventListener('click', async () => {
        const vote = button.getAttribute('data-vote');
        const articleTitle = button.getAttribute('data-title') || document.title;
        currentVoteData = { vote: vote || '', articleTitle };

        if (vote === 'like') {
          // Ocultar vista inicial y mostrar tarjeta útil
          initialView?.classList.add('hidden');
          cardUseful?.classList.remove('hidden');

          // Enviar de inmediato al backend
          await sendReaction(vote, articleTitle, 'Explicación clara y directa');
        } else {
          // Ocultar vista inicial y mostrar formulario de motivo
          initialView?.classList.add('hidden');
          cardUseless?.classList.remove('hidden');
        }
      });
    });

    submitReasonBtn?.addEventListener('click', async () => {
      const reason = reasonSelect ? reasonSelect.value : 'Sin motivo especificado';
      
      cardUseless?.classList.add('hidden');
      finalMsg?.classList.remove('hidden');

      await sendReaction(currentVoteData.vote, currentVoteData.articleTitle, reason);
    });

    async function sendReaction(vote: string, articleTitle: string, reason: string) {
      try {
        await fetch('/api/reaction', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ articleTitle, vote, reason }),
        });
      } catch (error) {
        console.error('Error enviando reacción:', error);
      }
    }
  });
</script>

<style>
  .reaction-wrapper, 
  .reaction-wrapper * {
    -webkit-user-select: auto !important;
    -moz-user-select: auto !important;
    -ms-user-select: auto !important;
    user-select: auto !important;
    pointer-events: auto !important;
  }
</style>
