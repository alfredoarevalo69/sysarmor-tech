---
// src/components/AutoridadTecnica.astro
---

<!-- min-h-[calc(100vh-76px)] y centrado vertical exacto para escritorio, con flujo seguro en móvil -->
<section id="enfoque-tecnico" class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-100 border-t border-slate-200 flex flex-col justify-center items-center">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center w-full my-auto">

    <!-- Lado Izquierdo: Trayectoria -->
    <div class="space-y-6">

      <h2 class="text-3xl font-display font-bold text-neutral-900 uppercase tracking-wide">
        Trayectoria y Respaldo Técnico
      </h2>

      <div class="space-y-4 text-neutral-700 font-sans leading-relaxed">

        <h3 class="text-xl font-bold text-neutral-900">
          20+ Años de Experiencia en Infraestructura Crítica
        </h3>

        <p>
          Hemos liderado iniciativas de modernización y operación de infraestructura
          en <strong class="text-neutral-900 font-bold">entornos empresariales y gubernamentales de alta exigencia</strong>,
          con experiencia en los sectores financiero, energético, público y de servicios.
        </p>

        <p>
          Nuestra experiencia combina{" "}
          <strong class="text-neutral-900 font-bold">
            infraestructura Microsoft, Cloud, automatización, seguridad y operaciones
          </strong>,
          con la gestión estratégica de entornos híbridos de alta disponibilidad,
          priorizando resiliencia, continuidad operativa y mantenibilidad.
        </p>

      </div>
    </div>


    <!-- Lado Derecho: Experiencia Técnica -->
    <div class="bg-neutral-900 text-white p-6 md:p-8 rounded-xl shadow-xl border border-neutral-800">

      <h3 class="text-xl font-display font-bold mb-6 border-b border-neutral-800 pb-4">
        Experiencia Técnica y Capacidades
      </h3>

      <ul class="space-y-6">

        <!-- Microsoft Infrastructure -->
        <li>
          <span class="block text-[#D4AF37] font-bold mb-1 uppercase tracking-wider text-sm">
            MICROSOFT & HYBRID INFRASTRUCTURE
          </span>

          <p class="text-sm text-neutral-300">
            Windows Server · Microsoft 365 · Active Directory · Exchange · Hyper-V ·
            Azure Administration · Infraestructura Híbrida
          </p>
        </li>


        <!-- Cloud & Networking -->
        <li>
          <span class="block text-[#D4AF37] font-bold mb-1 uppercase tracking-wider text-sm">
            CLOUD & NETWORKING
          </span>

          <p class="text-sm text-neutral-300">
            Azure · Google Cloud · VNet Peering · VPN Site-to-Site ·
            Conectividad Híbrida · Redes TCP/IP
          </p>
        </li>


        <!-- Automation & Operations -->
        <li>
          <span class="block text-[#D4AF37] font-bold mb-1 uppercase tracking-wider text-sm">
            AUTOMATION & OPERATIONS
          </span>

          <p class="text-sm text-neutral-300">
            PowerShell · Infrastructure Automation · Patch Management ·
            Backup & Recovery · Soporte Nivel 3
          </p>
        </li>


        <!-- Security & Identity -->
        <li>
          <span class="block text-[#D4AF37] font-bold mb-1 uppercase tracking-wider text-sm">
            SECURITY & IDENTITY
          </span>

          <p class="text-sm text-neutral-300">
            Microsoft Entra ID · PIM · Conditional Access · Defender ·
            ASR · Hardening · Vulnerability Management
          </p>
        </li>


        <!-- Governance & Compliance -->
        <li>
          <span class="block text-[#D4AF37] font-bold mb-1 uppercase tracking-wider text-sm">
            GOVERNANCE & COMPLIANCE
          </span>

          <p class="text-sm text-neutral-300">
            ITIL V3 Foundation · ISO 27001 — Especialista certificado en el equipo
          </p>
        </li>

      </ul>
    </div>

  </div>
</section>