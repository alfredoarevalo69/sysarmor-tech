// src/components/Footer.astro
---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0d1527] border-t border-slate-700 py-8 px-4 sm:px-8 lg:px-12 w-full">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-100">
    
    <!-- Lado Izquierdo: Marca, Copyright y Enlaces (alineado hacia la izquierda) -->
    <div class="flex flex-col sm:flex-row items-center gap-4 md:gap-6">
      <div class="flex items-center gap-2">
        <span class="font-bold text-white tracking-wider">
          SYSARMOR <span class="text-[#D4AF37]">TECH</span>
        </span>
        <span class="text-slate-300">— &copy; {currentYear} Todos los derechos reservados.</span>
      </div>

      <!-- Enlaces Legales -->
      <div class="flex items-center gap-4 text-xs md:text-sm font-medium">
        <a href="/privacidad" class="text-slate-200 hover:text-white transition-colors duration-200 underline-offset-4 hover:underline">
          Política de Privacidad
        </a>
        <span class="text-slate-500" aria-hidden="true">|</span>
        <a href="/terminos" class="text-slate-200 hover:text-white transition-colors duration-200 underline-offset-4 hover:underline">
          Términos de Servicio
        </a>
      </div>
    </div>

    <!-- Lado Derecho: Slogan final -->
    <div class="text-slate-200 text-xs md:text-sm text-center md:text-right font-sans font-medium">
      Optimización y Gestión de Infraestructura Híbrida y Cloud.
    </div>

  </div>
</footer>