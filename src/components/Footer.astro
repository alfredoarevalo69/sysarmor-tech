// src/components/Footer.astro
---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#020617] border-t border-slate-800 py-8 px-6 w-full">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-400">
    
    <!-- Lado Izquierdo: Marca y Copyright -->
    <div class="flex items-center gap-2">
      <span class="font-bold text-white tracking-wider">
        SYSARMOR <span class="text-[#D4AF37]">TECH</span>
      </span>
      <span class="text-slate-500">— &copy; {currentYear} Todos los derechos reservados.</span>
    </div>

    <!-- Centro: Enlaces Legales -->
    <div class="flex items-center gap-4 text-xs md:text-sm">
      <a href="/privacidad" class="text-slate-400 hover:text-white transition-colors duration-200">
        Política de Privacidad
      </a>
      <span class="text-slate-700" aria-hidden="true">|</span>
      <a href="/terminos" class="text-slate-400 hover:text-white transition-colors duration-200">
        Términos de Servicio
      </a>
    </div>

    <!-- Lado Derecho: Slogan -->
    <div class="text-slate-500 text-xs md:text-sm text-center md:text-right font-sans">
      SecOps, Hardening e Infraestructura Híbrida de Nivel 3.
    </div>

  </div>
</footer>