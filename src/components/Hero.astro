---
// No requiere import de imágenes al estar en /public/images/
---

<section class="hero-container">
  <!-- Imagen de fondo -->
  <img 
    src="/images/hero-datacenter.webp" 
    alt="Fondo Infraestructura Crítica y Ecosistema Microsoft" 
    class="hero-bg"
    loading="eager" 
    fetchpriority="high"
  />

  <!-- Capa overlay de gradiente para contraste WCAG -->
  <div class="hero-overlay"></div>

  <!-- Bloque de contenido principal -->
  <div class="hero-content">
    <h1 class="hero-title">
      Proteja y modernice su infraestructura <span class="highlight">sin detener la operación</span>
    </h1>

    <p class="hero-description">
      Ayudamos a empresas con infraestructura crítica o <strong class="highlight-yellow">ecosistema Microsoft</strong> a resolver problemas de seguridad, sistemas legados, migraciones y operaciones de Nivel 3.
    </p>

    <div class="hero-cta">
      <a href="#contacto" class="btn-primary">Solicitar Evaluación Técnica</a>
    </div>

    <ul class="hero-features">
      <li>
        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>+20 años de experiencia en infraestructura y seguridad</span>
      </li>
      <li>
        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Garantía de continuidad operativa durante migraciones</span>
      </li>
    </ul>
  </div>
</section>

<style>
  /* --- CONTENEDOR PRINCIPAL --- */
  .hero-container {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 76px); /* Ocupa el 100% de la pantalla visible restando la Navbar */
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #050a14;
    padding: 4rem 2rem;
  }

  /* --- IMAGEN DE FONDO --- */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  /* --- OVERLAY DE GRADIENTE (Ajustado para pantallas grandes) --- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg, 
      rgba(5, 10, 20, 0.85) 0%, 
      rgba(5, 10, 20, 0.70) 60%, 
      rgba(5, 10, 20, 1) 100%
    ),
    linear-gradient(
      90deg, 
      rgba(5, 10, 20, 0.95) 0%, 
      rgba(5, 10, 20, 0.60) 50%, 
      rgba(5, 10, 20, 0.10) 100%
    );
    z-index: 2;
  }

  /* --- CONTENIDO CON ANIMACIÓN FADE-UP --- */
  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 680px;
    margin-left: 0;
    margin-right: auto;
    width: 100%;
    text-align: left;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- TIPOGRAFÍA --- */
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: #eab308;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: #e2e8f0;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .highlight-yellow {
    color: #eab308;
    font-weight: 700;
  }

  /* --- BOTÓN Y LISTA --- */
  .hero-cta {
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    width: 100%;
    max-width: 380px;
    padding: 1rem 1.5rem;
    background-color: #d97706;
    color: #0f172a;
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #b45309;
    transform: translateY(-2px);
  }

  .hero-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 600;
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: #eab308;
    flex-shrink: 0;
  }

  /* --- AJUSTES RESPONSIVE --- */
  @media (max-width: 768px) {
    .hero-container {
      padding: 3rem 1rem;
    }

    .hero-bg {
      object-position: 85% center;
    }

    .hero-overlay {
      background: linear-gradient(
        180deg, 
        rgba(5, 10, 20, 0.88) 0%, 
        rgba(5, 10, 20, 0.82) 70%, 
        rgba(5, 10, 20, 0.95) 100%
      );
    }

    .btn-primary {
      max-width: 100%;
    }
  }
</style>