---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBgImg from '../assets/images/hero-datacenter.webp';
---

<section class="hero-container">
  <!-- Imagen de fondo optimizada con el motor de Astro/Vercel (solo desktop) -->
  <Image 
    src={heroBgImg} 
    alt="Fondo Infraestructura Crítica y Ecosistema Microsoft" 
    width={1920}
    height={1080}
    format="webp"
    quality={75}
    loading="eager" 
    fetchpriority="high"
    decoding="sync"
    class="hero-bg"
  />

  <!-- Capa overlay optimizada para escritorio -->
  <div class="hero-overlay"></div>

  <!-- Contenedor general alineado a la Navbar -->
  <div class="hero-inner">
    <!-- Bloque de contenido principal -->
    <div class="hero-content">
      <h1 class="hero-title">
        Ingeniería de Infraestructura, Cloud y <span class="highlight">Ciberseguridad Defensiva</span>
      </h1>

      <p class="hero-description">
        Soluciones de alta disponibilidad, modernización a <strong class="highlight-yellow">Windows Server 2025</strong> y blindaje de entornos híbridos respaldadas por más de 20 años de trayectoria experta.
      </p>

      <div class="hero-cta">
        <a href="#contacto" class="btn-primary">Solicitar Evaluación Técnica</a>
      </div>

      <ul class="hero-features">
        <li>
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>+20 años de experiencia en infraestructura y seguridad</span>
        </li>
        <li>
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Especialistas en Hardening, ASR, Entra ID y Windows Server</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* --- CONTENEDOR PRINCIPAL --- */
  .hero-container {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #050a14;
    padding: 4rem 1.5rem;
  }

  /* --- CONTENEDOR INTERNO ALINEADO A LA NAVBAR --- */
  .hero-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 3;
  }

  /* --- IMAGEN DE FONDO --- */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  /* --- OVERLAY DESKTOP --- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: transparent;
    background-image: linear-gradient(
      90deg, 
      #050a14 0%, 
      rgba(5, 10, 20, 0.95) 40%, 
      rgba(5, 10, 20, 0.30) 65%, 
      rgba(5, 10, 20, 0.0) 100%
    );
    z-index: 2;
  }

  /* --- CONTENIDO PRINCIPAL --- */
  .hero-content {
    max-width: 720px;
    text-align: left;
  }

  /* --- TIPOGRAFÍA --- */
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: #eab308;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: #e2e8f0;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .highlight-yellow {
    color: #eab308;
    font-weight: 700;
  }

  /* --- BOTÓN Y LISTA --- */
  .hero-cta {
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    width: 100%;
    max-width: 380px;
    padding: 1rem 1.5rem;
    background-color: #d97706;
    color: #0f172a;
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #b45309;
    transform: translateY(-2px);
  }

  .hero-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 600;
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: #eab308;
    flex-shrink: 0;
  }

  /* --- AJUSTES RESPONSIVE MÓVIL --- */
  @media (max-width: 768px) {
    .hero-container {
      padding: 2.5rem 1.25rem 4rem 1.25rem;
      min-height: auto;
      background: radial-gradient(circle at 50% 10%, #172849 0%, #070b12 80%);
      border-bottom: 1px solid rgba(217, 119, 6, 0.15);
    }

    .hero-container::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 260px;
      height: 260px;
      background: rgba(245, 158, 11, 0.12);
      filter: blur(45px);
      border-radius: 50%;
      z-index: 1;
      pointer-events: none;
    }

    .hero-inner {
      padding: 0;
      z-index: 2;
    }

    .hero-bg {
      display: none;
    }

    .hero-overlay {
      background-image: none;
    }

    .hero-title {
      font-size: 1.85rem;
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin-bottom: 1rem;
    }

    .hero-description {
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
      color: #cbd5e1;
    }

    .hero-cta {
      margin-bottom: 1.75rem;
    }

    .btn-primary {
      display: block;
      width: 100%;
      max-width: 100%;
      padding: 1rem 1.25rem;
      font-size: 1.05rem;
      border-radius: 10px;
      box-shadow: 0 8px 20px -4px rgba(217, 119, 6, 0.35);
      text-align: center;
    }

    .hero-features {
      gap: 0.6rem;
    }

    .hero-features li {
      font-size: 0.9rem;
    }
  }
</style>