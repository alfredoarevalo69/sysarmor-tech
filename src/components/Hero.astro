---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBgImg from '../assets/images/hero-datacenter.webp';
---

<section class="hero-container">
  <Image 
    src={heroBgImg} 
    alt="Fondo Infraestructura Crítica y Ecosistema Microsoft" 
    width={1920}
    height={1080}
    format="webp"
    quality={75}
    loading="eager" 
    fetchpriority="high"
    decoding="sync"
    class="hero-bg"
  />

  <!-- Contenedor idéntico al <nav> del Navbar, sin restricciones de max-width para evitar el centrado en pantallas ultra-wide -->
  <div class="hero-inner">
    <div class="hero-content">
      
      <!-- Isotipo con animación de pulso sutil (EXCLUSIVO PARA MÓVIL) -->
      <div class="mobile-badge-container md:hidden">
        <div class="mobile-badge">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
      </div>

      <h1 class="hero-title">
        Especialistas en infraestructura crítica y <br />
        <span class="highlight">actualización de sistemas legados</span>
      </h1>

      <p class="hero-description">
        Ofrecemos soluciones integrales para garantizar la continuidad de su negocio y el blindaje de plataformas corporativas, respaldadas por dos décadas de experiencia técnica.
      </p>

      <div class="hero-cta">
        <a href="#contacto" class="btn-primary">Solicitar Evaluación Sin Compromiso</a>
      </div>

      <ul class="hero-features">
        <li>
          <span class="feature-icon" aria-hidden="true">🛡️</span>
          <span>Arquitectura de directorios corporativos y sincronización de identidades</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">☁️</span>
          <span>Actualización de sistemas legados e integración con Microsoft 365</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-container {
    position: relative;
    width: 100%;
    padding: 3rem 0;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #050a14;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center; 
    z-index: 1;
  }

  .hero-inner {
    width: 100%;
    padding-left: 1rem;
    padding-right: 1rem;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
  }

  @media (min-width: 640px) {
    .hero-inner {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-inner {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }

  .hero-content {
    width: 100%;
    max-width: 620px;
    text-align: left;
    z-index: 3;
    margin-right: auto;
  }

  /* Oculto por defecto en escritorio */
  .mobile-badge-container {
    display: none;
  }

  .hero-title {
    font-size: clamp(2rem, 3.2vw, 3.1rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .highlight {
    color: #eab308;
  }

  .hero-description {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: #e2e8f0;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .hero-cta {
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    display: inline-block;
    width: 100%;
    max-width: 360px;
    padding: 0.9rem 1.5rem;
    background-color: #d97706;
    color: #0f172a;
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #b45309;
    transform: translateY(-2px);
  }

  .hero-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #f8fafc;
    font-size: 0.93rem;
    font-weight: 600;
  }

  .feature-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    width: 24px;
    text-align: center;
  }

  @media (max-width: 968px) {
    .hero-container {
      padding: 2.5rem 0 3.5rem 0;
      min-height: auto;
      background-color: #070b12;
      background-image: 
        radial-gradient(circle at 50% 15%, rgba(217, 119, 6, 0.12) 0%, transparent 60%),
        linear-gradient(to right, rgba(30, 41, 59, 0.2) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(30, 41, 59, 0.2) 1px, transparent 1px);
      background-size: 100% 100%, 2.5rem 2.5rem, 2.5rem 2.5rem;
      border-bottom: 1px solid rgba(217, 119, 6, 0.2);
    }

    .hero-inner {
      display: flex;
      flex-direction: column;
      z-index: 2;
    }

    .hero-content {
      max-width: 100%;
      text-align: center;
    }

    .mobile-badge-container {
      display: flex !important;
      justify-content: center;
      width: 100%;
      margin-bottom: 1.25rem;
    }

    .mobile-badge {
      width: 60px !important;
      height: 60px !important;
      min-width: 60px;
      min-height: 60px;
      border-radius: 1rem;
      background-color: rgba(15, 23, 42, 0.95);
      border: 1px solid rgba(245, 158, 11, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 20px -3px rgba(245, 158, 11, 0.15);
      animation: subtle-pulse 3s infinite ease-in-out;
    }

    .mobile-badge svg {
      width: 28px !important;
      height: 28px !important;
      min-width: 28px;
      min-height: 28px;
      color: #f59e0b;
    }

    .hero-bg {
      display: none;
    }

    .hero-title {
      font-size: 1.85rem;
      line-height: 1.15;
      margin-bottom: 1rem;
    }

    .hero-description {
      font-size: 1.05rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
      color: #cbd5e1;
    }

    .hero-cta {
      margin-bottom: 1.5rem;
    }

    .btn-primary {
      display: block;
      width: 100%;
      max-width: 100%;
      padding: 1rem 1.25rem;
      font-size: 1.05rem;
      border-radius: 10px;
      text-align: center;
    }

    .hero-features {
      gap: 0.6rem;
      text-align: left;
    }

    .hero-features li {
      font-size: 0.9rem;
    }
  }

  @keyframes subtle-pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.15);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.3);
    }
  }
</style>