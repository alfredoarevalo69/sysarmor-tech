<style>
  /* --- CONTENEDOR PRINCIPAL --- */
  .hero-container {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #020617; /* Slate-950 alineado a tu layout */
    padding: 4rem 0; /* Removido padding lateral para permitir full bleed */
  }

  /* --- CONTENEDOR INTERNO ALINEADO A LA NAVBAR --- */
  .hero-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 3;
  }

  /* --- IMAGEN DE FONDO FULL WIDTH --- */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center; /* Empuja el gráfico principal a la derecha */
    z-index: 1;
  }

  /* --- OVERLAY OPTIMIZADO PARA CONTRASTE Y COBERTURA COMPLETA --- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Unificamos el gradiente para que no lave en exceso los bordes */
    background: linear-gradient(
      90deg, 
      rgba(2, 6, 23, 0.95) 0%, 
      rgba(2, 6, 23, 0.75) 45%, 
      rgba(2, 6, 23, 0.30) 100%
    );
    z-index: 2;
  }

  /* --- CONTENIDO CON ANIMACIÓN FADE-UP --- */
  .hero-content {
    max-width: 650px;
    text-align: left;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- TIPOGRAFÍA --- */
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: #eab308;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: #e2e8f0;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .highlight-yellow {
    color: #eab308;
    font-weight: 700;
  }

  /* --- BOTÓN Y LISTA --- */
  .hero-cta {
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    width: 100%;
    max-width: 380px;
    padding: 1rem 1.5rem;
    background-color: #d97706;
    color: #0f172a;
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #b45309;
    transform: translateY(-2px);
  }

  .hero-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 600;
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: #eab308;
    flex-shrink: 0;
  }

  /* --- AJUSTES RESPONSIVE --- */
  @media (max-width: 768px) {
    .hero-container {
      padding: 3rem 0;
    }

    .hero-inner {
      padding: 0 1rem;
    }

    .hero-bg {
      object-position: center center;
    }

    .hero-overlay {
      background: linear-gradient(
        180deg, 
        rgba(2, 6, 23, 0.90) 0%, 
        rgba(2, 6, 23, 0.80) 60%, 
        rgba(2, 6, 23, 0.95) 100%
      );
    }

    .btn-primary {
      max-width: 100%;
    }
  }
</style>