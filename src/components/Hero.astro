---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBgImg from '../assets/images/hero-datacenter.webp';
---

<section class="hero-container">
  <Image 
    src={heroBgImg} 
    alt="Fondo Infraestructura Crítica y Ecosistema Microsoft" 
    width={1920}
    height={1080}
    format="webp"
    quality={75}
    loading="eager" 
    fetchpriority="high"
    decoding="sync"
    class="hero-bg"
  />

  <!-- Overlay corregido: Oscuro sólido a la izquierda, transparente hacia la derecha -->
  <div class="hero-overlay"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-title">
        Especialistas en infraestructura crítica y <br />
        <span class="highlight">actualización de sistemas legados</span>
      </h1>

      <p class="hero-description">
        Ofrecemos soluciones integrales para garantizar la continuidad de su negocio y el blindaje de plataformas corporativas, respaldadas por dos décadas de experiencia técnica.
      </p>

      <div class="hero-cta">
        <a href="#contacto" class="btn-primary">Solicitar Evaluación Sin Compromiso</a>
      </div>

      <ul class="hero-features">
        <li>
          <span class="feature-icon" aria-hidden="true">🛡️</span>
          <span>Arquitectura de directorios corporativos y sincronización de identidades</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">☁️</span>
          <span>Actualización de sistemas legados e integración con Microsoft 365</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-container {
    position: relative;
    width: 100%;
    /* Padding superior cero para que el bloque despegue arriba de inmediato */
    padding: 1rem 0 2.5rem 0;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #050a14;
  }

  .hero-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  /* --- OVERLAY CORREGIDO: Bloque sólido a la izquierda, limpia la derecha --- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: transparent;
    background-image: linear-gradient(
      90deg, 
      #050a14 0%,      
      #050a14 45%,     
      rgba(5, 10, 20, 0.85) 60%, 
      transparent 80%  
    );
    z-index: 2;
  }

  .hero-content {
    width: 100%;
    max-width: 680px; 
    text-align: left;
    z-index: 3;
    /* Subimos el contenido de forma absoluta respecto a su contenedor */
    margin-top: -1rem;
  }

  .hero-title {
    font-size: clamp(2rem, 3.2vw, 3.1rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .highlight {
    color: #eab308;
  }

  .hero-description {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: #e2e8f0;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .hero-cta {
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    display: inline-block;
    width: 100%;
    max-width: 360px;
    padding: 0.9rem 1.5rem;
    background-color: #d97706;
    color: #0f172a;
    font-weight: 700;
    font-size: 1.05rem;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #b45309;
    transform: translateY(-2px);
  }

  .hero-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #f8fafc;
    font-size: 0.93rem;
    font-weight: 600;
  }

  .feature-icon {
    font-size: 1.15rem;
    flex-shrink: 0;
    width: 24px;
    text-align: center;
  }

  @media (max-width: 968px) {
    .hero-container {
      padding: 1.5rem 1.25rem 3rem 1.25rem;
      min-height: auto;
      background: radial-gradient(circle at 50% 10%, #172849 0%, #070b12 80%);
      border-bottom: 1px solid rgba(217, 119, 6, 0.15);
    }

    .hero-inner {
      display: flex;
      flex-direction: column;
      padding: 0;
      z-index: 2;
    }

    .hero-content {
      max-width: 100%;
      margin-top: 0;
    }

    .hero-bg {
      display: none;
    }

    .hero-overlay {
      background-image: none;
    }

    .hero-title {
      font-size: 1.85rem;
      line-height: 1.15;
      margin-bottom: 1rem;
    }

    .hero-description {
      font-size: 1.05rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
      color: #cbd5e1;
    }

    .hero-cta {
      margin-bottom: 1.5rem;
    }

    .btn-primary {
      display: block;
      width: 100%;
      max-width: 100%;
      padding: 1rem 1.25rem;
      font-size: 1.05rem;
      border-radius: 10px;
      text-align: center;
    }

    .hero-features {
      gap: 0.6rem;
    }

    .hero-features li {
      font-size: 0.9rem;
    }
  }
</style>