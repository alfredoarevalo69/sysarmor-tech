---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBgImg from '../assets/images/hero-datacenter.webp';
---

<section class="hero-container">
  <!-- Imagen de fondo base limpia sin degradado frontal -->
  <div class="hero-bg-wrapper">
    <Image 
      src={heroBgImg} 
      alt="Fondo Infraestructura Crítica y Ecosistema Microsoft" 
      width={1920}
      height={1080}
      format="webp"
      quality={85}
      loading="eager" 
      fetchpriority="high"
      decoding="sync"
      class="hero-bg"
    />
  </div>

  <div class="hero-inner">
    <div class="hero-content">
      
      <!-- Isotipo con animación de pulso sutil (EXCLUSIVO PARA MÓVIL) -->
      <div class="mobile-badge-container md:hidden">
        <div class="mobile-badge">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
      </div>

      <!-- TÍTULO -->
      <h1 class="hero-title">
        Arquitectura y modernización de <br />
        <span class="highlight">infraestructura crítica en entornos híbridos</span>
      </h1>

      <!-- DESCRIPCIÓN -->
      <p class="hero-description">
        Este espacio documenta soluciones de ingeniería, aprendizajes y buenas prácticas en entornos híbridos y en la nube. Un recorrido técnico por la arquitectura de sistemas, la seguridad corporativa y la automatización aplicada.
      </p>

      <!-- CTA -->
      <div class="hero-cta">
        <a href="/blog" class="btn-primary">Explorar Artículos Técnicos</a>
      </div>

      <!-- CARACTERÍSTICAS -->
      <ul class="hero-features">
        <li>
          <span class="feature-icon" aria-hidden="true">🛡️</span>
          <span>Gestión de identidad y directorios en entornos híbridos</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">☁️</span>
          <span>Modernización de infraestructura y migración a la nube</span>
        </li>
        <li>
          <span class="feature-icon" aria-hidden="true">🛠️</span>
          <a href="/tools" class="feature-link">Utilice mis herramientas y utilitarios de diagnóstico técnico</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* --- CONTENEDOR BASE --- */
  .hero-container {
    position: relative;
    width: 100%;
    padding: 3rem 0;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #000000; 
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  /* --- ENVOLTORIO DE FONDO --- */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  /* --- IMAGEN DE FONDO --- */
  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center; 
    filter: brightness(1.1) saturate(1.05);
  }

  /* --- CONTENEDOR GENERAL (SINCRONIZADO CON EL NAVBAR) --- */
  .hero-inner {
    width: 100% !important;
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    position: relative;
    z-index: 3;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
  }

  @media (min-width: 640px) {
    .hero-inner { 
      padding-left: 2rem !important; 
      padding-right: 2rem !important; 
    }
  }

  @media (min-width: 1024px) {
    .hero-inner { 
      padding-left: 3rem !important;  
      padding-right: 3rem !important;
    }
  }

  .hero-content {
    width: 100% !important;
    max-width: 680px !important;
    text-align: left !important;
    z-index: 4;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  .mobile-badge-container { display: none; }

  /* --- TÍTULO --- */
  .hero-title {
    font-size: clamp(1.7rem, 2.3vw, 2.3rem) !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    line-height: 1.2 !important;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9), 0 0 4px rgba(0, 0, 0, 0.5);
    margin: 0 0 2rem 0 !important; /* Espacio mayor debajo del título */
    text-align: left !important;
  }

  .highlight { color: #f59e0b !important; }

  /* --- DESCRIPCIÓN --- */
  .hero-description {
    font-size: 1.1rem !important;
    font-weight: 400 !important;
    color: #cbd5e1 !important;
    line-height: 1.6 !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    margin: 0 0 2.5rem 0 !important; /* Espacio sustancial debajo de la descripción */
    text-align: left !important;
  }

  /* --- CTA --- */
  .hero-cta { 
    margin: 0 0 2.5rem 0 !important; /* Espacio generoso debajo del botón para separarlo de la lista */
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    text-align: left !important;
  }

  .btn-primary {
    display: inline-flex !important;
    width: auto !important;
    padding: 0.75rem 1.7rem !important;
    background-color: #d97706 !important;
    color: #0f172a !important;
    font-weight: 700 !important;
    font-size: 1rem !important;
    text-align: center !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    position: relative;
    z-index: 5;
    transition: all 0.2s ease;
    animation: cta-pulse 3s infinite ease-in-out;
    border: 1px solid transparent;
  }

  .btn-primary:hover {
    background-color: #b45309 !important;
    transform: translateY(-2px);
    animation: none; 
    box-shadow: 0 4px 15px rgba(217, 119, 6, 0.5);
    border-color: rgba(245, 158, 11, 0.3);
  }

  /* --- CARACTERÍSTICAS --- */
  .hero-features {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 1rem !important; /* Mayor separación entre cada elemento de la lista inferior */
    text-align: left !important;
  }

  .hero-features li {
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
    color: #f8fafc !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    margin: 0 !important;
    text-align: left !important;
  }

  .feature-icon { font-size: 1.1rem; flex-shrink: 0; width: 22px; text-align: center; }
  .feature-link { color: inherit; text-decoration: none; transition: color 0.2s ease; }
  .feature-link:hover { color: #eab308; text-decoration: underline; }

  /* --- MEDIA QUERIES (Móvil) --- */
  @media (max-width: 968px) {
    .hero-container {
      padding: 3rem 0;
      min-height: auto;
      background-color: #000000;
      border-bottom: 1px solid rgba(217, 119, 6, 0.2);
    }
    .hero-inner { 
      display: flex !important; 
      flex-direction: column !important; 
      z-index: 2 !important; 
      padding-left: 1rem !important; 
      padding-right: 1rem !important; 
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .hero-content { max-width: 100% !important; text-align: center !important; padding: 0 !important; gap: 0 !important; margin-left: auto !important; margin-right: auto !important; }
    .hero-bg-wrapper { display: none; }
    .mobile-badge-container { display: flex !important; justify-content: center; width: 100%; margin-bottom: 1rem; }
    .mobile-badge {
      width: 60px !important; height: 60px !important; border-radius: 1rem;
      background-color: rgba(15, 23, 42, 0.95); border: 1px solid rgba(245, 158, 11, 0.5);
      display: flex; align-items: center; justify-content: center; animation: subtle-pulse 3s infinite ease-in-out;
    }
    .mobile-badge svg { width: 28px !important; height: 28px !important; color: #f59e0b; }
    .hero-title { font-size: 1.75rem !important; line-height: 1.15 !important; text-shadow: 0 2px 8px rgba(0,0,0,1); text-align: center !important; margin: 0 0 1.5rem 0 !important; }
    .hero-description { font-size: 1.05rem !important; line-height: 1.5 !important; margin: 0 auto 2rem auto !important; color: #e2e8f0 !important; text-shadow: 0 2px 6px rgba(0,0,0,1); text-align: center !important; }
    .hero-cta { margin: 0 0 2rem 0 !important; text-align: center !important; }
    .btn-primary { display: inline-flex !important; width: auto !important; padding: 0.8rem 1.8rem !important; font-size: 1rem !important; border-radius: 10px !important; }
    .hero-features { gap: 0.9rem !important; margin-top: 0 !important; align-items: center !important; }
    .hero-features li { font-size: 0.95rem !important; justify-content: center !important; text-align: center !important; }
  }

  /* --- ANIMACIONES --- */
  @keyframes subtle-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 15px rgba(245, 158, 11, 0.2); }
    50% { transform: scale(1.05); box-shadow: 0 0 25px rgba(245, 158, 11, 0.4); }
  }

  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.5); }
    70% { box-shadow: 0 0 0 15px rgba(217, 119, 6, 0); }
  }
</style>