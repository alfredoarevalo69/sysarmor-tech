---
// src/components/ToolsTeaser.astro
---
<section class="py-20 bg-[#020617] border-y border-slate-800/80 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(212,175,55,0.08),rgba(255,255,255,0))]"></div>
  
  <div class="max-w-6xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 bg-slate-900/80 border border-slate-700/50 p-8 sm:p-12 rounded-2xl shadow-2xl backdrop-blur-sm">
      <div class="max-w-xl">
        <span class="text-[#D4AF37] font-mono text-sm tracking-wider uppercase bg-[#D4AF37]/10 px-3 py-1 rounded-md border border-[#D4AF37]/20">
          Utilidad Interactiva
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          Calculadora VLSM de Subredes Corporativas
        </h2>
        <p class="text-slate-300 mt-4 text-base sm:text-lg leading-relaxed">
          Optimiza el direccionamiento IP de tus redes y despliegues híbridos evitando el desperdicio de direcciones. Diseñada bajo principios de precisión técnica y cero fricción.
        </p>
      </div>
      
      <div class="flex-shrink-0">
        <a 
          href="/tools/vlsm" 
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-[#D4AF37] hover:bg-white text-[#020617] font-bold text-base transition-all shadow-[0_0_20px_rgba(212,175,55,0.3)] hover:scale-105"
        >
          Probar Calculadora
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>