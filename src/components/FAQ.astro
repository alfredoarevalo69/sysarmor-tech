---
// src/components/FAQ.astro

interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "¿Cómo se pueden utilizar las herramientas y scripts publicados?",
    answer: "Todos los recursos técnicos y scripts se comparten bajo principios de código abierto y autoría personal para uso libre y educativo, siguiendo las licencias definidas en cada repositorio."
  },
  {
    question: "¿Puedo proponer mejoras o reportar errores en las guías?",
    answer: "Sí, al tratarse de un proyecto colaborativo de ingeniería, puedes aportar mediante Pull Requests o revisar los repositorios directamente enlazados a GitHub para auditoría y retroalimentación técnica."
  },
  {
    question: "¿Cuál es el enfoque principal de los artículos y la documentación?",
    answer: "Están centrados en resolver problemáticas complejas de nivel 2 y 3 sobre Windows Server, Active Directory, automatización avanzada con PowerShell y seguridad en entornos híbridos."
  }
];
---

<!-- Agregado id="faq", py-16 y clases de centrado flex -->
<section id="faq" class="w-full py-16 bg-slate-100 border-t border-slate-200 px-6 flex flex-col justify-center">
  <div class="max-w-3xl mx-auto space-y-12 w-full">
    
    <!-- Encabezado actualizado al enfoque de portafolio y recursos -->
    <div class="text-center space-y-2">
      <h2 class="text-3xl font-display font-bold text-neutral-900 uppercase tracking-wide">
        Preguntas Frecuentes
      </h2>
      <p class="text-slate-700 font-medium text-base">
        Sobre el uso de herramientas, licencias y colaboración técnica.
      </p>
    </div>
    
    <!-- Lista de FAQ con acordeón -->
    <div class="space-y-4" role="region" aria-label="Preguntas frecuentes">
      {faqs.map((faq) => (
        <details class="group bg-white border border-slate-300 rounded-xl shadow-sm open:border-slate-400 open:shadow-md transition-all duration-300 overflow-hidden">
          <summary class="flex justify-between items-center font-bold text-neutral-900 p-6 cursor-pointer list-none hover:text-neutral-600 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 rounded-xl">
            <span>{faq.question}</span>
            <span class="transition-transform duration-300 group-open:rotate-180 text-neutral-400 shrink-0 ml-4" aria-hidden="true">
              <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </span>
          </summary>
          <div class="text-neutral-600 px-6 pb-6 leading-relaxed border-t border-slate-100 pt-4 font-sans text-sm md:text-base">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>