---
// src/components/FAQ.astro

interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: "¿Cómo se pueden utilizar las herramientas y scripts publicados?",
    answer: "Todos los recursos técnicos y scripts se comparten bajo principios de código abierto y autoría personal para uso libre y educativo, siguiendo las licencias definidas en cada repositorio."
  },
  {
    question: "¿Esto tiene algún costo?",
    answer: "No. Todas las herramientas, scripts y documentación publicados en este portafolio son de acceso libre y gratuito con fines educativos y de referencia técnica. No se comercializa ningún tipo de software ni se prestan servicios de soporte comercial bajo este espacio."
  },
  {
    question: "¿Cómo reporto un problema o fallo en una herramienta?",
    answer: "Al tratarse de un repositorio de recursos técnicos e infraestructura, cualquier incidencia, reporte de error o propuesta de mejora se gestiona exclusivamente a través de los canales de colaboración en GitHub o mediante contacto directo por LinkedIn."
  },
  {
    question: "¿Puedo proponer mejoras o reportar errores en las guías?",
    answer: "Sí, al tratarse de un proyecto colaborativo de ingeniería, puedes aportar mediante Pull Requests o revisar los repositorios directamente enlazados a GitHub para auditoría y retroalimentación técnica."
  },
  {
    question: "¿Cuál es el enfoque principal de los artículos y la documentación?",
    answer: "Están centrados en resolver problemáticas complejas de nivel 2 y 3 sobre Windows Server, Active Directory, automatización avanzada con PowerShell y seguridad en entornos híbridos."
  }
];
---

<!-- Fondo de sección en zinc-200 para un gris neutro industrial sin subtonos azules -->
<section id="faq" class="w-full pt-12 pb-16 bg-zinc-200 border-t border-zinc-300 px-4 sm:px-6 flex flex-col justify-center scroll-mt-[76px]">
  <div class="max-w-3xl mx-auto space-y-8 w-full">
    
    <!-- Encabezado -->
    <div class="text-center space-y-2">
      <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 tracking-tight">
        Preguntas Frecuentes
      </h2>
      <p class="text-zinc-700 font-medium text-xs sm:text-sm">
        Sobre el uso de herramientas, licencias y colaboración técnica.
      </p>
    </div>
    
    <!-- Tarjeta principal limpia con grises neutros (zinc) -->
    <div class="bg-white border-2 border-zinc-300 rounded-2xl shadow-lg shadow-zinc-400/30 divide-y divide-zinc-200 overflow-hidden" role="region" aria-label="Preguntas frecuentes">
      {faqs.map((faq) => (
        <details class="group transition-colors duration-200 open:bg-zinc-50">
          <summary class="flex justify-between items-center font-semibold text-zinc-900 px-6 py-4 sm:py-5 cursor-pointer list-none hover:text-amber-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-500 text-sm sm:text-base">
            <span>{faq.question}</span>
            <span class="transition-transform duration-200 group-open:rotate-180 text-zinc-400 shrink-0 ml-4 bg-zinc-100 p-1 rounded-full group-open:bg-amber-500/10 group-open:text-amber-600" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </span>
          </summary>
          <div class="text-zinc-600 px-6 pb-5 pt-1 leading-relaxed text-xs sm:text-sm font-normal">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>