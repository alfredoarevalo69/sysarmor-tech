---
// src/components/Contact.astro
---
<section id="contacto" class="scroll-mt-20 w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-zinc-200 border-t border-zinc-300 flex flex-col justify-center items-center">
  <!-- Contenedor principal con grises neutros (zinc) -->
  <div class="max-w-2xl mx-auto bg-white border-2 border-zinc-400/80 rounded-2xl p-6 sm:p-8 shadow-2xl shadow-zinc-400/30 space-y-5 sm:space-y-6 w-full my-auto">
    
    <!-- Encabezado de Redes y Portafolio -->
    <div class="text-center space-y-1.5 sm:space-y-2">
      <span class="inline-block bg-amber-500/10 border border-amber-500/40 text-amber-700 text-[11px] sm:text-xs font-bold px-3 py-0.5 sm:py-1 rounded-full uppercase tracking-wider">
        Networking & Colaboración
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900">Contacto y Canales Técnicos</h2>
      <p class="text-zinc-700 text-xs sm:text-sm max-w-lg mx-auto font-medium">Conectemos para debatir sobre infraestructura, automatización o revisar proyectos de ingeniería.</p>
    </div>

    <!-- Caja interna con contraste fuerte y tono zinc -->
    <div class="bg-zinc-300/80 border border-zinc-400 rounded-xl p-4 sm:p-5 space-y-4 shadow-inner">
      <div class="flex justify-center">
        
        <!-- LinkedIn -->
        <a 
          href="http://www.linkedin.com/in/alfredoarevalo-infrati" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl transition-all text-xs sm:text-sm shadow-sm w-full max-w-xs"
        >
          <svg class="w-4 h-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          LinkedIn Profile
        </a>

      </div>

      <p class="text-[11px] sm:text-xs text-amber-900 font-semibold pt-2 border-t border-zinc-400 text-center">
        Espacio dedicado al intercambio técnico y la documentación abierta.
      </p>
    </div>

    <!-- Mensaje secundario / Nota -->
    <div class="space-y-2 sm:space-y-3 text-center">
      <p class="text-xs sm:text-sm text-zinc-700 font-semibold">
        🤝 Perfil profesional enfocado en infraestructura híbrida y automatización de sistemas.
      </p>
    </div>

    <!-- Opción secundaria de correo institucional -->
    <div class="pt-3 sm:pt-4 border-t border-zinc-300 text-center space-y-2">
      <p class="text-xs sm:text-sm text-zinc-700 font-medium">Contacto profesional directo:</p>
      
      <div class="flex items-center justify-center gap-2 text-xs sm:text-base font-semibold">
        <a href="mailto:contacto@sysarmortech.com?subject=Contacto%20Profesional" 
           class="text-zinc-900 hover:text-amber-600 transition-colors flex items-center gap-2 truncate">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2.22 2.22 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="truncate">contacto@sysarmortech.com</span>
        </a>
      </div>
    </div>

  </div>
</section>