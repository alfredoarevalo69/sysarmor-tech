---
// src/pages/tools/what-is-my-ip.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="¿Cuál es mi IP y Geolocalización | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-[#cbd5e1] text-slate-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-xl text-xs uppercase tracking-wider transition-all shadow-md"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <div class="space-y-3 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          ¿Cuál es mi IP y Red?
        </h1>
        <p class="text-slate-800 text-sm sm:text-base max-w-2xl mx-auto font-medium">
          Diagnóstico en tiempo real de tus direcciones IP, geolocalización y entorno de conexión.
        </p>
      </div>

      <div class="bg-slate-900 text-slate-100 border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
        <h2 class="text-xs uppercase tracking-wider text-[#D4AF37] font-bold border-b border-slate-800 pb-3">
          Conectividad de Red
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-slate-950 border border-slate-800 p-4 rounded-xl flex items-center justify-between gap-3 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">IPv4 Pública</span>
            <span id="ipv4-display" class="font-mono text-sm sm:text-base font-bold text-[#D4AF37]">
              Consultando...
            </span>
          </div>

          <div class="bg-slate-950 border border-slate-800 p-4 rounded-xl flex items-center justify-between gap-3 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">IPv6 Pública</span>
            <span id="ipv6-display" class="font-mono text-xs sm:text-sm font-bold text-slate-200">
              Buscando...
            </span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-900 text-slate-100 border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6 flex flex-col justify-between">
          <h2 class="text-xs uppercase tracking-wider text-[#D4AF37] font-bold border-b border-slate-800 pb-3">
            Geolocalización
          </h2>
          
          <ul class="space-y-3 text-sm divide-y divide-slate-800/80">
            <li class="flex justify-between items-center pt-2">
              <span class="text-slate-400 text-xs font-semibold">País</span>
              <span id="geo-country" class="font-medium text-slate-100 flex items-center gap-1.5">Cargando...</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-400 text-xs font-semibold">Ciudad / Región</span>
              <span id="geo-city" class="font-medium text-slate-100">-</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-400 text-xs font-semibold">ISP / Proveedor</span>
              <span id="geo-isp" class="font-mono text-xs text-slate-300 truncate max-w-[180px] sm:max-w-[200px]" title="-">-</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-400 text-xs font-semibold">Coordenadas</span>
              <span id="geo-coords" class="font-mono text-xs text-slate-300">-</span>
            </li>
          </ul>
        </div>

        <div class="bg-slate-900 text-slate-100 border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6 flex flex-col justify-between">
          <h2 class="text-xs uppercase tracking-wider text-[#D4AF37] font-bold border-b border-slate-800 pb-3">
            Entorno del Cliente
          </h2>
          
          <ul class="space-y-3 text-sm divide-y divide-slate-800/80">
            <li class="flex justify-between items-center pt-2">
              <span class="text-slate-400 text-xs font-semibold">Sistema Operativo</span>
              <span id="client-os" class="font-medium text-slate-100">Detectando...</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-400 text-xs font-semibold">Navegador Web</span>
              <span id="client-browser" class="font-medium text-slate-100">Detectando...</span>
            </li>
            <li class="flex justify-between items-center pt-3">
              <span class="text-slate-400 text-xs font-semibold">Protocolo / Puerto</span>
              <span id="connection-protocol" class="font-mono text-xs text-slate-300">-</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="flex justify-end pt-2">
        <button 
          id="client-refresh"
          class="w-full sm:w-auto bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold px-6 py-3 rounded-xl transition-all text-sm shadow-lg inline-flex items-center justify-center gap-2 cursor-pointer"
        >
          🔄 Actualizar Información
        </button>
      </div>

    </div>
  </main>
</Layout>

<script>
  function detectOSAndBrowser() {
    const ua = navigator.userAgent;
    const osElement = document.getElementById('client-os');
    const browserElement = document.getElementById('client-browser');
    const protoElement = document.getElementById('connection-protocol');

    let os = 'Desconocido';
    if (ua.includes('Win')) os = 'Windows';
    else if (ua.includes('Mac')) os = 'macOS';
    else if (ua.includes('Linux')) os = 'Linux';
    else if (ua.includes('Android')) os = 'Android';
    else if (ua.includes('like Mac') || ua.includes('iOS')) os = 'iOS';
    if (osElement) osElement.textContent = os;

    let browser = 'Desconocido';
    if (ua.includes('Firefox/')) browser = 'Mozilla Firefox';
    else if (ua.includes('Edg/')) browser = 'Microsoft Edge';
    else if (ua.includes('Chrome/')) browser = 'Google Chrome';
    else if (ua.includes('Safari/') && !ua.includes('Chrome')) browser = 'Apple Safari';
    else if (ua.includes('OPR/') || ua.includes('Opera/')) browser = 'Opera';
    if (browserElement) browserElement.textContent = browser;

    if (protoElement) {
      protoElement.textContent = `${window.location.protocol.replace(':', '').toUpperCase()} (${window.location.port || (window.location.protocol === 'https:' ? '443' : '80')})`;
    }
  }

  async function fetchNetworkData() {
    detectOSAndBrowser();
    const ipv4Element = document.getElementById('ipv4-display');
    const ipv6Element = document.getElementById('ipv6-display');
    const countryElement = document.getElementById('geo-country');
    const cityElement = document.getElementById('geo-city');
    const ispElement = document.getElementById('geo-isp');
    const coordsElement = document.getElementById('geo-coords');

    try {
      const response = await fetch('/api/my-ip');
      const result = await response.json();

      if (result.success) {
        if (ipv4Element) ipv4Element.textContent = result.ipv4;
        if (ipv6Element) ipv6Element.textContent = result.ipv6;
        
        if (countryElement) {
          const flag = result.country_code ? result.country_code.toUpperCase().replace(/./g, (char: string) => String.fromCodePoint(127397 + char.charCodeAt(0))) : '';
          countryElement.textContent = `${flag} ${result.country}`;
        }
        if (cityElement) cityElement.textContent = `${result.city}, ${result.region}`;
        if (ispElement) {
          ispElement.textContent = result.org;
          ispElement.setAttribute('title', result.org);
        }
        if (coordsElement) coordsElement.textContent = `${result.latitude}, ${result.longitude}`;
      } else {
        throw new Error('Error interno');
      }
    } catch {
      if (ipv4Element) ipv4Element.textContent = 'No disponible';
      if (ipv6Element) ipv6Element.textContent = 'No disponible';
      if (countryElement) countryElement.textContent = 'No disponible';
      if (cityElement) cityElement.textContent = '-';
      if (ispElement) ispElement.textContent = '-';
      if (coordsElement) coordsElement.textContent = '-';
    }
  }

  document.addEventListener('DOMContentLoaded', fetchNetworkData);
  document.addEventListener('astro:page-load', fetchNetworkData);
  document.getElementById('client-refresh')?.addEventListener('click', fetchNetworkData);
</script>