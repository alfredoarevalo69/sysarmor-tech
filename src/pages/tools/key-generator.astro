---
// src/pages/tools/key-generator.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Generador de Claves y Contraseñas | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-200 border-t border-slate-300 text-neutral-900">
    <div class="max-w-4xl mx-auto space-y-8">

      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-amber-400 hover:bg-amber-500 border border-amber-500 rounded-lg text-neutral-900 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <!-- Bloque de Cabecera SEO unificado (Fondo idéntico al contenedor principal) -->
      <div class="bg-slate-200 border border-slate-300 rounded-2xl p-6 sm:p-8 shadow-xs space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-neutral-600 border-b border-slate-300 pb-3">
          <span class="px-3 py-1 bg-amber-300/80 text-neutral-900 font-bold rounded-md uppercase tracking-wider">Seguridad y Criptografía</span>
          <div class="flex items-center gap-4">
            <span>Actualizado: 22 Sept, 2026</span>
            <span>Versión: 1.2.0</span>
          </div>
        </div>

        <div class="space-y-2 text-center max-w-2xl mx-auto pt-2">
          <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide">
            GENERADOR DE CLAVES Y CONTRASEÑAS
          </h1>
          <p class="text-neutral-700 font-medium text-base">
            Crea cadenas criptográficamente seguras, contraseñas robustas o secretos alfanuméricos usando la API de entropía del navegador.
          </p>
        </div>
      </div>

      <!-- Herramienta Interactiva -->
      <div class="bg-slate-950 border-2 border-slate-900 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
        
        <!-- Output Box -->
        <div class="space-y-2">
          <label for="output-password" class="block text-xs font-bold text-slate-100 uppercase tracking-wide">
            Resultado Generado:
          </label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="output-password" 
              readonly 
              autocomplete="off"
              spellcheck="false"
              class="w-full bg-slate-900 border-2 border-slate-800 rounded-xl px-4 py-3 text-slate-100 font-mono text-sm focus:outline-none shadow-inner placeholder-slate-500"
              placeholder="Haz clic en generar..."
            />
            <button 
              type="button"
              id="copy-btn"
              class="bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-bold px-5 py-3 rounded-xl transition-colors text-sm cursor-pointer shadow-sm flex items-center gap-2 shrink-0"
            >
              <span>📋</span> Copiar
            </button>
          </div>
        </div>

        <!-- Controls / Options -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t-2 border-slate-900">
          
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <label for="length-range" class="text-xs font-bold text-slate-100 uppercase tracking-wide">
                Longitud: <span id="length-value" class="text-amber-400">16</span> caracteres
              </label>
            </div>
            <input 
              type="range" 
              id="length-range" 
              min="8" 
              max="128" 
              value="16" 
              class="w-full accent-amber-400 cursor-pointer bg-slate-900 rounded-lg h-2"
            />
          </div>

          <div class="space-y-3">
            <span class="block text-xs font-bold text-slate-100 uppercase tracking-wide">Conjunto de Caracteres:</span>
            <div class="grid grid-cols-2 gap-3 text-xs font-mono text-slate-300">
              <label class="flex items-center gap-2.5 cursor-pointer bg-slate-900 p-2.5 rounded-lg border border-slate-800 hover:border-slate-700 transition-colors">
                <input type="checkbox" id="chk-upper" checked class="w-4 h-4 accent-amber-400 rounded" /> Mayúsculas (A-Z)
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer bg-slate-900 p-2.5 rounded-lg border border-slate-800 hover:border-slate-700 transition-colors">
                <input type="checkbox" id="chk-lower" checked class="w-4 h-4 accent-amber-400 rounded" /> Minúsculas (a-z)
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer bg-slate-900 p-2.5 rounded-lg border border-slate-800 hover:border-slate-700 transition-colors">
                <input type="checkbox" id="chk-numbers" checked class="w-4 h-4 accent-amber-400 rounded" /> Números (0-9)
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer bg-slate-900 p-2.5 rounded-lg border border-slate-800 hover:border-slate-700 transition-colors">
                <input type="checkbox" id="chk-symbols" checked class="w-4 h-4 accent-amber-400 rounded" /> Símbolos (!@#$)
              </label>
            </div>
          </div>

        </div>

        <div class="pt-2">
          <button 
            type="button"
            id="generate-btn"
            class="w-full bg-amber-400 hover:bg-amber-500 text-neutral-900 font-bold py-3.5 rounded-xl transition-colors text-sm cursor-pointer shadow-md"
          >
            Generar Nueva Clave
          </button>
        </div>

      </div>

      <!-- Bloque de Texto Técnico Inferior (SEO Semántico para Sysadmins) -->
      <section class="bg-white border border-slate-300 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6 text-neutral-800">
        <h2 class="text-2xl font-display font-bold text-neutral-900 border-b border-slate-200 pb-3">
          Guía Técnica: Gestión de Entropía y Claves Criptográficas Seguras en Infraestructura TI
        </h2>

        <div class="space-y-4 text-sm sm:text-base leading-relaxed text-neutral-700">
          <p>
            En la administración de sistemas moderna, el establecimiento de contraseñas robustas, claves simétricas complejas y tokens de autenticación es una línea de defensa crítica contra ataques de fuerza bruta y compromiso de credenciales en Active Directory o servicios en la nube. Esta utilidad genera cadenas aleatorias aplicando los estándares criptográficos recomendados para ingenieros de sistemas.
          </p>

          <h3 class="text-lg font-bold text-neutral-900 pt-2">¿Cómo funciona la generación basada en la API de entropía del navegador?</h3>
          <p>
            A diferencia de funciones pseudoaleatorias estándar expuestas en lenguajes de scripting básicos, esta herramienta utiliza la interfaz nativa del navegador web <code class="bg-slate-100 px-1.5 py-0.5 rounded text-amber-700 font-mono text-xs">window.crypto.getRandomValues()</code> respaldada por fuentes de entropía a nivel de sistema operativo y hardware. Esto garantiza que las secuencias generadas sean impredecibles y aptas para su uso en producción.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-2">
              <h4 class="font-bold text-neutral-900 text-sm uppercase tracking-wide">Buenas Prácticas para Sysadmins</h4>
              <ul class="list-disc list-inside space-y-1 text-xs text-neutral-600">
                <li>Utilizar longitudes superiores a 16 caracteres para cuentas con privilegios elevados (Domain Admins).</li>
                <li>Combinar obligatoriamente mayúsculas, minúsculas, dígitos numéricos y símbolos especiales.</li>
                <li>Evitar patrones predecibles o reutilización de secretos en múltiples servidores o dominios de directorio activo.</li>
              </ul>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-2">
              <h4 class="font-bold text-neutral-900 text-sm uppercase tracking-wide">Privacidad del Cliente</h4>
              <p class="text-xs text-neutral-600">
                Todo el proceso de cálculo criptográfico ocurre de forma local en el navegador del cliente mediante JavaScript. Ninguna clave, contraseña o secreto generado es transmitido, almacenado o registrado en servidores externos.
              </p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const NUMBERS = '0123456789';
  const SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';

  const outputInput = document.getElementById('output-password') as HTMLInputElement;
  const lengthRange = document.getElementById('length-range') as HTMLInputElement;
  const lengthValue = document.getElementById('length-value');
  const generateBtn = document.getElementById('generate-btn');
  const copyBtn = document.getElementById('copy-btn');

  const chkUpper = document.getElementById('chk-upper') as HTMLInputElement;
  const chkLower = document.getElementById('chk-lower') as HTMLInputElement;
  const chkNumbers = document.getElementById('chk-numbers') as HTMLInputElement;
  const chkSymbols = document.getElementById('chk-symbols') as HTMLInputElement;

  if (outputInput) outputInput.value = '';

  window.addEventListener('pageshow', (event) => {
    if (event.persisted && outputInput) {
      outputInput.value = '';
      if (lengthRange) lengthRange.value = '16';
      if (lengthValue) lengthValue.textContent = '16';
      if (chkUpper) chkUpper.checked = true;
      if (chkLower) chkLower.checked = true;
      if (chkNumbers) chkNumbers.checked = true;
      if (chkSymbols) chkSymbols.checked = true;
      generatePassword();
    }
  });

  function generatePassword() {
    let chars = '';
    if (chkUpper?.checked) chars += UPPER;
    if (chkLower?.checked) chars += LOWER;
    if (chkNumbers?.checked) chars += NUMBERS;
    if (chkSymbols?.checked) chars += SYMBOLS;

    if (!chars) {
      if (outputInput) outputInput.value = 'Selecciona al menos una opción.';
      return;
    }

    const length = parseInt(lengthRange?.value || '16', 10);
    const array = new Uint32Array(length);
    window.crypto.getRandomValues(array);

    let result = '';
    for (let i = 0; i < length; i++) {
      result += chars[array[i] % chars.length];
    }

    if (outputInput) outputInput.value = result;
  }

  lengthRange?.addEventListener('input', () => {
    if (lengthValue) lengthValue.textContent = lengthRange.value;
    generatePassword();
  });

  [chkUpper, chkLower, chkNumbers, chkSymbols].forEach(chk => {
    chk?.addEventListener('change', generatePassword);
  });

  generateBtn?.addEventListener('click', generatePassword);

  copyBtn?.addEventListener('click', () => {
    if (!outputInput?.value || outputInput.value.startsWith('Selecciona')) return;
    navigator.clipboard.writeText(outputInput.value);
    const originalContent = copyBtn.innerHTML;
    copyBtn.innerHTML = '<span>✅</span> ¡Copiado!';
    setTimeout(() => {
      copyBtn.innerHTML = originalContent;
    }, 2000);
  });

  // Generar al cargar
  generatePassword();
</script>