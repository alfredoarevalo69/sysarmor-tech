---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Auditoría de Hardening y Conformidad de Infraestructura | SysArmor Tech";
const pageDescription = "Motor de diagnóstico integral en línea para evaluar la postura de seguridad perimetral, cifrado de transporte y políticas de cabeceras HTTP en entornos de producción.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalURL}
>
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-200 border-t border-slate-300 text-slate-900 print:bg-white print:text-slate-900 print:py-0">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Encabezado de Impresión y Pantalla -->
      <header class="report-header flex items-center justify-between pb-4 border-b border-slate-300 print:border-slate-400 print:mb-6">
        <div class="flex items-center gap-3">
          <div class="flex flex-col">
            <span class="text-xs font-bold text-slate-700 uppercase tracking-widest print:text-slate-800">Infraestructura & Ciberseguridad</span>
          </div>
        </div>
        <div class="text-right hidden sm:block print:block">
          <span class="text-xs font-semibold text-slate-700 print:text-slate-800">Reporte Técnico de Diagnóstico</span>
        </div>
      </header>

      <div class="print:hidden">
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-sm"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <div class="space-y-2 text-center max-w-3xl mx-auto print:mb-6">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-slate-950 tracking-wide print:text-black">
          Auditoría de Hardening y Conformidad de Infraestructura
        </h1>
        <p class="text-slate-700 font-medium text-base print:text-slate-700">
          Motor de diagnóstico integral para evaluar la postura de seguridad perimetral, cifrado de transporte y políticas de cabeceras en entornos de producción.
        </p>
      </div>

      <!-- Input de búsqueda (Oculto en impresión) -->
      <div class="bg-slate-950 border border-slate-800 p-6 rounded-2xl shadow-xl space-y-4 print:hidden">
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
          <div class="w-full sm:w-2/3">
            <label for="targetInput" class="block text-sm font-bold text-slate-300 mb-1">Dominio o Servidor Objetivo</label>
            <input 
              type="text" 
              id="targetInput" 
              placeholder="ej. miservidor.com o https://dominio.com" 
              autocomplete="off"
              class="w-full px-4 py-3 bg-slate-900 border border-slate-800 rounded-xl font-medium focus:outline-none focus:border-amber-500 text-white placeholder-slate-500 shadow-inner"
            />
          </div>
          <div class="w-full sm:w-1/3 flex items-end">
            <button 
              id="runAuditBtn" 
              class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3 px-4 rounded-xl transition-colors text-sm shadow-sm mt-6 sm:mt-0 cursor-pointer"
            >
              Ejecutar Auditoría Global
            </button>
          </div>
        </div>
      </div>

      <!-- Contenedor del Reporte -->
      <div id="reportContainer" class="hidden space-y-6">
        
        <!-- Tarjeta de Calificación Global -->
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 shadow-xl flex items-center justify-between print:bg-slate-100 print:border-slate-300 print:break-inside-avoid">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block print:text-slate-700">Evaluación General de Infraestructura</span>
            <h2 id="reportTarget" class="text-xl font-bold text-white print:text-slate-950"></h2>
            <p id="reportTimestamp" class="text-xs text-slate-400 mt-1 font-mono print:text-slate-600"></p>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-slate-300 print:text-slate-800">Calificación Global:</span>
            <div id="globalBadge" class="w-16 h-16 rounded-xl flex items-center justify-center text-3xl font-black text-slate-950 shadow-sm">
              -
            </div>
          </div>
        </div>

        <div class="space-y-4 print:space-y-6">
          <h3 class="text-xl font-bold text-slate-950 print:text-black print:break-after-avoid">Resumen de Hallazgos y Evaluaciones</h3>
          <div id="modulesList" class="space-y-6"></div>
        </div>

        <div class="flex justify-end pt-4 print:hidden">
          <button 
            onclick="window.print()" 
            class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3 px-6 rounded-xl transition-colors text-sm shadow-sm cursor-pointer"
          >
            Imprimir / Guardar Reporte PDF
          </button>
        </div>

      </div>

      <div id="loadingState" class="hidden text-center py-12 space-y-3">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-amber-500 border-t-transparent"></div>
        <p class="text-slate-700 font-medium text-sm">Ejecutando pruebas concurrentes de infraestructura...</p>
      </div>

    </div>
  </main>
</Layout>

<style>
  @media print {
    @page {
      size: letter;
      margin: 1.5cm 1.2cm;
    }
    .print\:hidden {
      display: none !important;
    }
    body, main {
      background-color: #ffffff !important;
      color: #0f172a !important;
      display: block !important;
    }
    .report-header {
      display: flex !important;
      break-after: avoid;
      page-break-after: avoid;
      border-bottom: 2px solid #cbd5e1 !important;
    }

    #reportContainer, #modulesList {
      display: block !important;
    }
    
    #modulesList > div {
      display: block !important;
      background-color: #ffffff !important;
      border: 1px solid #cbd5e1 !important;
      color: #0f172a !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      margin-bottom: 2rem;
      box-shadow: none !important;
    }

    #modulesList div[class*="bg-slate-900"],
    #modulesList div[class*="bg-slate-950"],
    #modulesList div[class*="bg-amber-950"] {
      background-color: #f8fafc !important;
      border: 1px solid #e2e8f0 !important;
      color: #0f172a !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    #modulesList span, #modulesList p, #modulesList h4 {
      color: #0f172a !important;
    }
    .text-slate-400, .text-slate-300 {
      color: #334155 !important;
    }
    .text-amber-400, .text-amber-300 {
      color: #b45309 !important;
    }
    .text-emerald-400 {
      color: #047857 !important;
    }
  }
</style>

<script>
  const runBtn = document.getElementById('runAuditBtn');
  const targetInput = document.getElementById('targetInput') as HTMLInputElement;
  const reportContainer = document.getElementById('reportContainer');
  const loadingState = document.getElementById('loadingState');
  const globalBadge = document.getElementById('globalBadge');
  const reportTarget = document.getElementById('reportTarget');
  const reportTimestamp = document.getElementById('reportTimestamp');
  const modulesList = document.getElementById('modulesList');

  if (targetInput) {
    targetInput.value = '';
  }

  runBtn?.addEventListener('click', async () => {
    const target = targetInput?.value.trim();
    if (!target) {
      alert('Por favor, ingresa un dominio o servidor objetivo válido.');
      targetInput?.focus();
      return;
    }
    
    loadingState?.classList.remove('hidden');
    reportContainer?.classList.add('hidden');

    try {
      const response = await fetch(`/api/audit?target=${encodeURIComponent(target)}`);
      if (!response.ok) throw new Error('Error al conectar con el orquestador');
      
      const data = await response.json();

      if (reportTarget) reportTarget.textContent = data.targetDomain;
      if (reportTimestamp) reportTimestamp.textContent = `Fecha de evaluación: ${new Date(data.timestamp).toLocaleString()}`;
      
      if (globalBadge) {
        globalBadge.textContent = data.globalRating;
        globalBadge.className = `w-16 h-16 rounded-xl flex items-center justify-center text-3xl font-black text-slate-950 shadow-sm ${
          data.globalRating === 'A' ? 'bg-emerald-500 text-slate-950' : 'bg-red-500 text-white'
        }`;
      }

      if (modulesList) {
        modulesList.innerHTML = '';
        data.audits.forEach((audit: any) => {
          let rawHeadersHtml = '';
          if (audit.details.rawHeaders) {
            rawHeadersHtml = `
              <div class="mt-4 pt-4 border-t border-slate-800 print:border-slate-200 space-y-2">
                <span class="text-xs font-bold text-slate-400 print:text-slate-700 uppercase tracking-wider block">Cabeceras HTTP en Bruto (Raw Headers) - Detalle Completo</span>
                <div class="bg-slate-900 print:bg-slate-100 text-slate-200 print:text-slate-900 p-4 rounded-xl space-y-1 shadow-inner border border-slate-800 print:border-slate-200">
                  ${Object.entries(audit.details.rawHeaders).map(([k, v]) => `
                    <div class="flex flex-col sm:flex-row text-xs font-mono py-1 border-b border-slate-800 print:border-slate-200">
                      <span class="w-1/3 font-bold text-amber-400 print:text-amber-800">${k}</span>
                      <span class="w-2/3 text-slate-300 print:text-slate-800 break-all">${v}</span>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          }

          let remediationOptionsHtml = '';
          if (audit.details.remediationOptions && audit.details.remediationOptions.length > 0) {
            remediationOptionsHtml = `
              <div class="mt-4 pt-3 border-t border-amber-900/30 print:border-amber-200 space-y-3">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-300 print:text-amber-800 block">
                  Cabeceras y Valores Sugeridos para Remediación:
                </span>
                <div class="grid gap-2.5">
                  ${audit.details.remediationOptions.map((opt: any) => `
                    <div class="bg-slate-950 print:bg-white p-3 rounded-xl border border-slate-800 print:border-slate-300 text-xs space-y-1.5">
                      <div class="font-bold text-slate-200 print:text-slate-950">${opt.header}</div>
                      <div class="text-slate-400 print:text-slate-700">${opt.purpose}</div>
                      <div class="mt-1 font-mono text-emerald-400 print:text-emerald-800 bg-slate-900 print:bg-slate-100 p-2 rounded-lg border border-slate-800 print:border-slate-200 select-all">
                        <span class="text-slate-500 print:text-slate-600 select-none">Valor sugerido: </span>${opt.genericValue}
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          }

          const item = document.createElement('div');
          item.className = 'bg-slate-950 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4 print:bg-white print:border-slate-300 print:shadow-none';
          item.innerHTML = `
            <div class="flex items-center justify-between border-b border-slate-800 print:border-slate-300 pb-3">
              <h4 class="font-bold text-white print:text-slate-950 text-lg">${audit.module}</h4>
              <span class="px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wide ${
                audit.status === 'SUCCESS' ? 'bg-emerald-950 text-emerald-300 border border-emerald-800 print:bg-emerald-100 print:text-emerald-900 print:border-emerald-300' : 'bg-red-950 text-red-300 border border-red-800 print:bg-red-100 print:text-red-900 print:border-red-300'
              }">
                Estado: ${audit.status} — Calificación: ${audit.score || 'N/A'}
              </span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
              <div class="bg-slate-900 print:bg-slate-50 p-4 rounded-xl border border-slate-800 print:border-slate-200 space-y-1 shadow-inner">
                <span class="text-xs font-bold text-slate-400 print:text-slate-700 uppercase tracking-wider block">Componente Evaluado</span>
                <p class="font-bold text-white print:text-slate-900">${audit.details.component}</p>
              </div>
              <div class="bg-slate-900 print:bg-slate-50 p-4 rounded-xl border border-slate-800 print:border-slate-200 space-y-1 shadow-inner">
                <span class="text-xs font-bold text-slate-400 print:text-slate-700 uppercase tracking-wider block">Hallazgo Principal</span>
                <p class="font-medium text-slate-200 print:text-slate-800">${audit.details.finding}</p>
              </div>
            </div>

            <div class="bg-amber-950/40 print:bg-amber-50/60 p-4 rounded-xl border border-amber-900/60 print:border-amber-200 text-sm space-y-1">
              <span class="text-xs font-bold text-amber-400 print:text-amber-800 uppercase tracking-wider block">Recomendación Técnica</span>
              <p class="font-medium text-amber-200 print:text-amber-950">${audit.details.recommendation}</p>
              ${remediationOptionsHtml}
            </div>

            ${rawHeadersHtml}
          `;
          modulesList.appendChild(item);
        });
      }

      reportContainer?.classList.remove('hidden');
    } catch (error) {
      alert('Ocurrió un error al ejecutar la auditoría global. Revisa la consola.');
      console.error(error);
    } finally {
      loadingState?.classList.add('hidden');
    }
  });
</script>