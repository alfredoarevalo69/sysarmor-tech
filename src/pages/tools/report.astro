---
// src/pages/tools/report.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Auditoría de Hardening y Conformidad | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-8 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900 print:bg-white print:py-0">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- ========================================== -->
      <!-- ENCABEZADO INSTITUCIONAL ÚNICO             -->
      <!-- ========================================== -->
      <header class="report-header flex items-center justify-between pb-4 border-b-2 border-neutral-300 print:mb-6">
        <div class="flex items-center gap-3">
          <img src="/images/logo-navbar.webp" alt="SysArmor Tech Shield" class="w-12 h-12 object-contain" />
          <div class="flex flex-col">
            <span class="font-black text-xl tracking-wider text-neutral-900">SYSARMOR <span class="text-blue-700">TECH</span></span>
            <span class="text-xs font-bold text-neutral-600 uppercase tracking-widest">Infraestructura & Ciberseguridad</span>
          </div>
        </div>
        <div class="text-right hidden sm:block print:block">
          <span class="text-xs font-semibold text-neutral-500">Reporte Técnico de Diagnóstico</span>
        </div>
      </header>

      <!-- Encabezado con enfoque de alto impacto para LinkedIn / Técnico -->
      <div class="space-y-2 text-center max-w-3xl mx-auto print:mb-6">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide">
          Auditoría de Hardening y Conformidad de Infraestructura
        </h1>
        <p class="text-neutral-700 font-medium text-base">
          Motor de diagnóstico integral para evaluar la postura de seguridad perimetral, cifrado de transporte y políticas de cabeceras en entornos de producción.
        </p>
      </div>

      <!-- Controles (Inicia completamente limpio sin valor por defecto) -->
      <div class="bg-white p-6 rounded-xl border-2 border-slate-300 shadow-md space-y-4 print:hidden">
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
          <div class="w-full sm:w-2/3">
            <label for="targetInput" class="block text-sm font-bold text-neutral-800 mb-1">Dominio o Servidor Objetivo</label>
            <input 
              type="text" 
              id="targetInput" 
              placeholder="ej. miservidor.com o https://dominio.com" 
              autocomplete="off"
              class="w-full px-4 py-2 border-2 border-slate-300 rounded-lg font-medium focus:outline-none focus:border-blue-700 text-neutral-900"
            />
          </div>
          <div class="w-full sm:w-1/3 flex items-end">
            <button 
              id="runAuditBtn" 
              class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-4 rounded-lg transition-colors text-sm shadow-sm mt-6 sm:mt-0 cursor-pointer"
            >
              Ejecutar Auditoría Global
            </button>
          </div>
        </div>
      </div>

      <!-- Contenedor de Resultados -->
      <div id="reportContainer" class="hidden space-y-6">
        
        <!-- Tarjeta Global -->
        <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl flex items-center justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-neutral-600 block">Evaluación General de Infraestructura</span>
            <h2 id="reportTarget" class="text-xl font-bold text-neutral-900"></h2>
            <p id="reportTimestamp" class="text-xs text-neutral-600 mt-1 font-mono"></p>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-neutral-700">Calificación Global:</span>
            <div id="globalBadge" class="w-16 h-16 rounded-xl flex items-center justify-center text-3xl font-black text-white shadow-md">
              -
            </div>
          </div>
        </div>

        <!-- Tabla Ejecutiva y Desglose -->
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-neutral-900">Resumen de Hallazgos y Evaluaciones</h3>
          <div id="modulesList" class="space-y-6">
            <!-- Renderizado dinámico limpio -->
          </div>
        </div>

        <!-- Botón de Impresión -->
        <div class="flex justify-end pt-4 print:hidden">
          <button 
            onclick="window.print()" 
            class="bg-blue-800 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-lg transition-colors text-sm shadow-sm cursor-pointer"
          >
            Imprimir / Guardar Reporte PDF
          </button>
        </div>

      </div>

      <!-- Estado de Carga -->
      <div id="loadingState" class="hidden text-center py-12 space-y-3">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-900 border-t-transparent"></div>
        <p class="text-neutral-700 font-medium text-sm">Ejecutando pruebas concurrentes de infraestructura...</p>
      </div>

    </div>
  </main>
</Layout>

<style>
  @media print {
    @page {
      size: letter;
      margin: 1.2cm;
    }

    .print\:hidden {
      display: none !important;
    }

    .report-header {
      display: flex !important;
    }

    /* Evitar cortes extraños en los bloques al imprimir */
    #modulesList > div {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>

<script>
  const runBtn = document.getElementById('runAuditBtn');
  const targetInput = document.getElementById('targetInput') as HTMLInputElement;
  const reportContainer = document.getElementById('reportContainer');
  const loadingState = document.getElementById('loadingState');
  const globalBadge = document.getElementById('globalBadge');
  const reportTarget = document.getElementById('reportTarget');
  const reportTimestamp = document.getElementById('reportTimestamp');
  const modulesList = document.getElementById('modulesList');

  // Limpiar explícitamente el input al cargar la vista para evitar autocompletados o caché del navegador
  if (targetInput) {
    targetInput.value = '';
  }

  runBtn?.addEventListener('click', async () => {
    const target = targetInput?.value.trim();
    if (!target) {
      alert('Por favor, ingresa un dominio o servidor objetivo válido.');
      targetInput?.focus();
      return;
    }
    
    loadingState?.classList.remove('hidden');
    reportContainer?.classList.add('hidden');

    try {
      const response = await fetch(`/api/audit?target=${encodeURIComponent(target)}`);
      if (!response.ok) throw new Error('Error al conectar con el orquestador');
      
      const data = await response.json();

      if (reportTarget) reportTarget.textContent = data.targetDomain;
      if (reportTimestamp) reportTimestamp.textContent = `Fecha de evaluación: ${new Date(data.timestamp).toLocaleString()}`;
      
      if (globalBadge) {
        globalBadge.textContent = data.globalRating;
        globalBadge.className = `w-16 h-16 rounded-xl flex items-center justify-center text-3xl font-black text-white shadow-md ${
          data.globalRating === 'A' ? 'bg-emerald-700' : 'bg-red-700'
        }`;
      }

      if (modulesList) {
        modulesList.innerHTML = '';
        data.audits.forEach((audit: any) => {
          let rawHeadersHtml = '';
          if (audit.details.rawHeaders) {
            rawHeadersHtml = `
              <div class="mt-4 pt-4 border-t-2 border-slate-200 space-y-2">
                <span class="text-xs font-bold text-neutral-700 uppercase tracking-wider block">Cabeceras HTTP en Bruto (Raw Headers) - Detalle Completo</span>
                <div class="bg-slate-900 text-slate-100 p-4 rounded-lg space-y-1 shadow-inner">
                  ${Object.entries(audit.details.rawHeaders).map(([k, v]) => `
                    <div class="flex flex-col sm:flex-row text-xs font-mono py-1 border-b border-slate-800">
                      <span class="w-1/3 font-bold text-emerald-400">${k}</span>
                      <span class="w-2/3 text-slate-300 break-all">${v}</span>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          }

          const item = document.createElement('div');
          item.className = 'bg-white border-2 border-slate-300 rounded-xl p-6 shadow-sm space-y-4';
          item.innerHTML = `
            <div class="flex items-center justify-between border-b-2 border-slate-200 pb-3">
              <h4 class="font-bold text-neutral-900 text-lg">${audit.module}</h4>
              <span class="px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wide ${
                audit.status === 'SUCCESS' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
              }">
                Estado: ${audit.status} — Calificación: ${audit.score || 'N/A'}
              </span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
              <div class="bg-neutral-50 p-4 rounded-lg border border-slate-200 space-y-1">
                <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider block">Componente Evaluado</span>
                <p class="font-bold text-neutral-900">${audit.details.component}</p>
              </div>
              <div class="bg-neutral-50 p-4 rounded-lg border border-slate-200 space-y-1">
                <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider block">Hallazgo Principal</span>
                <p class="font-medium text-neutral-800">${audit.details.finding}</p>
              </div>
            </div>

            <div class="bg-blue-50/60 p-4 rounded-lg border border-blue-200 text-sm space-y-1">
              <span class="text-xs font-bold text-blue-900 uppercase tracking-wider block">Recomendación Técnica</span>
              <p class="font-medium text-blue-950">${audit.details.recommendation}</p>
            </div>

            ${rawHeadersHtml}
          `;
          modulesList.appendChild(item);
        });
      }

      reportContainer?.classList.remove('hidden');
    } catch (error) {
      alert('Ocurrió un error al ejecutar la auditoría global. Revisa la consola.');
      console.error(error);
    } finally {
      loadingState?.classList.add('hidden');
    }
  });
</script>