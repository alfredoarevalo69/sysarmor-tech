---
// src/pages/tools/dmarc-generator.astro
import Layout from '../../layouts/Layout.astro';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json();
    const domain = data.domain?.trim().toLowerCase();
    
    if (!domain) {
      return new Response(JSON.stringify({ error: 'Dominio no válido' }), { status: 400 });
    }

    const dmarcHost = `_dmarc.${domain}`;
    const response = await fetch(`https://cloudflare-dns.com/dns-query?name=${dmarcHost}&type=TXT`, {
      headers: { 'Accept': 'application/dns-json' }
    });
    
    const result = await response.json();
    let currentRecord = null;

    if (result.Answer) {
      const txtRecord = result.Answer.find((ans: any) => ans.type === 16);
      if (txtRecord) {
        currentRecord = txtRecord.data.replace(/^"|"$/g, '').replace(/"/g, '');
      }
    }

    return new Response(JSON.stringify({ currentRecord }), {
      status: 200,
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (err) {
    return new Response(JSON.stringify({ currentRecord: null }), { status: 200 });
  }
}

const seo = {
  title: 'Generador y Validador de Políticas DMARC | SysArmor Tech',
  description: 'Herramienta interactiva para construir, validar y auditar registros DNS TXT DMARC. Configura políticas de autenticación, reportes agregados RUA/RUF y alineación de correo electrónico.',
  canonical: 'https://sysarmortech.com/tools/dmarc-generator',
  keywords: 'generador dmarc, crear registro dmarc, validador dmarc, politicas dmarc dns, spf dkim dmarc, seguridad de correo electronico'
};

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Generador y Validador de Políticas DMARC",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "url": "https://sysarmortech.com/tools/dmarc-generator",
      "description": "Herramienta online para generar registros DNS TXT DMARC personalizados para dominios corporativos.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo se configura un registro DMARC en el proveedor DNS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se debe crear un registro de tipo TXT en la zona DNS del dominio. En el campo de nombre o host solo se ingresa '_dmarc' (o '_dmarc.tudominio.com' según el proveedor) y en el valor se pega la cadena generada que inicia con 'v=DMARC1;'."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué función cumplen los reportes rua y ruf en DMARC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El parámetro rua (Aggregate Reports) envía informes estadísticos diarios sobre el tráfico de correo del dominio, mientras que ruf (Forensic Reports) envía notificaciones detalladas e inmediatas cuando un correo falla las validaciones de SPF o DKIM."
          }
        }
      ]
    }
  ]
};
---

<Layout title={seo.title} description={seo.description}>
  <Fragment slot="head">
    <link rel="canonical" href={seo.canonical} />
    <meta name="keywords" content={seo.keywords} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Botón de retorno dinámico -->
      <div>
        <button 
          type="button"
          id="back-btn"
          class="inline-flex items-center gap-2 px-4 py-2 bg-amber-400 hover:bg-amber-500 border border-amber-500 rounded-lg text-neutral-900 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs cursor-pointer"
        >
          <span>←</span> Volver a Herramientas
        </button>
      </div>

      <!-- Cuadro Superior Estándar de Metadatos y Encabezado -->
      <div class="bg-white border-2 border-neutral-300 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-neutral-200 pb-4 text-xs font-semibold text-neutral-600">
          <span class="inline-flex items-center px-3 py-1 bg-amber-200/70 border border-amber-300 text-neutral-900 rounded-full font-bold">
            Seguridad de Correo & DNS
          </span>
          <div class="flex items-center gap-4 text-neutral-500">
            <span>Actualizado: 23 Sept, 2026</span>
            <span>•</span>
            <span>Versión: 1.2.0</span>
          </div>
        </div>

        <div class="space-y-3 text-center max-w-3xl mx-auto pt-2">
          <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide uppercase">
            Generador y Validador de Políticas DMARC
          </h1>
          <p class="text-neutral-700 font-medium text-base">
            Construye, configura y valida la política de autenticación, reportes y alineación de correo electrónico en formato DNS TXT estándar para proteger tu infraestructura de dominio.
          </p>
        </div>
      </div>

      <!-- Grid Principal -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Columna Izquierda: Formulario de Configuración -->
        <div class="lg:col-span-7 bg-white border-2 border-neutral-300 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
          <h2 class="text-xl font-bold font-display uppercase tracking-wide text-neutral-900 border-b border-neutral-200 pb-3">
            Configuración de la Política DMARC
          </h2>

          <!-- Campo 0: Dominio Objetivo -->
          <div class="space-y-2 bg-neutral-50 p-4 rounded-xl border border-neutral-200 shadow-xs">
            <label for="domain" class="block text-sm font-bold text-neutral-900">
              Nombre de Dominio u Host:
            </label>
            <p class="text-xs text-neutral-600">
              Introduce el dominio para consultar su registro actual y generar nuevas pautas de seguridad.
            </p>
            <div class="flex gap-2 pt-1">
              <input 
                type="text" 
                id="domain" 
                value="" 
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="tudominio.com" 
                class="w-full p-2.5 bg-white border-2 border-neutral-300 rounded-lg text-neutral-900 font-medium focus:outline-none focus:border-amber-400 shadow-inner text-sm" 
              />
              <button 
                id="fetch-dns-btn"
                class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-4 py-2.5 rounded-lg text-sm transition-colors shrink-0 cursor-pointer shadow-sm"
              >
                Consultar DNS
              </button>
            </div>
          </div>

          <!-- Campo 1: Política (p) -->
          <div class="space-y-2">
            <label for="policy" class="block text-sm font-bold text-neutral-900">
              1. ¿Cómo deseas que el correo que falla DMARC sea tratado por el receptor?
            </label>
            <select id="policy" autocomplete="off" class="w-full p-2.5 bg-white border-2 border-neutral-300 rounded-lg text-neutral-900 font-medium focus:outline-none focus:border-amber-400 shadow-xs text-sm">
              <option value="none">None (Monitoreo / Sin acción)</option>
              <option value="quarantine">Quarantine (Enviar a Spam/Cuarentena)</option>
              <option value="reject">Reject (Rechazar mensaje por completo)</option>
            </select>
          </div>

          <!-- Campo 2: Correos Agregados (rua) -->
          <div class="space-y-2">
            <label for="rua" class="block text-sm font-bold text-neutral-900">
              2. ¿A qué dirección(es) de correo se deben enviar los reportes agregados (rua)?
            </label>
            <input 
              type="text" 
              id="rua" 
              value="" 
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="mailto:dmarc-reports@tudominio.com" 
              class="w-full p-2.5 bg-white border-2 border-neutral-300 rounded-lg text-neutral-900 font-mono text-sm focus:outline-none focus:border-amber-400 shadow-xs" 
            />
          </div>

          <!-- Campo 3: Correos Forenses (ruf) -->
          <div class="space-y-2">
            <label for="ruf" class="block text-sm font-bold text-neutral-900">
              3. ¿A qué dirección(es) deseas recibir reportes forenses de fallos (ruf)?
            </label>
            <input 
              type="text" 
              id="ruf" 
              value="" 
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="mailto:dmarc-reports@tudominio.com" 
              class="w-full p-2.5 bg-white border-2 border-neutral-300 rounded-lg text-neutral-900 font-mono text-sm focus:outline-none focus:border-amber-400 shadow-xs" 
            />
          </div>

          <!-- Campo 4: Porcentaje (pct) -->
          <div class="space-y-2">
            <label for="pct" class="block text-sm font-bold text-neutral-900">
              4. Porcentaje de mensajes sujetos a filtrado (pct):
            </label>
            <input 
              type="number" 
              id="pct" 
              min="1" 
              max="100" 
              value="100" 
              autocomplete="off"
              class="w-full p-2.5 bg-white border-2 border-neutral-300 rounded-lg text-neutral-900 font-medium focus:outline-none focus:border-amber-400 shadow-xs text-sm" 
            />
            <p class="text-xs text-neutral-700 bg-neutral-50 p-3 rounded-xl border border-neutral-200">
              💡 <strong>Recomendación:</strong> Se aconseja mantenerlo siempre en <strong>100</strong> en producción. Reducir este valor (ej. 10 o 50) solo es útil para despliegues graduales de políticas restrictivas y evitar bloqueos masivos iniciales.
            </p>
          </div>
        </div>

        <!-- Columna Derecha: Salida y Registro Actual -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-5 text-slate-100">
            <div class="space-y-1">
              <h2 class="text-lg font-bold text-slate-100">
                Resultado del Registro Creado:
              </h2>
              <p class="text-xs text-slate-400">
                El registro inferior se actualiza automáticamente a medida que modificas los parámetros del formulario.
              </p>
            </div>

            <!-- Bloque de Registro Estructurado -->
            <div class="bg-slate-950 text-slate-100 p-4 rounded-xl font-mono text-xs space-y-2 border-2 border-slate-800 shadow-inner">
              <div class="text-slate-400">
                <span class="text-amber-400 font-bold">Tipo:</span> TXT
              </div>
              <div class="text-slate-400 break-all">
                <span class="text-amber-400 font-bold">Host/Nombre:</span> <span id="dns-host" class="text-emerald-400">_dmarc.tudominio.com</span>
              </div>
              <div class="text-slate-400 break-all">
                <span class="text-amber-400 font-bold">Valor:</span> <span id="dns-value" class="text-emerald-300">v=DMARC1; p=none;</span>
              </div>
            </div>

            <p class="text-xs text-slate-300 bg-slate-950 p-3 rounded-xl border border-slate-800">
              💡 <strong>Nota Importante:</strong> En la mayoría de proveedores DNS (como Cloudflare o cPanel), solo debes introducir <code class="bg-slate-900 px-1.5 py-0.5 rounded font-bold text-amber-400 border border-slate-700">_dmarc</code> en el campo de Nombre/Host. La plataforma añadirá tu dominio automáticamente al guardarlo.
            </p>

            <button 
              id="copy-btn" 
              class="w-full bg-amber-400 hover:bg-amber-500 text-neutral-900 font-bold py-3 px-4 rounded-xl transition-colors shadow-md flex items-center justify-center gap-2 cursor-pointer text-sm"
            >
              Copiar Registro al Portapapeles
            </button>
          </div>

          <!-- Bloque: Current Record -->
          <div class="bg-white border-2 border-neutral-300 rounded-2xl p-6 shadow-sm space-y-3">
            <h3 class="text-sm font-bold text-neutral-900 flex items-center gap-2">
              Registro Actual en DNS: <span id="current-status-icon" class="text-neutral-400">⚡</span>
            </h3>
            <div id="current-record-box" class="bg-neutral-50 text-neutral-800 p-3 rounded-xl font-mono text-xs break-all border border-neutral-200 min-h-[48px] flex items-center">
              Sin consultar / No encontrado
            </div>
          </div>
        </div>

      </div>

      <!-- Sección de Contenido SEO y Guía Técnica de Apoyo -->
      <section class="bg-white border-2 border-neutral-300 rounded-2xl p-6 sm:p-8 space-y-4 text-neutral-800 shadow-sm">
        <h2 class="text-xl font-bold font-display uppercase tracking-wide text-neutral-900 border-b border-neutral-200 pb-2">
          Buenas prácticas para la implementación de registros DMARC
        </h2>
        <p class="text-sm leading-relaxed text-neutral-700">
          Al configurar tu dominio con DMARC, se recomienda comenzar siempre con una política de monitoreo (<code class="font-mono text-xs bg-neutral-100 px-1 py-0.5 rounded border border-neutral-200">p=none</code>) vinculada a una dirección de reportes agregados (<code class="font-mono text-xs bg-neutral-100 px-1 py-0.5 rounded border border-neutral-200">rua</code>). Esto permite recopilar telemetría completa sobre los flujos de correo legítimos sin riesgo de bloquear mensajes importantes. Una vez analizados los reportes y corroborada la correcta alineación de SPF y DKIM, es aconsejable migrar progresivamente a políticas restrictivas de cuarentena o rechazo total.
        </p>
      </section>

    </div>
  </main>

  <script>
    const domainInput = document.getElementById('domain') as HTMLInputElement;
    const fetchDnsBtn = document.getElementById('fetch-dns-btn');
    const policySelect = document.getElementById('policy') as HTMLSelectElement;
    const ruaInput = document.getElementById('rua') as HTMLInputElement;
    const rufInput = document.getElementById('ruf') as HTMLInputElement;
    const pctInput = document.getElementById('pct') as HTMLInputElement;
    
    const dnsHostSpan = document.getElementById('dns-host');
    const dnsValueSpan = document.getElementById('dns-value');
    const copyBtn = document.getElementById('copy-btn');
    const currentRecordBox = document.getElementById('current-record-box');
    const currentStatusIcon = document.getElementById('current-status-icon');
    const backBtn = document.getElementById('back-btn');

    // Manejar el botón de regreso de forma segura
    backBtn?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/tools';
      }
    });

    // Forzar vaciado de campos al cargar la página para evitar caché del navegador
    if (domainInput) domainInput.value = '';
    if (ruaInput) ruaInput.value = '';
    if (rufInput) rufInput.value = '';
    if (policySelect) policySelect.value = 'none';
    if (pctInput) pctInput.value = '100';

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        if (domainInput) domainInput.value = '';
        if (ruaInput) ruaInput.value = '';
        if (rufInput) rufInput.value = '';
        if (policySelect) policySelect.value = 'none';
        if (pctInput) pctInput.value = '100';
      }
    });

    function updateDmarcRecord() {
      const domain = domainInput.value.trim() || 'tudominio.com';
      const policy = policySelect.value;
      const rua = ruaInput.value.trim();
      const ruf = rufInput.value.trim();
      const pct = pctInput.value.trim();

      if (dnsHostSpan) {
        dnsHostSpan.textContent = `_dmarc.${domain}`;
      }

      const parts: string[] = ['v=DMARC1', `p=${policy}`];
      if (rua) parts.push(`rua=${rua}`);
      if (ruf) parts.push(`ruf=${ruf}`);
      if (pct && pct !== '100' && Number(pct) > 0 && Number(pct) <= 100) {
        parts.push(`pct=${pct}`);
      }

      if (dnsValueSpan) {
        dnsValueSpan.textContent = parts.join('; ') + ';';
      }
    }

    async function fetchCurrentDnsRecord() {
      const domain = domainInput.value.trim();
      if (!domain) return;

      if (currentRecordBox) {
        currentRecordBox.textContent = 'Consultando servidores DNS...';
      }

      try {
        const response = await fetch(window.location.href, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain })
        });
        const data = await response.json();

        if (data.currentRecord) {
          if (currentRecordBox) currentRecordBox.textContent = data.currentRecord;
          if (currentStatusIcon) currentStatusIcon.textContent = '✔';
        } else {
          if (currentRecordBox) currentRecordBox.textContent = 'No se encontró registro TXT DMARC para este dominio.';
          if (currentStatusIcon) currentStatusIcon.textContent = '❌';
        }
      } catch (e) {
        if (currentRecordBox) currentRecordBox.textContent = 'Error al realizar la consulta DNS.';
      }
    }

    domainInput?.addEventListener('input', updateDmarcRecord);
    policySelect?.addEventListener('change', updateDmarcRecord);
    ruaInput?.addEventListener('input', updateDmarcRecord);
    rufInput?.addEventListener('input', updateDmarcRecord);
    pctInput?.addEventListener('input', updateDmarcRecord);

    fetchDnsBtn?.addEventListener('click', fetchCurrentDnsRecord);
    domainInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') fetchCurrentDnsRecord();
    });

    copyBtn?.addEventListener('click', () => {
      const textToCopy = dnsValueSpan?.textContent || '';
      navigator.clipboard.writeText(textToCopy).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = '¡Registro Copiado con Éxito!';
        setTimeout(() => { copyBtn.textContent = originalText; }, 2000);
      });
    });

    updateDmarcRecord();
  </script>
</Layout>