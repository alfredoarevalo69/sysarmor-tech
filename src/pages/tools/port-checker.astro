---
// src/pages/tools/port-checker.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Comprobador de Puertos TCP | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Navegación de retorno -->
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-slate-200/80 hover:bg-slate-300 border border-slate-300 rounded-lg text-slate-800 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <!-- Encabezado -->
      <div class="space-y-2 text-center max-w-2xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide">
          Comprobador de Puertos TCP
        </h1>
        <p class="text-neutral-700 font-medium text-base">
          Verifica la disponibilidad y el estado de puertos específicos (TCP Handshake) en hosts remotos o servidores.
        </p>
      </div>

      <!-- Buscador / Formulario -->
      <div class="bg-white border-2 border-slate-300 rounded-xl p-6 sm:p-8 shadow-xl space-y-6">
        <form id="port-form" class="space-y-4">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1 space-y-1">
              <label for="host-input" class="block text-xs font-bold text-neutral-700 uppercase tracking-wide">Host o Dirección IP</label>
              <input 
                type="text" 
                id="host-input" 
                placeholder="Ej: 192.168.1.1 o midominio.com" 
                required
                class="w-full bg-neutral-50 border-2 border-slate-300 rounded-lg px-4 py-3 text-neutral-900 font-medium text-sm focus:outline-none focus:border-blue-700 transition-colors"
              />
            </div>
            <div class="w-full sm:w-36 space-y-1">
              <label for="port-input" class="block text-xs font-bold text-neutral-700 uppercase tracking-wide">Puerto TCP</label>
              <input 
                type="number" 
                id="port-input" 
                placeholder="Ej: 3389" 
                min="1" 
                max="65535" 
                required
                class="w-full bg-neutral-50 border-2 border-slate-300 rounded-lg px-4 py-3 text-neutral-900 font-mono text-sm focus:outline-none focus:border-blue-700 transition-colors"
              />
            </div>
            <div class="flex items-end">
              <button 
                type="submit" 
                id="submit-btn"
                class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-3 rounded-lg transition-colors text-sm shadow-sm cursor-pointer h-[46px]"
              >
                Comprobar
              </button>
            </div>
          </div>

          <!-- Accesos rápidos de puertos comunes -->
          <div class="space-y-2 pt-2 border-t border-slate-200">
            <span class="block text-xs font-bold text-neutral-500 uppercase tracking-wide">Puertos comunes frecuentes:</span>
            <div class="flex flex-wrap gap-2">
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="3389">3389 (RDP)</button>
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="443">443 (HTTPS)</button>
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="80">80 (HTTP)</button>
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="22">22 (SSH)</button>
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="53">53 (DNS)</button>
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="389">389 (LDAP)</button>
              <button type="button" class="port-preset px-3 py-1 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-md font-mono text-xs font-semibold text-slate-700 transition-colors cursor-pointer" data-port="636">636 (LDAPS)</button>
            </div>
          </div>
        </form>
      </div>

      <!-- Contenedor de Resultados -->
      <div id="results-container" class="hidden bg-white border-2 border-slate-300 rounded-xl p-6 sm:p-8 shadow-xl space-y-6">
        <h2 class="text-xl font-bold text-neutral-900 border-b-2 border-slate-200 pb-3">
          Resultado del Diagnóstico
        </h2>
        <div id="results-content"></div>
      </div>

    </div>
  </main>

  <script>
    const form = document.getElementById('port-form') as HTMLFormElement;
    const hostInput = document.getElementById('host-input') as HTMLInputElement;
    const portInput = document.getElementById('port-input') as HTMLInputElement;
    const container = document.getElementById('results-container') as HTMLDivElement;
    const content = document.getElementById('results-content') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const presets = document.querySelectorAll('.port-preset');

    presets.forEach(preset => {
      preset.addEventListener('click', () => {
        const port = preset.getAttribute('data-port');
        if (port && portInput) {
          portInput.value = port;
        }
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const host = hostInput.value.trim();
      const port = portInput.value.trim();
      if (!host || !port) return;

      btn.textContent = 'Analizando...';
      btn.setAttribute('disabled', 'true');
      container.classList.add('hidden');

      try {
        const response = await fetch(`/api/check-port?host=${encodeURIComponent(host)}&port=${encodeURIComponent(port)}`);
        const result = await response.json();

        if (result.success) {
          const { isOpen, host: resHost, port: resPort } = result.data;
          
          if (isOpen) {
            content.innerHTML = `
              <div class="p-4 bg-emerald-50 border-2 border-emerald-400 text-emerald-900 rounded-lg flex items-center justify-between">
                <div class="space-y-1">
                  <div class="flex items-center gap-2 font-bold text-base">
                    <span class="w-3 h-3 rounded-full bg-emerald-600 inline-block"></span>
                    Puerto ABIETO (Open)
                  </div>
                  <p class="text-xs font-mono text-emerald-800">El host <strong>${resHost}</strong> está respondiendo y aceptando conexiones en el puerto <strong>${resPort}</strong>.</p>
                </div>
              </div>
            `;
          } else {
            content.innerHTML = `
              <div class="p-4 bg-red-50 border-2 border-red-400 text-red-900 rounded-lg flex items-center justify-between">
                <div class="space-y-1">
                  <div class="flex items-center gap-2 font-bold text-base">
                    <span class="w-3 h-3 rounded-full bg-red-600 inline-block"></span>
                    Puerto CERRADO o FILTRADO (Closed/Filtered)
                  </div>
                  <p class="text-xs font-mono text-red-800">No se pudo establecer conexión TCP con <strong>${resHost}</strong> en el puerto <strong>${resPort}</strong> (Timeout o rechazado por firewall).</p>
                </div>
              </div>
            `;
          }
        } else {
          content.innerHTML = `<p class="text-red-700 font-bold text-sm">Error: ${result.error}</p>`;
        }

        container.classList.remove('hidden');
      } catch (err) {
        content.innerHTML = `<p class="text-red-700 font-bold text-sm">Error de conexión con el servidor de diagnóstico.</p>`;
        container.classList.add('hidden');
      } finally {
        btn.textContent = 'Comprobar';
        btn.removeAttribute('disabled');
      }
    });
  </script>
</Layout>