---
// src/pages/tools/dmarc-checker.astro
import Layout from '../../layouts/Layout.astro';

const seo = {
  title: 'Validador de Políticas DMARC y Registros DNS | SysArmor Tech',
  description: 'Audita y verifica en tiempo real la política DMARC, registros TXT, alineación SPF/DKIM y reportes RUA/RUF de tu dominio para prevenir suplantación de identidad y ataques de email spoofing.',
  canonical: 'https://sysarmortech.com/tools/dmarc-checker',
  keywords: 'validador dmarc, verificar dmarc, registros dns dmarc, spf dkim dmarc, auditoria de correo, seguridad de correo electronico'
};

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Validador de Políticas DMARC y Registros DNS",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "url": "https://sysarmortech.com/tools/dmarc-checker",
      "description": "Herramienta online para auditar registros DNS y políticas DMARC de dominios corporativos.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es un registro DMARC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DMARC (Domain-based Message Authentication, Reporting, and Conformance) es un protocolo de autenticación de correo electrónico que utiliza SPF y DKIM para determinar la autenticidad de un mensaje de correo electrónico, protegiendo a los dominios contra el spoofing y el phishing."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué significan las políticas p=none, p=quarantine y p=reject?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La política (p) indica al servidor receptor qué hacer con los correos que fallan la verificación: 'none' solo recopila informes sin bloquear nada, 'quarantine' envía los correos sospechosos a la bandeja de spam, y 'reject' bloquea y rechaza el correo por completo."
          }
        }
      ]
    }
  ]
};
---

<Layout title={seo.title} description={seo.description}>
  <Fragment slot="head">
    <link rel="canonical" href={seo.canonical} />
    <meta name="keywords" content={seo.keywords} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-amber-400 hover:bg-amber-500 border border-amber-500 rounded-lg text-neutral-900 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <!-- Cuadro Superior Estándar de Metadatos y Encabezado -->
      <div class="bg-white border-2 border-neutral-300 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-neutral-200 pb-4 text-xs font-semibold text-neutral-600">
          <span class="inline-flex items-center px-3 py-1 bg-amber-200/70 border border-amber-300 text-neutral-900 rounded-full font-bold">
            Seguridad de Correo & DNS
          </span>
          <div class="flex items-center gap-4 text-neutral-500">
            <span>Actualizado: 23 Sept, 2026</span>
            <span>•</span>
            <span>Versión: 1.2.0</span>
          </div>
        </div>

        <div class="space-y-3 text-center max-w-2xl mx-auto pt-2">
          <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide uppercase">
            Validador de Políticas DMARC y Registros DNS
          </h1>
          <p class="text-neutral-700 font-medium text-base">
            Herramienta avanzada para administradores de sistemas e infraestructura TI. Audita la política de autenticación, reporte y conformidad de correo electrónico de tu dominio de forma rápida y segura.
          </p>
        </div>
      </div>

      <!-- Contenedor Oscuro Estándar del Formulario y Resultados -->
      <div class="bg-slate-900 border-2 border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
        <form id="dmarc-form" autocomplete="off" class="space-y-4">
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="text" 
              id="domain-input" 
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="Ej: co.bancofalabella.com o tudominio.com" 
              required
              class="flex-1 bg-slate-950 border-2 border-slate-700 rounded-xl px-4 py-3 text-slate-100 font-medium text-sm focus:outline-none focus:border-amber-400 shadow-inner placeholder-slate-500"
            />
            <button 
              type="submit" 
              id="submit-btn"
              class="bg-amber-400 hover:bg-amber-500 text-neutral-900 font-bold px-6 py-3 rounded-xl transition-colors text-sm shadow-md cursor-pointer shrink-0 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Verificar DMARC
            </button>
          </div>
        </form>

        <div id="results-container" class="hidden space-y-6 pt-6 border-t-2 border-slate-800">
          <h2 class="text-xl font-bold text-slate-100 border-b-2 border-slate-800 pb-3">
            Resultado de Validación
          </h2>
          <div id="results-content" class="space-y-4 text-slate-100"></div>
        </div>
      </div>

      <!-- Sección de Contenido SEO y Guía Técnica de Apoyo -->
      <section class="bg-white border-2 border-neutral-300 rounded-2xl p-6 sm:p-8 space-y-4 text-neutral-800 shadow-sm">
        <h2 class="text-xl font-bold font-display uppercase tracking-wide text-neutral-900 border-b border-neutral-200 pb-2">
          ¿Por qué es vital validar las políticas DMARC y SPF/DKIM?
        </h2>
        <p class="text-sm leading-relaxed text-neutral-700">
          El protocolo <strong>DMARC</strong> (Domain-based Message Authentication, Reporting, and Conformance) trabaja en conjunto con <strong>SPF</strong> (Sender Policy Framework) y <strong>DKIM</strong> (DomainKeys Identified Mail) para salvaguardar la reputación de tu dominio corporativo. Una correcta implementación de políticas DMARC previene ataques de suplantación de identidad (spoofing), phishing y asegura que los correos legítimos no sean clasificados como correo no deseado (spam) en los principales proveedores de correo.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="bg-neutral-50 border border-neutral-200 p-4 rounded-xl space-y-1">
            <h3 class="font-bold text-sm text-neutral-900">Política <code>p=none</code></h3>
            <p class="text-xs text-neutral-600">Modo monitoreo. Recibe reportes estadísticos sin alterar la entrega de correos que fallen la validación.</p>
          </div>
          <div class="bg-neutral-50 border border-neutral-200 p-4 rounded-xl space-y-1">
            <h3 class="font-bold text-sm text-neutral-900">Política <code>p=quarantine</code></h3>
            <p class="text-xs text-neutral-600">Los mensajes que no superen las comprobaciones de autenticidad se redirigen automáticamente a la bandeja de spam.</p>
          </div>
          <div class="bg-neutral-50 border border-neutral-200 p-4 rounded-xl space-y-1">
            <h3 class="font-bold text-sm text-neutral-900">Política <code>p=reject</code></h3>
            <p class="text-xs text-neutral-600">Máxima seguridad. Bloquea y descarta por completo los correos electrónicos no autorizados antes de llegar al buzón.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    const form = document.getElementById('dmarc-form') as HTMLFormElement;
    const domainInput = document.getElementById('domain-input') as HTMLInputElement;
    const container = document.getElementById('results-container') as HTMLDivElement;
    const content = document.getElementById('results-content') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form) form.reset();
    if (domainInput) domainInput.value = '';

    window.addEventListener('pageshow', (event) => {
      if (event.persisted && form) {
        form.reset();
        if (domainInput) domainInput.value = '';
        if (container) container.classList.add('hidden');
      }
    });

    const dmarcMeta: Record<string, { name: string; desc: string }> = {
      v: { name: 'Version', desc: 'Identifica el registro como DMARC1.' },
      p: { name: 'Policy', desc: 'Política para correos que fallan DMARC (none, quarantine, reject).' },
      sp: { name: 'Subdomain Policy', desc: 'Política heredada para subdominios.' },
      pct: { name: 'Percentage', desc: 'Porcentaje de mensajes sujetos a filtrado.' },
      rua: { name: 'Receivers (Aggregate)', desc: 'URI para reportes de agregados estadísticos.' },
      ruf: { name: 'Forensic Receivers', desc: 'URI para reportes de fallos específicos.' },
      fo: { name: 'Forensic Reporting', desc: 'Opciones de generación de reportes de fallos.' },
      aspf: { name: 'SPF Alignment', desc: 'Modo de alineación para SPF (r: relaxed, s: strict).' },
      adkim: { name: 'DKIM Alignment', desc: 'Modo de alineación para DKIM (r: relaxed, s: strict).' }
    };

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function parseDmarcRecord(recordStr: string) {
      return recordStr.split(';').map(part => {
        const [rawKey, ...valParts] = part.trim().split('=');
        if (!rawKey) return null;
        const key = rawKey.trim().toLowerCase();
        const value = valParts.join('=').trim();
        const meta = dmarcMeta[key] || { name: key.toUpperCase(), desc: 'Parámetro personalizado o extendido.' };
        return { tag: key, value, name: meta.name, desc: meta.desc };
      }).filter(Boolean);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = domainInput.value.trim();
      if (!domain) return;

      if (btn) {
        btn.textContent = 'Analizando...';
        btn.setAttribute('disabled', 'true');
      }
      if (container) container.classList.add('hidden');

      try {
        const response = await fetch('/api/check-dmarc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain })
        });

        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
          throw new Error('La respuesta del servidor no tiene un formato válido.');
        }

        const result = await response.json();

        if (response.ok) {
          const { status, record, qname } = result;
          
          if (status === 'PASS' && record) {
            const tags = parseDmarcRecord(record);
            let rowsHtml = tags.map(t => `
              <tr class="border-b border-slate-800 hover:bg-slate-800/50">
                <td class="px-4 py-3 font-mono font-bold text-amber-400">${escapeHtml(t?.tag || '')}</td>
                <td class="px-4 py-3 font-mono text-xs text-blue-300 break-all">${escapeHtml(t?.value || '')}</td>
                <td class="px-4 py-3 font-semibold text-slate-200">${escapeHtml(t?.name || '')}</td>
                <td class="px-4 py-3 text-slate-400 text-xs">${escapeHtml(t?.desc || '')}</td>
              </tr>
            `).join('');

            content.innerHTML = `
              <div class="p-4 bg-slate-950 border-2 border-slate-800 rounded-xl space-y-2">
                <div class="font-bold text-sm uppercase tracking-wide text-emerald-400">Registro DMARC Encontrado (${escapeHtml(qname || domain)})</div>
                <p class="text-xs font-mono break-all bg-slate-900 p-3 rounded-lg border border-slate-800 text-slate-200">${escapeHtml(record)}</p>
              </div>

              <div class="overflow-x-auto border-2 border-slate-800 rounded-xl bg-slate-950 shadow-inner">
                <table class="w-full text-left border-collapse text-sm">
                  <thead>
                    <tr class="bg-slate-900 border-b-2 border-slate-800 text-slate-300 font-bold text-xs uppercase tracking-wider">
                      <th class="px-4 py-3">Tag</th>
                      <th class="px-4 py-3">TagValue</th>
                      <th class="px-4 py-3">Name</th>
                      <th class="px-4 py-3">Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    ${rowsHtml}
                  </tbody>
                </table>
              </div>
            `;
          } else {
            content.innerHTML = `
              <div class="p-4 bg-slate-950 border-2 border-slate-800 rounded-xl space-y-1">
                <div class="font-bold text-sm uppercase tracking-wide text-red-400">Registro DMARC (${escapeHtml(qname || domain)})</div>
                <p class="text-xs text-slate-400">No se encontró un registro DMARC válido configurado para este dominio ni en su dominio raíz.</p>
              </div>
            `;
          }
        } else {
          content.innerHTML = `<p class="text-red-400 font-bold text-sm">Error: ${escapeHtml(result.error || 'Error desconocido del servidor')}</p>`;
        }

        if (container) container.classList.remove('hidden');
      } catch (err: any) {
        content.innerHTML = `<p class="text-red-400 font-bold text-sm">Error: ${escapeHtml(err.message || 'Error al conectar con el servidor.')}</p>`;
        if (container) container.classList.remove('hidden');
      } finally {
        if (btn) {
          btn.textContent = 'Verificar DMARC';
          btn.removeAttribute('disabled');
        }
      }
    });
  </script>
</Layout>