---
// src/pages/tools/index.astro
import Layout from '../../layouts/Layout.astro';

// Definimos los iconos SVG por separado para mantener limpio el arreglo de objetos
const icons = {
  redirect: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>',
  calculator: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="14" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="14" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="10" y2="18"/><line x1="14" y1="18" x2="16" y2="18"/></svg>',
  cidr: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 010 18M12 3a15.3 15.3 0 000 18"/></svg>',
  port: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>',
  ip: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>',
  cloud: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>',
  shield: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>',
  mail: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>',
  key: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>',
  code: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>',
  search: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>',
  document: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>',
  warning: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>',
  report: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-zinc-200 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>'
};

const redTools = [
  {
    title: "Auditor de Cadenas de Redirección",
    description: "Inspecciona cada salto (hop), detecta redirecciones temporales erróneas (302) y protege tu posicionamiento SEO.",
    href: "/tools/redirect-chain",
    badge: "Infraestructura & SEO",
    svgIcon: icons.redirect
  },
  {
    title: "Calculadora VLSM (IPv4)",
    description: "Diseña subredes IP de tamaño variable de forma eficiente y optimiza el direccionamiento IPv4.",
    href: "/tools/vlsm",
    badge: "Redes IPv4",
    svgIcon: icons.calculator
  },
  {
    title: "Calculadora CIDR (IPv4)",
    description: "Desglosa bloques de red en notación CIDR para obtener máscaras y rangos de hosts útiles.",
    href: "/tools/cidr",
    badge: "Redes IPv4",
    svgIcon: icons.cidr
  },
  {
    title: "Calculadora de Subredes (IPv6)",
    description: "Distribuye y planifica bloques jerárquicos de red IPv6 por requerimientos de subred o dispositivos.",
    href: "/tools/ipv6-subnetting",
    badge: "Redes IPv6",
    svgIcon: icons.calculator
  },
  {
    title: "Calculadora CIDR IPv6",
    description: "Analiza prefijos y bloques jerárquicos de red IPv6 con soporte para expansión de ceros.",
    href: "/tools/ipv6-cidr",
    badge: "Redes IPv6",
    svgIcon: icons.cidr
  },
  {
    title: "Comprobador de Puertos TCP",
    description: "Verifica disponibilidad y estado de puertos específicos mediante conexión TCP (Handshake).",
    href: "/tools/port-checker",
    badge: "Redes & Sockets",
    svgIcon: icons.port
  },
  {
    title: "¿Cuál es mi IP?",
    description: "Visualiza tu dirección IP pública actual, navegador y detalles de red de forma rápida y directa.",
    href: "/tools/what-is-my-ip",
    badge: "Redes",
    svgIcon: icons.ip
  }
];

const cloudTools = [
  {
    title: "Matriz de Equivalencias Multi-Cloud",
    description: "Traducción directa de arquitecturas, servicios de red, cómputo y ciberseguridad entre Microsoft Azure, AWS y GCP.",
    href: "/tools/cloud-matrix",
    badge: "Arquitectura Cloud",
    svgIcon: icons.cloud
  }
];

const emailTools = [
  {
    title: "Auditoría de Salud DNS y Correo",
    description: "Analiza la salud general de servidores DNS (NS, MX) y configuraciones de seguridad (SPF, DMARC).",
    href: "/tools/dns-health-audit",
    badge: "Diagnóstico DNS",
    svgIcon: icons.ip
  },
  {
    title: "Validador de Registros MX",
    description: "Verifica los servidores de correo electrónico configurados y su jerarquía de prioridad para dominios.",
    href: "/tools/mx",
    badge: "DNS & Correo",
    svgIcon: icons.mail
  },
  {
    title: "Validador de Registro SPF",
    description: "Inspecciona los registros TXT y valida la sintaxis de las políticas SPF para proteger tu dominio.",
    href: "/tools/spf",
    badge: "Seguridad & DNS",
    svgIcon: icons.shield
  },
  {
    title: "Validador de Registro DKIM",
    description: "Comprueba la clave pública y la integridad de los registros DKIM bajo selectores personalizados.",
    href: "/tools/dkim-checker",
    badge: "Seguridad & DNS",
    svgIcon: icons.key
  },
  {
    title: "Validador DMARC",
    description: "Audita la política de autenticación, reporte y conformidad de correo electrónico de tus dominios.",
    href: "/tools/dmarc-checker",
    badge: "Seguridad & DNS",
    svgIcon: icons.mail
  },
  {
    title: "Generador de Registros DMARC",
    description: "Construye cadenas de texto para registros DNS TXT de DMARC con soporte para políticas.",
    href: "/tools/dmarc-generator",
    badge: "Seguridad & Correo",
    svgIcon: icons.mail
  },
  {
    title: "Analizador de Cabeceras de Correo",
    description: "Inspecciona saltos de red detallados, latencias y validaciones SPF, DKIM y DMARC.",
    href: "/tools/email-analyzer",
    badge: "Seguridad & M365",
    svgIcon: icons.mail
  }
];

const securityWebTools = [
  {
    title: "Analizador de Cabeceras HTTP / HTTPS",
    description: "Audita cabeceras de respuesta de servidores bajo protocolos seguros TLS/SSL.",
    href: "/tools/http-headers",
    badge: "Seguridad Web",
    svgIcon: icons.code
  },
  {
    title: "Validador de Certificados X.509",
    description: "Analiza la validez, vigencia, emisor y propiedades criptográficas de certificados SSL/TLS en PEM.",
    href: "/tools/certificate-validator",
    badge: "Seguridad & SSL",
    svgIcon: icons.shield
  },
  {
    title: "Generador de Solicitudes CSR",
    description: "Genera pares de claves criptográficas y solicitudes de firma de certificados X.509 (CSR) de forma local en el navegador.",
    href: "/tools/csr-generator",
    badge: "Seguridad & SSL",
    svgIcon: icons.key
  },
  {
    title: "Generador de Claves y Contraseñas",
    description: "Crea claves robustas y contraseñas seguras utilizando entropía nativa del navegador de forma local.",
    href: "/tools/key-generator",
    badge: "Seguridad & Criptografía",
    svgIcon: icons.key
  },
  {
    title: "Validador Oficial Spamhaus DQS",
    description: "Consulta la reputación de dominios e IPs en tiempo real frente al DQS de Spamhaus, Google Safe Browsing y PhishTank.",
    href: "/tools/spamhaus-checker",
    badge: "Seguridad & DNS",
    svgIcon: icons.warning
  },
  {
    title: "Reporte Ejecutivo de Seguridad",
    description: "Consolidado multi-herramienta de hardening, análisis de protocolos de transporte y conformidad global.",
    href: "/tools/report",
    badge: "Auditoría Global",
    svgIcon: icons.report
  }
];

const whoisTools = [
  {
    title: "Buscador WHOIS de Dominios",
    description: "Consulta información de registro, fechas de expiración y servidores de nombres en tiempo real.",
    href: "/tools/whois",
    badge: "Redes & DNS",
    svgIcon: icons.search
  },
  {
    title: "Verificador de Registros PTR (rDNS)",
    description: "Valida el DNS inverso de IPs de envío SMTP para prevenir bloqueos de correo y asegurar la entregabilidad.",
    href: "/tools/ptr-checker",
    badge: "Correo & rDNS",
    svgIcon: icons.document
  }
];

const renderCards = (toolsList: typeof redTools) => {
  return toolsList.map((tool) => `
    <article class="rounded-xl p-5 border-2 border-zinc-400 transition-all duration-300 flex flex-col justify-between space-y-4 bg-white shadow-md hover:border-blue-600 hover:shadow-xl hover:-translate-y-1 relative overflow-hidden group">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="p-2 bg-zinc-900 border border-zinc-700 rounded-lg shrink-0 flex items-center justify-center shadow-sm group-hover:bg-blue-600 group-hover:border-blue-500 transition-colors">
            ${tool.svgIcon}
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-zinc-100 border border-zinc-300 text-zinc-700 shadow-sm">
              ${tool.badge}
            </span>
          </div>
        </div>
        <div class="space-y-1">
          <h2 class="font-display font-bold tracking-tight text-neutral-900 text-sm sm:text-base group-hover:text-blue-600 transition-colors uppercase">
            <a href="${tool.href}" class="focus:outline-none focus:ring-0 focus-visible:outline-none before:absolute before:inset-0 before:z-10">
              ${tool.title}
            </a>
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 line-clamp-2 leading-relaxed font-sans">
            ${tool.description}
          </p>
        </div>
      </div>
    </article>
  `).join('');
};
---

<Layout title="Herramientas de Infraestructura y Redes | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-[#cbd5e1] text-neutral-900 border-t-2 border-zinc-300">
    <div class="max-w-5xl mx-auto space-y-12">
      
      <!-- Cabecera Principal -->
      <div class="space-y-3 text-center max-w-2xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide uppercase">
          Herramientas de SysArmor Tech
        </h1>
        <p class="text-zinc-700 font-medium text-base sm:text-lg leading-relaxed font-sans">
          Utilidades propias desarrolladas como proyectos personales, pensadas para ingenieros de sistemas y administradores de infraestructura IT.
        </p>

        <div class="bg-amber-100 border-2 border-amber-400 text-amber-950 py-3 px-4 rounded-lg shadow-sm inline-flex items-center gap-2.5 text-xs sm:text-sm font-semibold tracking-wide">
          <span class="text-base shrink-0">🔒</span>
          <span>Los datos y parámetros ingresados son de procesamiento temporal local: no se almacenan ni se registran en servidores.</span>
        </div>
      </div>

      <!-- SECCIÓN 1: Redes e Infraestructura IP -->
      <section class="space-y-6">
        <h2 class="text-xl font-display font-bold text-neutral-900 uppercase tracking-wide border-l-4 border-blue-600 pl-3">
          Redes e Infraestructura IP
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1" set:html={renderCards(redTools)} />
      </section>

      <!-- SECCIÓN NUEVA: Arquitectura Cloud e Infraestructura Híbrida -->
      <section class="space-y-6">
        <h2 class="text-xl font-display font-bold text-neutral-900 uppercase tracking-wide border-l-4 border-blue-600 pl-3">
          Arquitectura Cloud e Infraestructura Híbrida
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1" set:html={renderCards(cloudTools)} />
      </section>

      <!-- SECCIÓN 2: Correo Electrónico y Autenticación -->
      <section class="space-y-6">
        <h2 class="text-xl font-display font-bold text-neutral-900 uppercase tracking-wide border-l-4 border-blue-600 pl-3">
          Correo Electrónico y Autenticación (SPF/DKIM/DMARC)
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1" set:html={renderCards(emailTools)} />
      </section>

      <!-- SECCIÓN 3: Seguridad Web y Certificados -->
      <section class="space-y-6">
        <h2 class="text-xl font-display font-bold text-neutral-900 uppercase tracking-wide border-l-4 border-blue-600 pl-3">
          Seguridad Web, Criptografía y Certificados SSL
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1" set:html={renderCards(securityWebTools)} />
      </section>

      <!-- SECCIÓN 4: DNS Inverso y Registros WHOIS -->
      <section class="space-y-6">
        <h2 class="text-xl font-display font-bold text-neutral-900 uppercase tracking-wide border-l-4 border-blue-600 pl-3">
          DNS Inverso y Registros WHOIS
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1" set:html={renderCards(whoisTools)} />
      </section>

      <!-- Pie de página con FAQ -->
      <div class="pt-6 text-center border-t-2 border-zinc-300">
        <p class="text-xs sm:text-sm text-zinc-700 font-medium">
          ¿Tienes dudas sobre el funcionamiento o los parámetros? 
          <a href="/#faq" class="font-bold text-amber-700 hover:text-amber-800 hover:underline inline-flex items-center gap-1 ml-1 relative z-20 focus:outline-none focus:ring-0">
            Consulta las Preguntas Frecuentes <span>↓</span>
          </a>
        </p>
      </div>

    </div>
  </main>
</Layout>