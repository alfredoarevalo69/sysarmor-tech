---

<Layout title="Herramientas de Infraestructura y Redes | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-5xl mx-auto space-y-8">
      
      <div class="space-y-2 text-center max-w-2xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide">
          Herramientas de SysArmor Tech
        </h1>
        <p class="text-neutral-700 font-medium text-base">
          Utilidades especializadas diseñadas para ingenieros de sistemas y administradores de infraestructura IT.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        {tools.map((tool) => (
          <article class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl flex flex-col justify-between transition-transform hover:-translate-y-1 duration-200">
            
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="p-3 bg-white rounded-lg border-2 border-slate-300 shadow-xs flex items-center justify-center" set:html={tool.svgIcon} />
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold uppercase tracking-wider bg-blue-800 text-white px-2.5 py-1 rounded-md">
                    {tool.badge}
                  </span>
                  <span class="text-xs font-extrabold uppercase tracking-wider bg-emerald-700 text-white px-2.5 py-1 rounded-md">
                    {tool.status}
                  </span>
                </div>
              </div>

              <div class="space-y-2">
                <h2 class="text-xl font-bold text-neutral-900">
                  {tool.title}
                </h2>
                <p class="text-neutral-700 text-sm font-medium leading-relaxed">
                  {tool.description}
                </p>
              </div>
            </div>

            <div class="pt-6 mt-6 border-t-2 border-slate-300">
              <a 
                href={tool.href}
                class="block w-full bg-slate-900 hover:bg-slate-800 text-white text-center font-bold py-2.5 rounded-lg transition-colors text-sm shadow-sm"
              >
                Acceder a la Herramienta →
              </a>
            </div>

          </article>
        ))}
      </div>

    </div>
  </main>
</Layout>