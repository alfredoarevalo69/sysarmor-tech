---
// src/pages/tools/http-headers.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Analizador de Cabeceras HTTP | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <div class="space-y-2">
        <h1 class="text-3xl font-display font-bold text-neutral-900 tracking-wide">
          Analizador de Cabeceras HTTP
        </h1>
        <p class="text-neutral-700 text-base font-medium">
          Inspecciona y audita las políticas de seguridad, cookies y cabeceras de respuesta de cualquier servidor web.
        </p>
      </div>

      <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-6">
        <form id="header-form" class="space-y-4">
          <div class="space-y-2">
            <label for="target-url" class="block text-sm font-bold text-neutral-900">
              URL del Sitio Web o Servidor
            </label>
            <div class="flex gap-3">
              <input 
                type="url" 
                id="target-url" 
                required 
                placeholder="https://ejemplo.com" 
                class="flex-1 bg-white border-2 border-slate-300 rounded-lg px-4 py-2.5 text-neutral-900 focus:outline-none focus:border-blue-700 font-medium text-sm shadow-xs"
              />
              <button 
                type="submit" 
                id="submit-btn"
                class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-2.5 rounded-lg transition-colors text-sm shadow-sm cursor-pointer"
              >
                Analizar
              </button>
            </div>
          </div>
        </form>

        <div id="results-container" class="hidden space-y-6 pt-6 border-t-2 border-slate-300">
          
          <!-- Resumen de Calificación -->
          <div id="audit-summary" class="bg-white border-2 border-slate-300 rounded-xl p-5 flex items-center justify-between shadow-xs">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-neutral-500 block">Calificación de Seguridad</span>
              <div class="text-sm text-neutral-700 font-medium mt-0.5">Basado en cabeceras de hardening recomendadas</div>
            </div>
            <div id="grade-badge" class="w-16 h-16 rounded-xl flex items-center justify-center text-3xl font-extrabold shadow-sm text-white">
              -
            </div>
          </div>

          <!-- Cabeceras Faltantes con Explicación Detallada -->
          <div class="bg-white border-2 border-slate-300 rounded-xl p-5 space-y-4 shadow-xs">
            <h3 class="text-base font-bold text-neutral-900 border-b border-slate-200 pb-3">
              Cabeceras de Seguridad Faltantes (Missing Headers)
            </h3>
            <div id="missing-headers-list" class="space-y-4 divide-y divide-slate-200">
              <!-- Dinámico -->
            </div>
          </div>

          <!-- Todas las cabeceras devueltas -->
          <div class="space-y-3">
            <h3 class="text-base font-bold text-neutral-900">Cabeceras de Respuesta HTTP del Servidor</h3>
            <div id="results-content" class="bg-white border-2 border-slate-300 rounded-lg p-4 font-mono text-xs overflow-x-auto text-neutral-800 space-y-1.5 max-h-80 overflow-y-auto">
              <!-- Resultados dinámicos -->
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>

  <script>
    const descriptions: Record<string, string> = {
      'content-security-policy': 'Content Security Policy es una medida efectiva para proteger tu sitio de ataques XSS. Al listar orígenes aprobados de contenido, evitas que el navegador cargue recursos maliciosos.',
      'x-frame-options': 'X-Frame-Options indica al navegador si deseas permitir que tu sitio sea enmarcado o no. Previene ataques de clickjacking. Valor recomendado: "X-Frame-Options: SAMEORIGIN".',
      'x-content-type-options': 'X-Content-Type-Options evita que el navegador intente adivinar el tipo MIME (MIME-sniffing) y lo obliga a ceñirse al declarado. El único valor válido es "nosniff".',
      'referrer-policy': 'Referrer Policy permite controlar cuánta información incluye el navegador en las navegaciones hacia fuera de un documento y debe ser configurada en todos los sitios.',
      'permissions-policy': 'Permissions Policy permite a un sitio controlar qué características y APIs del navegador pueden ser utilizadas.'
    };

    const form = document.getElementById('header-form') as HTMLFormElement;
    const inputUrl = document.getElementById('target-url') as HTMLInputElement;
    const resultsContainer = document.getElementById('results-container');
    const resultsContent = document.getElementById('results-content');
    const gradeBadge = document.getElementById('grade-badge');
    const missingHeadersList = document.getElementById('missing-headers-list');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = inputUrl.value.trim();
      if (!url) return;

      submitBtn.textContent = 'Analizando...';
      submitBtn.setAttribute('disabled', 'true');

      try {
        const res = await fetch(`/api/check-headers?url=${encodeURIComponent(url)}`);
        const data = await res.json();

        resultsContainer?.classList.remove('hidden');

        if (!res.ok) {
          if (resultsContent) {
            resultsContent.innerHTML = `<div class="text-red-700 font-bold">Error: ${data.error}</div>`;
          }
          return;
        }

        // Calificación
        const grade = data.audit.grade;
        if (gradeBadge) {
          gradeBadge.textContent = grade;
          let colorClass = 'bg-emerald-700';
          if (grade === 'B') colorClass = 'bg-blue-700';
          if (grade === 'C') colorClass = 'bg-amber-600';
          if (grade === 'D') colorClass = 'bg-orange-600';
          if (grade === 'F') colorClass = 'bg-red-700';
          gradeBadge.className = `w-16 h-16 rounded-xl flex items-center justify-center text-3xl font-extrabold shadow-sm text-white ${colorClass}`;
        }

        // Listado de faltantes con explicación estructurada
        if (missingHeadersList) {
          const missing = data.audit.missingHeaders || [];
          if (missing.length === 0) {
            missingHeadersList.innerHTML = `<div class="text-xs font-bold text-emerald-700 py-2">¡Excelente! El sitio cuenta con todas las cabeceras de seguridad críticas evaluadas.</div>`;
          } else {
            missingHeadersList.innerHTML = missing.map((h: string) => {
              const desc = descriptions[h] || 'Cabecera de seguridad recomendada para mejorar el endurecimiento del servidor.';
              return `
                <div class="pt-4 first:pt-0 grid grid-cols-1 sm:grid-cols-3 gap-2 items-start">
                  <span class="font-bold text-red-700 text-sm">${h}</span>
                  <p class="sm:col-span-2 text-xs text-neutral-600 leading-relaxed">${desc}</p>
                </div>
              `;
            }).join('');
          }
        }

        // Cabeceras HTTP totales
        let headersHtml = `<div class="text-emerald-700 font-bold pb-2">✓ Estado HTTP: ${data.status} ${data.statusText}</div>`;
        for (const [key, value] of Object.entries(data.headers)) {
          headersHtml += `<div><span class="font-bold text-blue-800">${key}:</span> ${value}</div>`;
        }

        if (resultsContent) {
          resultsContent.innerHTML = headersHtml;
        }

      } catch (error) {
        if (resultsContent) {
          resultsContent.innerHTML = `<div class="text-red-700 font-bold">Error crítico al procesar la petición.</div>`;
        }
      } finally {
        submitBtn.textContent = 'Analizar';
        submitBtn.removeAttribute('disabled');
      }
    });
  </script>
</Layout>