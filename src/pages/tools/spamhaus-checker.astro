---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Validador de Reputación y Listas Negras | SysArmor Tech";
const pageDescription = "Verifica el estado de reputación de dominios y servidores de correo frente a motores de seguridad globales como Spamhaus DQS, Google Safe Browsing y PhishTank.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalURL}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <!-- Botón de retorno -->
    <div class="mb-6">
      <a 
        href="/tools"
        class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-xl text-xs transition-all shadow-md font-mono cursor-pointer"
      >
        <span>←</span> VOLVER A HERRAMIENTAS
      </a>
    </div>

    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 font-mono mb-2">Validador de Reputaci&oacute;n y Listas Negras</h1>
      <p class="text-slate-700 text-sm max-w-2xl mx-auto font-medium">
        Analiza la postura de seguridad perimetral de tus dominios frente a motores globales de mitigaci&oacute;n de spam y malware.
      </p>
    </header>

    <!-- Caja de Consulta -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl mb-8">
      <form id="reputation-form" class="space-y-4">
        <div>
          <label for="target-input" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
            Dominio o IP de Correo a Inspeccionar
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="text" 
              id="target-input" 
              placeholder="ej. mail.tudominio.com o 198.51.100.5" 
              required
              autocomplete="off"
              class="w-full sm:flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] transition-all font-mono"
            />
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full sm:w-auto px-6 py-3 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-xl text-sm transition-all shadow-md font-mono flex items-center justify-center sm:min-w-[160px] cursor-pointer"
            >
              Ejecutar Auditor&iacute;a
            </button>
          </div>
        </div>
        <div id="cooldown-msg" class="text-xs text-amber-400 font-mono hidden" role="alert"></div>
      </form>
    </div>

    <!-- Contenedor de Resultados (Oculto por defecto) -->
    <section id="result-container" class="space-y-6 hidden" aria-live="polite">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">Resumen de Motores Globales</h2>
        <ul id="engines-list" class="space-y-3 font-mono text-sm">
          <!-- Inyección dinámica -->
        </ul>
      </div>

      <div id="result-details" class="space-y-4">
        <!-- Guías de remediación y pasos de deslistado nivel 2/3 -->
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('reputation-form') as HTMLFormElement;
    const input = document.getElementById('target-input') as HTMLInputElement;
    const container = document.getElementById('result-container') as HTMLDivElement;
    const enginesList = document.getElementById('engines-list') as HTMLUListElement;
    const resultDetails = document.getElementById('result-details') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const cooldownMsg = document.getElementById('cooldown-msg') as HTMLDivElement;

    let attempts = 0;
    let timer: any = null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const target = input.value.trim().toLowerCase();
      if (!target) return;

      attempts++;
      if (attempts > 3) {
        btn.setAttribute('disabled', 'true');
        input.setAttribute('disabled', 'true');
        let countdown = 15;
        cooldownMsg.classList.remove('hidden');
        cooldownMsg.textContent = `⚠️ Umbral de peticiones alcanzado. Espera ${countdown}s para reintentar el sondeo.`;

        timer = setInterval(() => {
          countdown--;
          if (countdown > 0) {
            cooldownMsg.textContent = `⚠️ Umbral de peticiones alcanzado. Espera ${countdown}s para reintentar el sondeo.`;
          } else {
            clearInterval(timer);
            attempts = 0;
            btn.removeAttribute('disabled');
            input.removeAttribute('disabled');
            cooldownMsg.classList.add('hidden');
          }
        }, 1000);
        return;
      }

      btn.textContent = 'Procesando consultas...';
      btn.setAttribute('disabled', 'true');
      container.classList.add('hidden');

      try {
        const res = await fetch('/api/spamhaus-checker', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain: target })
        });
        const data = await res.json();

        const { googleSafeBrowsing: gsb, phishTank: pt, spamhaus } = data;
        let listMarkup = '';
        let remediationMarkup = '';

        // 1. Google Safe Browsing
        if (gsb.listed) {
          listMarkup += `
            <li class="p-3 bg-slate-950/80 border border-slate-800 text-slate-200 rounded-xl flex items-center justify-between">
              <span><strong class="text-amber-400">Google Safe Browsing:</strong> Alerta de software malicioso/phishing (${gsb.details})</span>
              <span class="text-xs font-mono text-amber-400 bg-amber-950/40 px-2 py-1 rounded border border-amber-800/50">Listado</span>
            </li>`;
          remediationMarkup += `
            <div class="p-4 bg-slate-900 rounded-xl border border-slate-800 space-y-3 font-sans shadow-lg">
              <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <span class="font-mono text-slate-200 font-bold text-sm">Remediación: Google Safe Browsing</span>
                <span class="font-mono text-xs text-amber-400">Acción Requerida</span>
              </div>
              <p class="text-slate-400 text-xs">El recurso web expone patrones de ingeniería social o scripts comprometidos. Verifique la integridad del servidor web y limpie los vectores de inyección.</p>
              <div class="pt-2">
                <a href="https://search.google.com/search-console/security-issues" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-lg text-xs transition-all shadow-md font-mono">
                  Solicitar Revisión en Search Console ↗
                </a>
              </div>
            </div>`;
        } else {
          listMarkup += `
            <li class="p-3 bg-slate-950/80 border border-slate-800 text-slate-300 rounded-xl flex items-center justify-between">
              <span><strong class="text-slate-100">Google Safe Browsing:</strong> Sin incidencias reportadas.</span>
              <span class="text-xs font-mono text-emerald-400 bg-emerald-950/40 px-2 py-1 rounded border border-emerald-800/50">Limpio</span>
            </li>`;
        }

        // 2. PhishTank
        if (pt.listed) {
          listMarkup += `
            <li class="p-3 bg-slate-950/80 border border-slate-800 text-slate-200 rounded-xl flex items-center justify-between">
              <span><strong class="text-amber-400">PhishTank:</strong> Registrado en bases de datos de fraude.</span>
              <span class="text-xs font-mono text-amber-400 bg-amber-950/40 px-2 py-1 rounded border border-amber-800/50">Listado</span>
            </li>`;
          remediationMarkup += `
            <div class="p-4 bg-slate-900 rounded-xl border border-slate-800 space-y-3 font-sans shadow-lg">
              <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <span class="font-mono text-slate-200 font-bold text-sm">Remediación: PhishTank</span>
                <span class="font-mono text-xs text-amber-400">Fraude Activo</span>
              </div>
              <p class="text-slate-400 text-xs">El dominio aloja formularios falsos o réplicas de autenticación. Desactive el sitio de inmediato y envíe evidencia de resolución a PhishTank.</p>
              <div class="pt-2">
                <a href="https://www.phishtank.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-lg text-xs transition-all shadow-md font-mono">
                  Gestionar Deslistado en PhishTank ↗
                </a>
              </div>
            </div>`;
        } else {
          listMarkup += `
            <li class="p-3 bg-slate-950/80 border border-slate-800 text-slate-300 rounded-xl flex items-center justify-between">
              <span><strong class="text-slate-100">PhishTank:</strong> Sin registros de phishing activos.</span>
              <span class="text-xs font-mono text-emerald-400 bg-emerald-950/40 px-2 py-1 rounded border border-emerald-800/50">Limpio</span>
            </li>`;
        }

        // 3. Spamhaus DQS
        if (spamhaus.listed) {
          listMarkup += `
            <li class="p-3 bg-slate-950/80 border border-slate-800 text-slate-200 rounded-xl flex items-center justify-between">
              <span><strong class="text-amber-400">Spamhaus DQS:</strong> IP/Dominio detectado en ZEN / SBL / PBL.</span>
              <span class="text-xs font-mono text-amber-400 bg-amber-950/40 px-2 py-1 rounded border border-amber-800/50">Bloqueado</span>
            </li>`;
          if (spamhaus.diagnostics) {
            spamhaus.diagnostics.forEach((diag: any) => {
              remediationMarkup += `
                <div class="p-4 bg-slate-900 rounded-xl border border-slate-800 space-y-3 font-sans shadow-lg">
                  <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                    <span class="font-mono text-slate-200 font-bold text-sm">Bloqueo Spamhaus: ${diag.info.list}</span>
                    <span class="font-mono text-xs text-slate-400">IP Consulta: ${diag.ip}</span>
                  </div>
                  <p class="text-slate-400 text-xs">${diag.info.desc}</p>
                  <div class="pt-2">
                    <a href="${diag.info.delistUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-lg text-xs transition-all shadow-md font-mono">
                      Solicitar Exclusión en Spamhaus ↗
                    </a>
                  </div>
                </div>`;
            });
          }
        } else {
          listMarkup += `
            <li class="p-3 bg-slate-950/80 border border-slate-800 text-slate-300 rounded-xl flex items-center justify-between">
              <span><strong class="text-slate-100">Spamhaus DQS:</strong> Reputación limpia en ZEN.</span>
              <span class="text-xs font-mono text-emerald-400 bg-emerald-950/40 px-2 py-1 rounded border border-emerald-800/50">Seguro</span>
            </li>`;
        }

        enginesList.innerHTML = listMarkup;
        resultDetails.innerHTML = remediationMarkup ? '<p class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">Guías de Remediación y Deslistado:</p>' + remediationMarkup : '';
        container.classList.remove('hidden');

      } catch (err) {
        enginesList.innerHTML = `<li class="p-3 bg-slate-950 border border-slate-800 text-slate-300 rounded-xl font-mono text-sm text-red-400">Error crítico ejecutando la consulta en el servidor backend.</li>`;
        resultDetails.innerHTML = '';
        container.classList.remove('hidden');
      } finally {
        btn.textContent = 'Ejecutar Auditoría';
        if (attempts <= 3) {
          btn.removeAttribute('disabled');
        }
      }
    });
  </script>
</Layout>