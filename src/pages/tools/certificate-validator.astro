---
// src/pages/tools/certificate-validator.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Validador de Certificados X.509 | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-5xl mx-auto space-y-6">

      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-slate-200/85 hover:bg-slate-300 border border-slate-300 rounded-lg text-slate-800 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <div class="space-y-1.5">
        <h1 class="text-2xl md:text-3xl font-display font-bold text-neutral-900 tracking-wide">
          Validador de Certificados X.509
        </h1>
        <p class="text-neutral-700 font-medium text-base">
          Analiza la validez, vigencia, emisor y propiedades criptográficas de certificados SSL/TLS de forma local y segura.
        </p>
      </div>

      <!-- Tarjeta Principal de Entrada -->
      <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-4">
        <div class="space-y-2">
          <label for="pem-input" class="block text-sm font-bold text-slate-900">
            Certificado PEM (<code class="font-mono text-xs text-blue-800">-----BEGIN CERTIFICATE-----</code>):
          </label>
          <textarea 
            id="pem-input" 
            rows="8" 
            class="w-full bg-white border-2 border-slate-300 rounded-lg p-3 text-neutral-900 font-mono text-xs focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all shadow-xs resize-y"
            placeholder="Pega aquí el contenido en formato PEM de tu certificado .cer o .pem..."
          ></textarea>
        </div>

        <!-- Banner de Error UI Integrado y Limpio -->
        <div id="error-container" class="hidden bg-red-100 border-2 border-red-400 rounded-lg p-4 transition-all">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
            <div class="space-y-1">
              <h3 class="text-xs font-bold text-red-900 uppercase tracking-wider">Error de validación</h3>
              <p id="error-text" class="text-xs text-red-800 font-medium font-sans">
                La entrada no es un certificado válido.
              </p>
            </div>
          </div>
        </div>

        <!-- Botonera de Control -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button 
            type="button"
            id="analyze-btn"
            class="flex-1 bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-4 rounded-lg transition-colors text-sm cursor-pointer shadow-sm text-center"
          >
            Analizar Certificado
          </button>
          
          <button 
            type="button"
            id="reset-btn"
            class="hidden bg-blue-800 hover:bg-blue-900 text-white font-bold py-3 px-6 rounded-lg transition-colors text-sm cursor-pointer shadow-md inline-flex items-center justify-center gap-2"
          >
            <span>🔄</span> Validar otro certificado
          </button>
        </div>
      </div>

      <!-- Contenedor de Resultados -->
      <div id="results-container" class="hidden space-y-6">
        
        <!-- Estado General -->
        <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-4">
          <h2 class="text-lg font-bold text-neutral-900 border-b-2 border-slate-400 pb-2">Diagnóstico y Verificaciones</h2>
          <div id="checks-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs font-mono"></div>
        </div>

        <!-- Sujeto y Emisor -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-3">
            <h3 class="text-sm font-bold text-blue-900 uppercase tracking-wider border-b border-slate-300 pb-2">Sujeto (Subject)</h3>
            <div id="res-subject" class="space-y-1 font-mono text-xs text-neutral-900">-</div>
          </div>
          <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-3">
            <h3 class="text-sm font-bold text-blue-900 uppercase tracking-wider border-b border-slate-300 pb-2">Emisor (Issuer)</h3>
            <div id="res-issuer" class="space-y-1 font-mono text-xs text-neutral-900">-</div>
          </div>
        </div>

        <!-- Vigencia -->
        <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-4">
          <h3 class="text-sm font-bold text-neutral-900 uppercase tracking-wider border-b-2 border-slate-400 pb-2">Validez Temporal</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-4 rounded-lg border-2 border-slate-300 space-y-1 shadow-xs font-mono text-xs">
              <span class="text-neutral-500 block uppercase font-bold text-[10px]">Válido Desde:</span>
              <span id="res-not-before" class="font-bold text-neutral-900">-</span>
            </div>
            <div class="bg-white p-4 rounded-lg border-2 border-slate-300 space-y-1 shadow-xs font-mono text-xs">
              <span class="text-neutral-500 block uppercase font-bold text-[10px]">Válido Hasta:</span>
              <span id="res-not-after" class="font-bold text-neutral-900">-</span>
            </div>
          </div>
        </div>

        <!-- Llave Pública y Firma -->
        <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-3">
          <h3 class="text-sm font-bold text-neutral-900 uppercase tracking-wider border-b-2 border-slate-400 pb-2">Propiedades Criptográficas</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
            <div class="bg-white p-3 rounded-lg border border-slate-300">
              <span class="text-neutral-500 block font-bold text-[10px]">Tamaño de Llave Pública:</span>
              <span id="res-key-size" class="text-blue-800 font-bold text-sm">-</span>
            </div>
            <div class="bg-white p-3 rounded-lg border border-slate-300">
              <span class="text-neutral-500 block font-bold text-[10px]">Algoritmo de Firma:</span>
              <span id="res-sig-algo" class="text-blue-800 font-bold text-sm">-</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>

<script>
  import { parseCertificate, CertificateValidationError } from '../../utils/crypto/cert-parser';

  const pemInput = document.getElementById('pem-input') as HTMLTextAreaElement;
  const analyzeBtn = document.getElementById('analyze-btn');
  const resetBtn = document.getElementById('reset-btn');
  const resultsContainer = document.getElementById('results-container');
  const errorContainer = document.getElementById('error-container');
  const errorText = document.getElementById('error-text');

  const resSubject = document.getElementById('res-subject');
  const resIssuer = document.getElementById('res-issuer');
  const resNotBefore = document.getElementById('res-not-before');
  const resNotAfter = document.getElementById('res-not-after');
  const resKeySize = document.getElementById('res-key-size');
  const resSigAlgo = document.getElementById('res-sig-algo');
  const checksGrid = document.getElementById('checks-grid');

  function showError(msg: string) {
    if (errorText) errorText.textContent = msg;
    if (errorContainer) {
      errorContainer.classList.remove('hidden');
    }
    pemInput?.classList.add('border-red-400', 'ring-2', 'ring-red-500');
    pemInput?.classList.remove('border-slate-300');
    if (resultsContainer) {
      resultsContainer.classList.add('hidden');
    }
  }

  function clearError() {
    if (errorContainer) {
      errorContainer.classList.add('hidden');
    }
    pemInput?.classList.remove('border-red-400', 'ring-2', 'ring-red-500');
    pemInput?.classList.add('border-slate-300');
  }

  resetBtn?.addEventListener('click', () => {
    if (pemInput) pemInput.value = '';
    clearError();
    if (resultsContainer) resultsContainer.classList.add('hidden');
    if (resetBtn) resetBtn.classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    pemInput?.focus();
  });

  analyzeBtn?.addEventListener('click', () => {
    clearError();
    const pemText = pemInput?.value || '';

    try {
      const data = parseCertificate(pemText);

      if (resSubject) {
        resSubject.innerHTML = data.subjectAttributes.length > 0
          ? data.subjectAttributes.map(attr => `<div class="p-1.5 bg-white rounded border border-slate-300 font-mono text-xs">${attr}</div>`).join('')
          : `<span class="text-neutral-700">${data.subject || 'No disponible'}</span>`;
      }

      if (resIssuer) {
        resIssuer.innerHTML = data.issuerAttributes.length > 0
          ? data.issuerAttributes.map(attr => `<div class="p-1.5 bg-white rounded border border-slate-300 font-mono text-xs">${attr}</div>`).join('')
          : `<span class="text-neutral-700">${data.issuer || 'No disponible'}</span>`;
      }

      if (resNotBefore) resNotBefore.textContent = data.notBefore;
      if (resNotAfter) resNotAfter.textContent = data.notAfter;
      if (resKeySize) resKeySize.textContent = `${data.publicKeySize} bits`;
      if (resSigAlgo) resSigAlgo.textContent = data.signatureAlgorithm;

      if (checksGrid) {
        checksGrid.innerHTML = `
          <div class="bg-white p-3 rounded-lg border-2 border-slate-300 shadow-xs flex flex-col justify-between">
            <span class="text-neutral-500 font-bold">Estado de Vigencia:</span>
            <span class="font-bold ${data.isValid ? 'text-emerald-700' : 'text-red-700'}">
              ${data.isValid ? 'Vigente (Válido)' : 'Expirado / No Vigente'}
            </span>
          </div>
          <div class="bg-white p-3 rounded-lg border-2 border-slate-300 shadow-xs flex flex-col justify-between">
            <span class="text-neutral-500 font-bold">Estructura PEM:</span>
            <span class="font-bold text-emerald-700">Verificada OK</span>
          </div>
          <div class="bg-white p-3 rounded-lg border-2 border-slate-300 shadow-xs flex flex-col justify-between">
            <span class="text-neutral-500 font-bold">Procesamiento:</span>
            <span class="font-bold text-blue-700">Local / Seguro</span>
          </div>
          <div class="bg-white p-3 rounded-lg border-2 border-slate-300 shadow-xs flex flex-col justify-between">
            <span class="text-neutral-500 font-bold">Motor Criptográfico:</span>
            <span class="font-bold text-emerald-700">jsrsasign X.509</span>
          </div>
        `;
      }

      if (resultsContainer) {
        resultsContainer.classList.remove('hidden');
        resultsContainer.scrollIntoView({ behavior: 'smooth' });
      }

      if (resetBtn) {
        resetBtn.classList.remove('hidden');
      }

    } catch (error: any) {
      if (error instanceof CertificateValidationError) {
        showError(error.message);
      } else {
        showError('Ocurrió un error inesperado al procesar el certificado.');
      }
    }
  });
</script>