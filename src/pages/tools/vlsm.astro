---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Calculadora VLSM (IPv4) | SysArmor Tech";
const pageDescription = "Optimiza el direccionamiento IP IPv4 de tu infraestructura de red corporativa sin desperdiciar direcciones.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  canonical={canonicalURL}
>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <!-- Botón de retorno a herramientas -->
    <div class="mb-6">
      <button 
        type="button"
        id="back-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-xl text-xs transition-all shadow-md font-mono cursor-pointer"
      >
        ← VOLVER A HERRAMIENTAS
      </button>
    </div>

    <!-- Cuadro de Cabecera Estilizado -->
    <div class="bg-slate-100 border border-slate-200 rounded-2xl p-6 shadow-sm mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <span class="inline-block bg-[#FDE047]/60 border border-[#FACC15] text-slate-900 text-xs font-mono font-bold px-3 py-1 rounded-full w-fit">
          Infraestructura de Red y Enrutamiento
        </span>
        <div class="flex items-center gap-4 text-xs font-mono text-slate-600">
          <span>Actualizado: 22 Sept, 2026</span>
          <span>Versión: 1.2.0</span>
        </div>
      </div>
      <hr class="border-slate-300 mb-6" />
      <div class="text-center">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 font-mono mb-2">Calculadora VLSM (IPv4)</h1>
        <p class="text-slate-600 text-sm max-w-2xl mx-auto font-medium">
          Optimiza el direccionamiento IP IPv4 de tu infraestructura de red corporativa sin desperdiciar direcciones.
        </p>
      </div>
    </div>

    <!-- Contenedor Principal de la Calculadora -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl text-slate-200 mb-8">
      <div class="space-y-6">
        
        <!-- Indicador de Pasos -->
        <div class="flex items-center justify-between bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs font-bold font-mono">
          <span id="step-badge-1" class="px-3 py-1 rounded-lg bg-[#D4AF37] text-slate-950 transition-all">Paso 1: Red Base</span>
          <span id="step-badge-2" class="px-3 py-1 rounded-lg text-slate-400 transition-all">Paso 2: Subredes</span>
          <span id="step-badge-3" class="px-3 py-1 rounded-lg text-slate-400 transition-all">Paso 3: Resultados</span>
        </div>

        <div id="error-box" class="hidden bg-red-950/50 border border-red-900/50 text-red-300 p-3 rounded-xl text-xs font-semibold font-mono shadow-inner"></div>

        <!-- PASO 1 -->
        <div id="step-1-container" class="space-y-4">
          <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-4 shadow-inner">
            <h3 class="text-xs font-mono font-bold text-slate-300 uppercase tracking-wider">Asistente IPv4 - Red Principal</h3>
            <div class="space-y-1">
              <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">Bloque IPv4 CIDR Base</label>
              <input
                type="text"
                id="base-ip-input"
                value="192.168.1.0/24"
                class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] transition-all font-mono"
              />
            </div>
            <button
              type="button"
              id="btn-next-1"
              class="w-full bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold py-3 rounded-xl text-sm cursor-pointer transition-all shadow-md font-mono"
            >
              Siguiente: Agregar Requerimientos &rarr;
            </button>
          </div>
        </div>

        <!-- PASO 2 -->
        <div id="step-2-container" class="hidden space-y-6">
          <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 space-y-4 shadow-inner">
            <h3 class="text-xs font-mono font-bold text-slate-300 uppercase tracking-wider">Añadir Subred o Departamento</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">Nombre de la Red</label>
                <input
                  type="text"
                  id="net-name-input"
                  placeholder="Ej: VLAN-Gerencia"
                  class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] transition-all font-mono"
                />
              </div>
              <div>
                <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-2">Hosts Máximos Necesarios</label>
                <input
                  type="number"
                  id="hosts-input"
                  min="1"
                  value="30"
                  class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-500 text-sm focus:outline-none focus:border-[#D4AF37] transition-all font-mono"
                />
              </div>
            </div>
            <button
              type="button"
              id="btn-add-req"
              class="w-full bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold py-3 rounded-xl text-sm cursor-pointer transition-all shadow-md font-mono"
            >
              Añadir a la lista VLSM
            </button>
          </div>

          <div class="space-y-3">
            <h4 id="requirements-title" class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono">Subredes Planificadas (0)</h4>
            <div id="requirements-list" class="space-y-2">
              <p class="text-xs text-slate-500 italic font-mono">No hay subredes configuradas en este asistente.</p>
            </div>
          </div>

          <div class="flex gap-3">
            <button
              type="button"
              id="btn-back-1"
              class="w-1/3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold py-3 rounded-xl text-sm cursor-pointer transition-all font-mono"
            >
              &larr; Volver
            </button>
            <button
              type="button"
              id="btn-calculate"
              class="hidden w-2/3 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold py-3 rounded-xl text-sm cursor-pointer shadow-md transition-all font-mono"
            >
              Calcular Distribución IPv4 VLSM
            </button>
          </div>
        </div>

        <!-- PASO 3 -->
        <div id="step-3-container" class="hidden space-y-6">
          <div class="bg-slate-950 border border-slate-800 p-4 rounded-xl text-sm text-slate-200 flex justify-between items-center shadow-inner font-mono">
            <h4 class="font-bold text-emerald-400">Cálculo IPv4 Exitoso</h4>
            <span id="results-count" class="text-xs font-semibold text-slate-400">0 subredes generadas</span>
          </div>

          <div id="results-list" class="space-y-4"></div>

          <button
            type="button"
            id="btn-restart"
            class="w-full bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold py-3 rounded-xl text-sm cursor-pointer transition-all shadow-md font-mono"
          >
            Reiniciar Asistente IPv4
          </button>
        </div>

      </div>
    </div>

    <!-- Bloque de Contenido Técnico y Semántico para SEO -->
    <article class="mt-12 bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 text-slate-200 font-sans text-sm leading-relaxed shadow-xl">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg font-bold font-mono text-slate-100 flex items-center gap-2">
          <span class="text-[#D4AF37]">#</span> Guía Técnica: Optimización de Subredes con VLSM (Variable Length Subnet Mask)
        </h2>
        <p class="text-xs text-slate-400 font-mono mt-1">Mejores prácticas en diseño jerárquico de redes y mitigación de desperdicio de direcciones IP.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[#D4AF37]">Fundamentos de VLSM</h3>
          <p class="text-slate-300">
            La Máscara de Subred de Longitud Variable (<strong class="text-slate-100">VLSM</strong>) permite seccionar un bloque principal de red en subredes de tamaños totalmente adaptados a las necesidades reales de hosts en cada segmento, maximizando la eficiencia del espacio de direcciones IPv4.
          </p>
          <ul class="list-disc pl-5 space-y-1 text-xs text-slate-300">
            <li><strong class="text-slate-100">Ordenamiento Descendente:</strong> El algoritmo procesa primero las subredes con mayor demanda de hosts para evitar solapamientos y fragmentación del bloque base.</li>
            <li><strong class="text-slate-100">Cálculo de Bits de Host:</strong> Determina la potencia de 2 necesaria sumando siempre 2 direcciones reservadas (<span class="text-amber-400 font-mono">Red y Broadcast</span>).</li>
            <li><strong class="text-slate-100">Agregación de Rutas:</strong> Facilita la sumarización en entornos de encaminamiento avanzados como BGP u OSPF.</li>
          </ul>
        </div>

        <div class="space-y-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[#D4AF37]">Criterios de Arquitectura Corporativa</h3>
          <p class="text-slate-300">
            Una planeación robusta de direccionamiento previene cuellos de botella y facilita la administración de seguridad perimetral:
          </p>
          <ol class="list-decimal pl-5 space-y-1 text-xs text-slate-300">
            <li><strong class="text-slate-100">Margen de Crecimiento:</strong> Asigna siempre un porcentaje adicional de hosts utilizables para contemplar expansiones futuras de VLANs y dispositivos de infraestructura.</li>
            <li><strong class="text-slate-100">Segmentación por Zonas:</strong> Separa lógicamente servidores críticos, estaciones de trabajo de usuarios y redes invitadas mediante VLANs independientes.</li>
            <li><strong class="text-slate-100">Control de Broadcast:</strong> Limita el tamaño de los dominios de difusión para optimizar el rendimiento de la red a nivel de capa de enlace.</li>
          </ol>
        </div>
      </div>
    </article>
  </section>

  <!-- Script Nativo de Control e Interacción -->
  <script>
    interface Requirement {
      id: string;
      name: string;
      hostsNeeded: number;
    }

    let requirements: Requirement[] = [];
    let currentStep = 1;

    const ipToInt = (ip: string) => ip.split('.').reduce((acc, octet) => ((acc << 8) + parseInt(octet, 10)) >>> 0, 0);
    const intToIp = (int: number) => [
      (int >>> 24) & 255,
      (int >>> 16) & 255,
      (int >>> 8) & 255,
      int & 255
    ].join('.');

    const showError = (msg: string | null) => {
      const box = document.getElementById('error-box');
      if (!box) return;
      if (!msg) {
        box.classList.add('hidden');
        box.textContent = '';
      } else {
        box.textContent = msg;
        box.classList.remove('hidden');
      }
    };

    const updateView = () => {
      document.getElementById('step-1-container')?.classList.toggle('hidden', currentStep !== 1);
      document.getElementById('step-2-container')?.classList.toggle('hidden', currentStep !== 2);
      document.getElementById('step-3-container')?.classList.toggle('hidden', currentStep !== 3);

      const b1 = document.getElementById('step-badge-1');
      const b2 = document.getElementById('step-badge-2');
      const b3 = document.getElementById('step-badge-3');

      if (b1) b1.className = `px-3 py-1 rounded-lg font-mono transition-all ${currentStep === 1 ? 'bg-[#D4AF37] text-slate-950 shadow-md font-bold' : 'text-slate-400 bg-transparent'}`;
      if (b2) b2.className = `px-3 py-1 rounded-lg font-mono transition-all ${currentStep === 2 ? 'bg-[#D4AF37] text-slate-950 shadow-md font-bold' : 'text-slate-400 bg-transparent'}`;
      if (b3) b3.className = `px-3 py-1 rounded-lg font-mono transition-all ${currentStep === 3 ? 'bg-emerald-600 text-slate-950 shadow-md font-bold' : 'text-slate-400 bg-transparent'}`;
    };

    const renderRequirements = () => {
      const listEl = document.getElementById('requirements-list');
      const titleEl = document.getElementById('requirements-title');
      const btnCalc = document.getElementById('btn-calculate');
      if (!listEl || !titleEl || !btnCalc) return;

      titleEl.textContent = `Subredes Planificadas (${requirements.length})`;
      btnCalc.classList.toggle('hidden', requirements.length === 0);

      if (requirements.length === 0) {
        listEl.innerHTML = `<p class="text-xs text-slate-500 italic font-mono">No hay subredes configuradas en este asistente.</p>`;
        return;
      }

      listEl.innerHTML = requirements.map(req => `
        <div class="flex justify-between items-center bg-slate-950 border border-slate-800 px-4 py-3 rounded-xl shadow-inner font-mono">
          <span class="text-sm">
            <strong class="text-slate-100">${req.name}</strong> <span class="text-slate-400 text-xs">(${req.hostsNeeded} hosts requeridos)</span>
          </span>
          <button
            type="button"
            data-id="${req.id}"
            class="delete-req-btn text-red-400 hover:text-red-300 px-3 py-1.5 bg-red-950/40 hover:bg-red-900/50 border border-red-900/50 rounded-lg cursor-pointer transition-all text-xs font-bold"
          >
            Eliminar
          </button>
        </div>
      `).join('');

      document.querySelectorAll('.delete-req-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          requirements = requirements.filter(r => r.id !== id);
          renderRequirements();
        });
      });
    };

    // Manejar el botón de regreso de forma segura
    const backBtn = document.getElementById('back-btn');
    backBtn?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/tools';
      }
    });

    // Eventos de Navegación
    document.getElementById('btn-next-1')?.addEventListener('click', () => {
      const baseIp = (document.getElementById('base-ip-input') as HTMLInputElement)?.value.trim();
      if (!baseIp || !baseIp.includes('/')) {
        showError('La red base debe incluir notación CIDR (ej: 192.168.1.0/24).');
        return;
      }
      showError(null);
      currentStep = 2;
      updateView();
    });

    document.getElementById('btn-back-1')?.addEventListener('click', () => {
      showError(null);
      currentStep = 1;
      updateView();
    });

    document.getElementById('btn-add-req')?.addEventListener('click', () => {
      showError(null);
      const nameInput = document.getElementById('net-name-input') as HTMLInputElement;
      const hostsInput = document.getElementById('hosts-input') as HTMLInputElement;
      
      const name = nameInput?.value.trim();
      const hosts = parseInt(hostsInput?.value || '0', 10);

      if (!name || isNaN(hosts) || hosts <= 0) {
        showError('Ingresa un nombre de red válido y una cantidad de hosts mayor a 0.');
        return;
      }

      requirements.push({
        id: Math.random().toString(36).substring(2, 9),
        name,
        hostsNeeded: hosts
      });

      nameInput.value = '';
      hostsInput.value = '30';
      renderRequirements();
    });

    document.getElementById('btn-calculate')?.addEventListener('click', () => {
      showError(null);
      const baseIp = (document.getElementById('base-ip-input') as HTMLInputElement)?.value.trim();
      if (!baseIp || !baseIp.includes('/')) {
        showError('La red base es inválida.');
        return;
      }

      try {
        const [cleanIp] = baseIp.split('/');
        let currentIpInt = ipToInt(cleanIp);
        const sorted = [...requirements].sort((a, b) => b.hostsNeeded - a.hostsNeeded);

        const results = sorted.map(req => {
          const totalHostsNeeded = req.hostsNeeded + 2;
          const hostBits = Math.ceil(Math.log2(totalHostsNeeded));
          const cidrBits = 32 - hostBits;
          const blockSize = Math.pow(2, hostBits);
          
          const networkAddress = intToIp(currentIpInt);
          const broadcastInt = currentIpInt + blockSize - 1;
          const broadcastAddress = intToIp(broadcastInt);
          
          const usableStart = intToIp(currentIpInt + 1);
          const usableEnd = intToIp(broadcastInt - 1);
          
          const maskInt = (0xFFFFFFFF << hostBits) >>> 0;
          const subnetMask = intToIp(maskInt);

          const resObj = {
            name: req.name,
            networkAddress,
            cidr: `/${cidrBits}`,
            subnetMask,
            usableRange: req.hostsNeeded === 1 ? `${usableStart} - ${usableStart}` : `${usableStart} - ${usableEnd}`,
            broadcastAddress,
            hostsRequested: req.hostsNeeded,
            hostsAllocated: blockSize - 2
          };

          currentIpInt += blockSize;
          return resObj;
        });

        // Renderizar Resultados
        const resultsList = document.getElementById('results-list');
        const resultsCount = document.getElementById('results-count');
        if (resultsCount) resultsCount.textContent = `${results.length} subredes generadas`;
        if (resultsList) {
          resultsList.innerHTML = results.map(res => `
            <div class="bg-slate-950 border border-slate-800 rounded-xl overflow-hidden shadow-inner">
              <div class="bg-slate-900 px-4 py-3 border-b border-slate-800">
                <span class="font-bold text-sm text-slate-100 font-mono">Subred: ${res.name}</span>
              </div>
              <table class="w-full text-left border-collapse text-xs font-mono">
                <tbody>
                  <tr class="border-b border-slate-800">
                    <td class="p-3 font-semibold text-right text-slate-400 bg-slate-950 border-r border-slate-800 w-1/3">Network CIDR:</td>
                    <td class="p-3 text-amber-400">${res.networkAddress}${res.cidr}</td>
                  </tr>
                  <tr class="border-b border-slate-800">
                    <td class="p-3 font-semibold text-right text-slate-400 bg-slate-950 border-r border-slate-800">Subnet Mask:</td>
                    <td class="p-3 text-slate-200">${res.subnetMask}</td>
                  </tr>
                  <tr class="border-b border-slate-800">
                    <td class="p-3 font-semibold text-right text-slate-400 bg-slate-950 border-r border-slate-800">Usable Range:</td>
                    <td class="p-3 text-emerald-400 break-all">${res.usableRange}</td>
                  </tr>
                  <tr class="border-b border-slate-800">
                    <td class="p-3 font-semibold text-right text-slate-400 bg-slate-950 border-r border-slate-800">Broadcast:</td>
                    <td class="p-3 text-slate-200">${res.broadcastAddress}</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-right text-slate-400 bg-slate-950 border-r border-slate-800">Hosts (Req/Alloc):</td>
                    <td class="p-3 text-slate-200">${res.hostsRequested} / ${res.hostsAllocated}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          `).join('');
        }

        currentStep = 3;
        updateView();
      } catch (err: any) {
        showError('Ocurrió un error al calcular las subredes: ' + (err.message || 'Error desconocido'));
      }
    });

    document.getElementById('btn-restart')?.addEventListener('click', () => {
      requirements = [];
      currentStep = 1;
      showError(null);
      renderRequirements();
      updateView();
    });
  </script>
</Layout>