---
// src/pages/tools/ipv6-cidr.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Calculadora CIDR IPv6 | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-200 border-t border-slate-300 text-slate-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Navegación de retorno -->
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-sm"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <!-- Encabezado -->
      <div class="space-y-2 text-center max-w-2xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-slate-950 tracking-wide uppercase">
          Calculadora CIDR IPv6
        </h1>
        <p class="text-slate-700 font-medium text-base">
          Analiza prefijos IPv6, calcula la compresión de direcciones, rangos globales y capacidad de subredes.
        </p>
      </div>

      <!-- Tarjeta de Entrada -->
      <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl space-y-6">
        <div class="space-y-2">
          <label for="ipv6Input" class="block text-sm font-bold text-slate-300 uppercase tracking-wide">
            Prefijo IPv6 o Dirección con CIDR
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="text" 
              id="ipv6Input" 
              placeholder="Ej: 2001:db8::/32 o fe80::1/64" 
              class="flex-1 bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white font-mono text-base focus:outline-none focus:border-amber-500 shadow-inner placeholder-slate-500"
            />
            <button 
              id="calculateBtn"
              class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-6 py-3 rounded-xl transition-colors shadow-sm cursor-pointer"
            >
              Calcular Prefijo
            </button>
          </div>
          <p id="errorMsg" class="text-red-400 text-xs font-bold hidden"></p>
        </div>
      </div>

      <!-- Resultados (Ocultos al iniciar) -->
      <div id="resultsContainer" class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl space-y-6 hidden">
        <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-3">
          Detalles del Bloque IPv6
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Prefijo Ingresado</span>
            <p id="resPrefix" class="font-mono font-bold text-white text-base break-all">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Longitud de Prefijo (Prefix Length)</span>
            <p id="resPrefixLen" class="font-mono font-bold text-amber-400 text-base">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Dirección de Red (Comprimida)</span>
            <p id="resCompressed" class="font-mono font-bold text-amber-400 text-base break-all">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Dirección de Red (Expandida)</span>
            <p id="resExpanded" class="font-mono font-bold text-slate-300 text-xs break-all">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Primera Dirección IP</span>
            <p id="resFirstIP" class="font-mono font-bold text-emerald-400 text-base break-all">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Última Dirección IP</span>
            <p id="resLastIP" class="font-mono font-bold text-emerald-400 text-base break-all">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total de Direcciones IP</span>
            <p id="resTotalIPs" class="font-mono font-bold text-white text-base">-</p>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-1 shadow-inner">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Tipo de Dirección</span>
            <p id="resAddressType" class="font-mono font-bold text-purple-400 text-base">-</p>
          </div>

        </div>
      </div>

    </div>
  </main>

  <script>
    function parseIPv6(ipStr: string) {
      ipStr = ipStr.trim();
      if (!ipStr) throw new Error("Por favor, ingresa un prefijo IPv6 o dirección CIDR.");
      
      let parts = ipStr.split('/');
      let addrPart = parts[0];
      let prefixLen = parts.length > 1 ? parseInt(parts[1], 10) : 128;

      if (isNaN(prefixLen) || prefixLen < 0 || prefixLen > 128) {
        throw new Error("Longitud de prefijo inválida (debe estar entre 0 y 128).");
      }

      let dualColons = addrPart.split('::');
      if (dualColons.length > 2) throw new Error("Formato IPv6 inválido: múltiples '::'.");

      let hextets: number[] = [];
      if (dualColons.length === 2) {
        let left = dualColons[0] ? dualColons[0].split(':') : [];
        let right = dualColons[1] ? dualColons[1].split(':') : [];
        let missing = 8 - (left.length + right.length);
        
        let middle = new Array(missing).fill('0');
        let fullArr = [...left, ...middle, ...right];
        if (fullArr.length !== 8) throw new Error("Formato IPv6 comprimido inválido.");
        hextets = fullArr.map(h => h === '' ? 0 : parseInt(h || '0', 16));
      } else {
        let splitted = addrPart.split(':');
        if (splitted.length !== 8) throw new Error("Una dirección IPv6 completa debe tener 8 bloques (hextetos).");
        hextets = splitted.map(h => parseInt(h || '0', 16));
      }

      for (let h of hextets) {
        if (isNaN(h) || h < 0 || h > 0xFFFF) throw new Error("Hexteto IPv6 fuera de rango (0x0 - 0xFFFF).");
      }

      return { hextets, prefixLen };
    }

    function hextetsToBigInt(hextets: number[]) {
      let res = 0n;
      for (let h of hextets) {
        res = (res << 16n) + BigInt(h);
      }
      return res;
    }

    function bigIntToHextets(bigIntVal: bigint) {
      let hexStr = bigIntVal.toString(16).padStart(32, '0');
      let hextets = [];
      for (let i = 0; i < 32; i += 4) {
        hextets.push(parseInt(hexStr.substring(i, i + 4), 16));
      }
      return hextets;
    }

    function compressIPv6(hextets: number[]) {
      let hexStrs = hextets.map(h => h.toString(16));
      
      let maxZeroStart = -1;
      let maxZeroLen = 0;
      let currentZeroStart = -1;
      let currentZeroLen = 0;

      for (let i = 0; i < 8; i++) {
        if (hextets[i] === 0) {
          if (currentZeroStart === -1) currentZeroStart = i;
          currentZeroLen++;
          if (currentZeroLen > maxZeroLen) {
            maxZeroLen = currentZeroLen;
            maxZeroStart = currentZeroStart;
          }
        } else {
          currentZeroStart = -1;
          currentZeroLen = 0;
        }
      }

      if (maxZeroLen > 1) {
        let left = hexStrs.slice(0, maxZeroStart);
        let right = hexStrs.slice(maxZeroStart + maxZeroLen);
        let res = "";
        if (left.length > 0) res += left.join(':');
        res += '::';
        if (right.length > 0) res += right.join(':');
        return res === '::' ? '::' : res.replace(/:::+/g, '::');
      }

      return hexStrs.join(':');
    }

    function expandIPv6(hextets: number[]) {
      return hextets.map(h => h.toString(16).padStart(4, '0')).join(':');
    }

    function getAddressType(hextets: number[]) {
      let firstHextet = hextets[0];
      if ((firstHextet & 0xFE00) === 0xFC00) return "ULA (Unique Local Address)";
      if ((firstHextet & 0xFFC0) === 0xFE80) return "Link-Local";
      if (firstHextet === 0 && hextets.slice(1, 7).every(h => h === 0)) {
        if (hextets[7] === 1) return "Loopback (::1)";
        if (hextets[7] === 0) return "Unspecified (::)";
      }
      if ((firstHextet & 0xFF00) === 0xFF00) return "Multicast";
      if ((firstHextet & 0xE000) === 0x2000 || (firstHextet & 0xE000) === 0x3000) return "Global Unicast";
      return "Especial / Reservada";
    }

    function calculate() {
      const inputElement = document.getElementById('ipv6Input') as HTMLInputElement;
      const errorMsg = document.getElementById('errorMsg') as HTMLElement;
      const resultsContainer = document.getElementById('resultsContainer') as HTMLElement;
      
      if (!inputElement || !errorMsg || !resultsContainer) return;

      const inputVal = inputElement.value;
      
      try {
        errorMsg.classList.add('hidden');
        let { hextets, prefixLen } = parseIPv6(inputVal);

        let ipBigInt = hextetsToBigInt(hextets);
        
        let maskBigInt = prefixLen === 0 ? 0n : ((1n << 128n) - 1n) ^ ((1n << (128n - BigInt(prefixLen))) - 1n);
        
        let netBigInt = ipBigInt & maskBigInt;
        let wildBigInt = (1n << (128n - BigInt(prefixLen))) - 1n;
        let broadcastBigInt = netBigInt | wildBigInt;

        let netHextets = bigIntToHextets(netBigInt);
        let firstHextets = bigIntToHextets(netBigInt);
        let lastHextets = bigIntToHextets(broadcastBigInt);

        let totalIPs = prefixLen === 128 ? 1n : 1n << (128n - BigInt(prefixLen));

        const setElementText = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.innerText = text;
        };

        setElementText('resPrefix', inputVal);
        setElementText('resPrefixLen', `/${prefixLen}`);
        setElementText('resCompressed', compressIPv6(netHextets) + `/${prefixLen}`);
        setElementText('resExpanded', expandIPv6(netHextets));
        setElementText('resFirstIP', compressIPv6(firstHextets));
        setElementText('resLastIP', compressIPv6(lastHextets));
        setElementText('resTotalIPs', totalIPs.toLocaleString('es-ES'));
        setElementText('resAddressType', getAddressType(netHextets));

        resultsContainer.classList.remove('hidden');

      } catch (err: any) {
        errorMsg.innerText = err.message;
        errorMsg.classList.remove('hidden');
        resultsContainer.classList.add('hidden');
      }
    }

    document.getElementById('calculateBtn')?.addEventListener('click', calculate);
    document.getElementById('ipv6Input')?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') calculate();
    });
  </script>
</Layout>