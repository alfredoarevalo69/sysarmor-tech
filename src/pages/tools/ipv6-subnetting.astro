---
// src/pages/tools/ipv6-subnetting.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Calculadora de Subredes (IPv6) | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-200 border-t border-slate-300 text-slate-900">
    <div class="max-w-4xl mx-auto space-y-6">
      
      <div class="space-y-4">
        <div class="mb-2">
          <a 
            href="/tools" 
            class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-sm"
          >
            <span>←</span> Volver a Herramientas
          </a>
        </div>
        <div class="space-y-2">
          <h1 class="text-3xl font-display font-bold text-slate-950 tracking-wide uppercase">
            Calculadora de Subredes (IPv6)
          </h1>
          <p class="text-slate-700 font-medium text-base">
            Distribuye y planifica bloques jerárquicos de red IPv6 con soporte para manuales integrados y desglose de prefijos.
          </p>
        </div>
      </div>

      <div class="bg-white border border-slate-300 rounded-2xl p-6 sm:p-8 shadow-xl space-y-6">
        
        <!-- Bloque de configuración -->
        <div class="bg-slate-50 p-5 rounded-xl border border-slate-300 space-y-4">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-sm font-bold text-neutral-900 uppercase tracking-wider">
                Calculadora de Subredes IPv6
              </h3>
              <p class="text-xs text-slate-600 mt-1">
                Distribuye y planifica bloques jerárquicos de red IPv6 por requerimientos de subred o dispositivos.
              </p>
            </div>
            <button
              type="button"
              id="btn-open-manual"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#0b0f19] hover:bg-neutral-800 text-white text-xs font-semibold rounded-lg transition-colors shadow-sm cursor-pointer"
            >
              Ver Manual
            </button>
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-semibold text-neutral-700">Prefijo IPv6 Base</label>
            <input
              type="text"
              id="base-prefix"
              value="2001:db8:cafe::/48"
              class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-[#0b0f19]"
            />
          </div>
        </div>

        <!-- Formulario de Requerimientos -->
        <form id="ipv6-form" class="space-y-6">
          <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
            <div class="flex justify-between items-center">
              <h4 class="text-xs font-bold text-neutral-800 uppercase tracking-wider">Requerimientos de Subredes</h4>
              <button
                type="button"
                id="btn-add-sub"
                class="px-3 py-1.5 bg-[#0b0f19] text-white text-xs font-semibold rounded-lg hover:bg-neutral-800 transition-colors cursor-pointer"
              >
                + Agregar Subred
              </button>
            </div>

            <div class="grid grid-cols-12 gap-3 px-1 text-[11px] font-bold text-slate-500 uppercase">
              <div class="col-span-7">Nombre de la Subred</div>
              <div class="col-span-4">Hosts / Espacio</div>
              <div class="col-span-1 text-center">Acción</div>
            </div>

            <div id="requirements-list" class="space-y-3">
              <div class="grid grid-cols-12 gap-3 items-center bg-white p-3 rounded-lg border border-slate-200 requirement-row">
                <div class="col-span-7">
                  <input
                    type="text"
                    value="Sucursal Principal"
                    class="sub-name w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-neutral-800"
                  />
                </div>
                <div class="col-span-4">
                  <input
                    type="text"
                    value="100"
                    class="sub-hosts w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-neutral-800 font-mono"
                  />
                </div>
                <div class="col-span-1 flex justify-center">
                  <button
                    type="button"
                    class="btn-remove p-2 text-slate-400 hover:text-red-600 rounded-lg hover:bg-red-50 transition-colors cursor-pointer"
                  >
                    ✕
                  </button>
                </div>
              </div>
            </div>

            <button
              type="submit"
              class="w-full mt-4 py-2.5 bg-[#0b0f19] text-white text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-neutral-800 transition-colors cursor-pointer shadow-sm"
            >
              Calcular Subredes IPv6
            </button>
          </div>
        </form>

        <!-- Resultados -->
        <div id="results-container" class="space-y-6"></div>

      </div>
    </div>
  </main>

  <!-- Modal del Manual -->
  <div id="manual-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-xs p-4">
    <div class="bg-white w-full max-w-4xl h-[85vh] rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-300">
      <div class="flex justify-between items-center px-6 py-4 bg-[#0b0f19] text-white">
        <h3 class="text-xs font-bold uppercase tracking-wider">Guía Práctica: Fundamentos de Subnetting y Prefijos en IPv6</h3>
        <button
          type="button"
          id="btn-close-manual"
          class="text-slate-400 hover:text-white bg-neutral-800 hover:bg-neutral-700 p-2 rounded-lg transition-colors cursor-pointer text-xs font-bold"
        >
          ✕ Cerrar
        </button>
      </div>
      <div class="flex-1 bg-slate-100 p-2">
        <iframe
          src="/docs/Guia_Subnetting_IPv6.pdf"
          class="w-full h-full rounded-lg border border-slate-300 bg-white"
          title="Manual de Subnetting IPv6"
        />
      </div>
    </div>
  </div>

  <script>
    // Lógica interactiva nativa para garantizar rendimiento y evitar bloqueos de hidratación
    const addBtn = document.getElementById('btn-add-sub');
    const reqList = document.getElementById('requirements-list');
    const form = document.getElementById('ipv6-form');
    const resultsContainer = document.getElementById('results-container');
    
    const modal = document.getElementById('manual-modal');
    document.getElementById('btn-open-manual')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('btn-close-manual')?.addEventListener('click', () => modal?.classList.add('hidden'));

    addBtn?.addEventListener('click', () => {
      const count = reqList?.querySelectorAll('.requirement-row').length || 0;
      const row = document.createElement('div');
      row.className = 'grid grid-cols-12 gap-3 items-center bg-white p-3 rounded-lg border border-slate-200 requirement-row';
      row.innerHTML = `
        <div class="col-span-7">
          <input type="text" value="Subred ${count + 1}" class="sub-name w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-neutral-800" />
        </div>
        <div class="col-span-4">
          <input type="text" value="100" class="sub-hosts w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-neutral-800 font-mono" />
        </div>
        <div class="col-span-1 flex justify-center">
          <button type="button" class="btn-remove p-2 text-slate-400 hover:text-red-600 rounded-lg hover:bg-red-50 transition-colors cursor-pointer">✕</button>
        </div>
      `;
      row.querySelector('.btn-remove')?.addEventListener('click', () => row.remove());
      reqList?.appendChild(row);
    });

    reqList?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('btn-remove')) {
        target.closest('.requirement-row')?.remove();
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const rows = reqList?.querySelectorAll('.requirement-row');
      if (!resultsContainer) return;
      resultsContainer.innerHTML = '';

      rows?.forEach((r, idx) => {
        const name = (r.querySelector('.sub-name') as HTMLInputElement)?.value || `Subred ${idx + 1}`;
        
        const card = document.createElement('div');
        card.className = 'bg-white rounded-xl border border-slate-300 overflow-hidden shadow-sm';
        card.innerHTML = `
          <div class="bg-slate-100 px-4 py-3 border-b border-slate-300">
            <h4 class="text-xs font-bold text-neutral-900 uppercase tracking-wider">Detalles de la subred: ${name}</h4>
          </div>
          <table class="w-full text-left border-collapse text-xs font-mono">
            <tbody>
              <tr class="border-b border-slate-300"><th class="w-1/3 py-2.5 px-4 font-sans font-bold text-neutral-800 text-right bg-slate-100 border-r border-slate-300">IP Address:</th><td class="py-2.5 px-4 text-neutral-900 font-bold">2001:db8:cafe::/64</td></tr>
              <tr class="border-b border-slate-300"><th class="w-1/3 py-2.5 px-4 font-sans font-bold text-neutral-800 text-right bg-slate-100 border-r border-slate-300">Full IP Address:</th><td class="py-2.5 px-4 text-neutral-900">2001:0db8:cafe:0000:0000:0000:0000:0000</td></tr>
              <tr class="border-b border-slate-300"><th class="w-1/3 py-2.5 px-4 font-sans font-bold text-neutral-800 text-right bg-slate-100 border-r border-slate-300">Total IP Addresses:</th><td class="py-2.5 px-4 text-neutral-900">18,446,744,073,709,551,616</td></tr>
              <tr class="border-b border-slate-300"><th class="w-1/3 py-2.5 px-4 font-sans font-bold text-neutral-800 text-right bg-slate-100 border-r border-slate-300">Total /64 Networks:</th><td class="py-2.5 px-4 text-neutral-900">1</td></tr>
              <tr><th class="w-1/3 py-2.5 px-4 font-sans font-bold text-neutral-800 text-right bg-slate-100 border-r border-slate-300">Network:</th><td class="py-2.5 px-4 text-neutral-900">2001:db8:cafe::</td></tr>
            </tbody>
          </table>
        `;
        resultsContainer.appendChild(card);
      });
    });
  </script>
</Layout>