---
// src/pages/tools/whois.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Buscador WHOIS de Dominios | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-neutral-100 border-t border-neutral-300 text-neutral-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-slate-200/80 hover:bg-slate-300 border border-slate-300 rounded-lg text-slate-800 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <div class="space-y-2 text-center">
        <h1 class="text-3xl font-display font-bold text-neutral-900 tracking-wide">
          Buscador WHOIS de Dominios
        </h1>
        <p class="text-neutral-700 font-medium text-sm">
          Consulta registros detallados de dominios globales y ccTLDs, contactos, fechas y servidores de nombres.
        </p>
      </div>

      <div class="bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-4">
        <form id="whois-form" class="flex flex-col sm:flex-row gap-3">
          <input 
            type="text" 
            id="domain-input" 
            placeholder="ej. sysarmortech.com o mintic.gov.co" 
            required
            class="flex-1 bg-white border-2 border-slate-300 rounded-lg px-4 py-2.5 text-neutral-900 font-medium focus:outline-none focus:border-blue-700 text-sm"
          />
          <button 
            type="submit" 
            id="submit-btn"
            class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-2.5 rounded-lg transition-colors text-sm shadow-sm cursor-pointer"
          >
            Consultar WHOIS
          </button>
        </form>
      </div>

      <div id="result-container" class="hidden bg-slate-200/70 border-2 border-slate-400 rounded-xl p-6 shadow-xl space-y-4">
        <h2 class="text-lg font-bold text-neutral-900 border-b-2 border-slate-300 pb-2">Resultados de la Consulta</h2>
        <div id="result-content" class="overflow-x-auto"></div>
      </div>

    </div>
  </main>

  <script>
    const form = document.getElementById('whois-form') as HTMLFormElement;
    const input = document.getElementById('domain-input') as HTMLInputElement;
    const container = document.getElementById('result-container') as HTMLDivElement;
    const resultContent = document.getElementById('result-content') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    const renderTable = (rows: [string, any][]) => {
      let tableHtml = `<table class="w-full text-left border-collapse bg-white rounded-lg overflow-hidden border-2 border-slate-300 text-xs sm:text-sm font-mono shadow-sm"><tbody>`;
      rows.forEach(([key, value], index) => {
        const bgClass = index % 2 === 0 ? 'bg-white' : 'bg-slate-50';
        tableHtml += `
          <tr class="${bgClass} border-b border-slate-200">
            <td class="p-3 font-bold text-neutral-700 w-1/3 border-r border-slate-200 capitalize">${key.replace(/([A-Z])/g, ' $1').trim()}</td>
            <td class="p-3 text-neutral-900 w-2/3 break-all">${value}</td>
          </tr>
        `;
      });
      tableHtml += `</tbody></table>`;
      return tableHtml;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = input.value.trim();
      if (!domain) return;

      btn.textContent = 'Consultando...';
      btn.setAttribute('disabled', 'true');
      container.classList.add('hidden');

      try {
        const response = await fetch(`/api/whois?domain=${encodeURIComponent(domain)}`);
        const result = await response.json();

        if (result.success) {
          const data = result.data;
          
          if (data && data.status && ['NOT_FOUND_OR_PROTECTED', 'PRIVACY_RESTRICTED', 'LOOKUP_NOTICE', 'NOTICE'].includes(data.status[0])) {
            resultContent.innerHTML = `
              <div class="bg-amber-50 border-2 border-amber-400 text-amber-900 p-4 rounded-lg text-sm font-medium space-y-2">
                <div class="flex items-center gap-2 font-bold">
                  Aviso de Registro
                </div>
                <p>${data.message}</p>
              </div>
            `;
          } else if (result.source === 'legacy') {
            const rows = Object.entries(data)
              .filter(([key, val]) => typeof val === 'string' && val.trim() !== '')
              .map(([key, val]) => {
                let value = (val as string).trim();

                if (/^\d{4}-\d{2}-\d{2}T/.test(value)) {
                  try {
                    value = new Date(value).toLocaleString();
                  } catch (e) {
                    // Mantiene el valor original si falla la conversión
                  }
                }

                value = value.replace(/\n/g, '<br>');
                return [key, value];
              }) as [string, string][];

            resultContent.innerHTML = renderTable(rows);
            
          } else if (result.source === 'rdap') {
            const domainName = data.ldhName || domain;
            const handle = data.handle || 'No disponible';
            const events = data.events || [];
            const getEventDate = (action: string) => {
              const ev = events.find((e: any) => e.eventAction === action);
              return ev ? ev.eventDate : 'No disponible';
            };
            
            const statuses = data.status ? data.status.join('<br>') : 'No especificado';
            const nsList = data.nameservers ? data.nameservers.map((ns: any) => ns.ldhName).join('<br>') : 'No disponibles';
            
            let registrarName = 'No disponible';
            const entities = data.entities || [];
            const registrarEntity = entities.find((e: any) => e.roles?.includes('registrar'));
            if (registrarEntity) {
              registrarName = registrarEntity.handle || 'Desconocido';
              const vcard = registrarEntity.vcardArray?.[1] || [];
              const fn = vcard.find((p: any) => p[0] === 'fn');
              if (fn && fn[3]) registrarName = fn[3];
            }

            const rows: [string, string][] = [
              ['Domain Name', domainName],
              ['Registry Domain ID', handle],
              ['Registrar', registrarName],
              ['Creation Date', getEventDate('registration')],
              ['Registry Expiry Date', getEventDate('expiration')],
              ['Updated Date', getEventDate('last changed')],
              ['Domain Status', statuses],
              ['Name Server', nsList]
            ];

            resultContent.innerHTML = renderTable(rows);
          }
        } else {
          resultContent.innerHTML = `<p class="text-red-700 font-bold text-sm">Error: ${result.error}</p>`;
        }
        container.classList.remove('hidden');
      } catch (err) {
        resultContent.innerHTML = `<p class="text-red-700 font-bold text-sm">Error de conexión con el servidor.</p>`;
        container.classList.add('hidden');
      } finally {
        btn.textContent = 'Consultar WHOIS';
        btn.removeAttribute('disabled');
      }
    });
  </script>
</Layout>