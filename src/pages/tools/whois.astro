---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Buscador WHOIS de Dominios | SysArmor Tech";
const pageDescription = "Consulta registros detallados de dominios globales y ccTLDs, contactos, fechas y servidores de nombres.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  canonical={canonicalURL}
>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <!-- Botón de retorno a herramientas -->
    <div class="mb-6">
      <button 
        type="button"
        id="back-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-xl text-xs transition-all shadow-md font-mono cursor-pointer"
      >
        ← VOLVER A HERRAMIENTAS
      </button>
    </div>

    <!-- Cuadro de Cabecera Estilizado -->
    <div class="bg-slate-100 border border-slate-200 rounded-2xl p-6 shadow-sm mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <span class="inline-block bg-[#FDE047]/60 border border-[#FACC15] text-slate-900 text-xs font-mono font-bold px-3 py-1 rounded-full w-fit">
          Inteligencia de Dominios y DNS
        </span>
        <div class="flex items-center gap-4 text-xs font-mono text-slate-600">
          <span>Actualizado: 22 Sept, 2026</span>
          <span>Versión: 1.2.0</span>
        </div>
      </div>
      <hr class="border-slate-300 mb-6" />
      <div class="text-center">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 font-mono mb-2">Buscador WHOIS de Dominios</h1>
        <p class="text-slate-600 text-sm max-w-2xl mx-auto font-medium">
          Consulta registros detallados de dominios globales y ccTLDs, contactos, fechas y servidores de nombres.
        </p>
      </div>
    </div>

    <!-- Formulario de Consulta WHOIS -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl space-y-4 mb-8 text-slate-200">
      <h2 class="text-xs uppercase tracking-wider text-[#D4AF37] font-bold border-b border-slate-800 pb-3 font-mono">
        Consulta de Registros
      </h2>
      <form id="whois-form" class="flex flex-col sm:flex-row gap-3">
        <input 
          type="text" 
          id="domain-input" 
          placeholder="ej. sysarmortech.com o mintic.gov.co" 
          required
          class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-[#D4AF37] text-sm font-mono transition-all"
        />
        <button 
          type="submit" 
          id="submit-btn"
          class="bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold px-6 py-3 rounded-xl transition-all text-sm shadow-md font-mono cursor-pointer"
        >
          Consultar WHOIS
        </button>
      </form>
    </div>

    <!-- Contenedor de Resultados -->
    <div id="result-container" class="hidden bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl space-y-4 mb-12 text-slate-200">
      <h2 class="text-xs uppercase tracking-wider text-[#D4AF37] font-bold border-b border-slate-800 pb-3 font-mono">
        Resultados de la Consulta
      </h2>
      <div id="result-content" class="overflow-x-auto"></div>
    </div>

    <!-- Bloque de Contenido Técnico y Semántico para SEO -->
    <article class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6 text-slate-200 font-sans text-sm leading-relaxed shadow-xl">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg font-bold font-mono text-slate-100 flex items-center gap-2">
          <span class="text-[#D4AF37]">#</span> Guía Técnica: Protocolo WHOIS y Auditoría de Activos de Dominio
        </h2>
        <p class="text-xs text-slate-400 font-mono mt-1">Análisis de la base de datos de registro de dominios, metadatos y ciclo de vida de identidades en Internet.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[#D4AF37]">¿Qué es una consulta WHOIS?</h3>
          <p class="text-slate-300">
            El protocolo <strong class="text-slate-100">WHOIS</strong> es una herramienta estándar de consulta que permite acceder a las bases de datos de los registradores acreditados para verificar la titularidad, fechas de expiración y estado administrativo de nombres de dominio en Internet.
          </p>
          <ul class="list-disc pl-5 space-y-1 text-xs text-slate-300">
            <li><strong class="text-slate-100">Validación de Ciclo de Vida:</strong> Monitorea fechas críticas de creación, actualización y expiración para prevenir la pérdida de dominios corporativos.</li>
            <li><strong class="text-slate-100">Nameservers y Registradores:</strong> Identifica con precisión los servidores de nombres autoritativos (<span class="text-amber-400 font-mono">DNS</span>) asociados al dominio.</li>
          </ul>
        </div>

        <div class="space-y-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[#D4AF37]">Seguridad y Privacidad de Registros</h3>
          <p class="text-slate-300">
            En la gestión moderna de infraestructura TI, la auditoría continua de dominios previene ataques de suplantación y secuestro:
          </p>
          <ol class="list-decimal pl-5 space-y-1 text-xs text-slate-300">
            <li><strong class="text-slate-100">Protección de Privacidad:</strong> Muchos dominios enmascaran datos de contacto directo mediante servicios de proxy por normativas de privacidad.</li>
            <li><strong class="text-slate-100">Verificación de ccTLDs y gTLDs:</strong> Facilita el análisis cruzado tanto de extensiones genéricas (.com, .net) como territoriales (.co, .gov.co).</li>
          </ol>
        </div>
      </div>
    </article>
  </section>

  <script>
    /* ========================================================
        DEPLOY CACHE-BUSTER & VERSION CONTROL
        Timestamp: 2026-09-18T16:35:00Z 
        Forza la invalidación del CDN edge en Vercel para este módulo
        ======================================================== */
    
    const form = document.getElementById('whois-form') as HTMLFormElement;
    const input = document.getElementById('domain-input') as HTMLInputElement;
    const container = document.getElementById('result-container') as HTMLDivElement;
    const resultContent = document.getElementById('result-content') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    // Manejar el botón de regreso de forma segura
    const backBtn = document.getElementById('back-btn');
    backBtn?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/tools';
      }
    });

    const sanitizeValue = (val: any): string => {
      if (val === null || val === undefined || val === '') return '';
      
      if (Array.isArray(val)) {
        return val.map(item => sanitizeValue(item)).filter(Boolean).join('<br>');
      }
      
      if (typeof val === 'object') {
        return Object.entries(val)
          .map(([k, v]) => `<strong>${k}:</strong> ${sanitizeValue(v)}`)
          .filter(Boolean)
          .join('<br>');
      }
      
      let str = String(val).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(str)) {
        try {
          str = new Date(str).toUTCString();
        } catch (e) {
          // Mantiene el original si falla
        }
      }
      return str.replace(/\n/g, '<br>');
    };

    const renderTable = (rows: [string, string][]) => {
      let tableHtml = `<table class="w-full text-left border-collapse bg-slate-950 rounded-xl overflow-hidden border border-slate-800 text-xs sm:text-sm font-mono shadow-inner"><tbody>`;
      rows.forEach(([key, value], index) => {
        const bgClass = index % 2 === 0 ? 'bg-slate-950' : 'bg-slate-900/50';
        tableHtml += `
          <tr class="${bgClass} border-b border-slate-800/80">
            <td class="p-3 font-semibold text-slate-400 w-1/3 border-r border-slate-800/80 capitalize">${key.replace(/([A-Z])/g, ' $1').trim()}</td>
            <td class="p-3 text-slate-200 w-2/3 break-all">${value}</td>
          </tr>
        `;
      });
      tableHtml += `</tbody></table>`;
      return tableHtml;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = input.value.trim();
      if (!domain) return;

      btn.textContent = 'Consultando...';
      btn.setAttribute('disabled', 'true');
      container.classList.add('hidden');

      try {
        const response = await fetch(`/api/whois?domain=${encodeURIComponent(domain)}`);
        const result = await response.json();

        if (result.success) {
          const data = result.data;
          
          if (data && data.status && ['NOT_FOUND_OR_PROTECTED', 'PRIVACY_RESTRICTED', 'LOOKUP_NOTICE', 'NOTICE'].includes(data.status[0])) {
            resultContent.innerHTML = `
              <div class="bg-amber-950/40 border border-amber-500/40 text-amber-200 p-4 rounded-xl text-sm font-medium space-y-2 font-mono">
                <div class="flex items-center gap-2 font-bold">
                  Aviso de Registro
                </div>
                <p>${data.message}</p>
              </div>
            `;
          } else {
            const excludeKeys = ['handle', 'ldhName', 'unicodeName', 'links', 'notices', 'remarks', 'entities', '_extractedContacts'];
            const rows: [string, string][] = [];

            for (const [key, val] of Object.entries(data)) {
              if (excludeKeys.includes(key)) continue;
              
              const formattedVal = sanitizeValue(val);
              if (!formattedVal) continue;

              rows.push([key, formattedVal]);
            }

            resultContent.innerHTML = rows.length > 0 ? renderTable(rows) : `<p class="text-slate-400 font-semibold text-sm font-mono">No se encontraron datos públicos para mostrar.</p>`;
          }
        } else {
          resultContent.innerHTML = `<p class="text-rose-400 font-semibold text-sm font-mono">Error: ${result.error}</p>`;
        }
        container.classList.remove('hidden');
      } catch (err) {
        resultContent.innerHTML = `<p class="text-rose-400 font-semibold text-sm font-mono">Error de conexión con el servidor.</p>`;
        container.classList.add('hidden');
      } finally {
        btn.textContent = 'Consultar WHOIS';
        btn.removeAttribute('disabled');
      }
    });
  </script>
</Layout>