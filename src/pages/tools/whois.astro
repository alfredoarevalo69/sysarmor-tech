---
// src/pages/tools/whois.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Buscador WHOIS de Dominios | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-[#cbd5e1] text-slate-900">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold rounded-xl text-xs uppercase tracking-wider transition-all shadow-md"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <div class="space-y-3 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          Buscador WHOIS de Dominios
        </h1>
        <p class="text-slate-800 text-sm sm:text-base max-w-2xl mx-auto font-medium">
          Consulta registros detallados de dominios globales y ccTLDs, contactos, fechas y servidores de nombres.
        </p>
      </div>

      <div class="bg-slate-900 text-slate-100 border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-4">
        <form id="whois-form" class="flex flex-col sm:flex-row gap-3">
          <input 
            type="text" 
            id="domain-input" 
            placeholder="ej. sysarmortech.com o mintic.gov.co" 
            required
            class="flex-1 bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-[#D4AF37] focus:ring-2 focus:ring-[#D4AF37]/20 text-sm transition-all"
          />
          <button 
            type="submit" 
            id="submit-btn"
            class="bg-[#D4AF37] hover:bg-[#c29d31] text-slate-950 font-bold px-6 py-3 rounded-xl transition-all text-sm shadow-lg cursor-pointer"
          >
            Consultar WHOIS
          </button>
        </form>
      </div>

      <div id="result-container" class="hidden bg-slate-900 text-slate-100 border border-slate-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-4">
        <h2 class="text-lg font-bold text-white border-b border-slate-800 pb-3">Resultados de la Consulta</h2>
        <div id="result-content" class="overflow-x-auto"></div>
      </div>

    </div>
  </main>

  <script>
    const form = document.getElementById('whois-form') as HTMLFormElement;
    const input = document.getElementById('domain-input') as HTMLInputElement;
    const container = document.getElementById('result-container') as HTMLDivElement;
    const resultContent = document.getElementById('result-content') as HTMLDivElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    const sanitizeValue = (val: any): string => {
      if (val === null || val === undefined || val === '') return '';
      
      if (Array.isArray(val)) {
        return val.map(item => sanitizeValue(item)).filter(Boolean).join('<br>');
      }
      
      if (typeof val === 'object') {
        return Object.entries(val)
          .map(([k, v]) => `<strong>${k}:</strong> ${sanitizeValue(v)}`)
          .filter(Boolean)
          .join('<br>');
      }
      
      let str = String(val).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(str)) {
        try {
          str = new Date(str).toUTCString();
        } catch (e) {
          // Mantiene el original si falla
        }
      }
      return str.replace(/\n/g, '<br>');
    };

    const renderTable = (rows: [string, string][]) => {
      let tableHtml = `<table class="w-full text-left border-collapse bg-slate-950 rounded-xl overflow-hidden border border-slate-800 text-xs sm:text-sm font-mono shadow-inner"><tbody>`;
      rows.forEach(([key, value], index) => {
        const bgClass = index % 2 === 0 ? 'bg-slate-950' : 'bg-slate-900/50';
        tableHtml += `
          <tr class="${bgClass} border-b border-slate-800/80">
            <td class="p-3 font-semibold text-slate-400 w-1/3 border-r border-slate-800/80 capitalize">${key.replace(/([A-Z])/g, ' $1').trim()}</td>
            <td class="p-3 text-slate-200 w-2/3 break-all">${value}</td>
          </tr>
        `;
      });
      tableHtml += `</tbody></table>`;
      return tableHtml;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const domain = input.value.trim();
      if (!domain) return;

      btn.textContent = 'Consultando...';
      btn.setAttribute('disabled', 'true');
      container.classList.add('hidden');

      try {
        const response = await fetch(`/api/whois?domain=${encodeURIComponent(domain)}`);
        const result = await response.json();

        if (result.success) {
          const data = result.data;
          
          if (data && data.status && ['NOT_FOUND_OR_PROTECTED', 'PRIVACY_RESTRICTED', 'LOOKUP_NOTICE', 'NOTICE'].includes(data.status[0])) {
            resultContent.innerHTML = `
              <div class="bg-amber-950/40 border border-amber-500/40 text-amber-200 p-4 rounded-xl text-sm font-medium space-y-2">
                <div class="flex items-center gap-2 font-bold">
                  Aviso de Registro
                </div>
                <p>${data.message}</p>
              </div>
            `;
          } else {
            const excludeKeys = ['handle', 'ldhName', 'unicodeName', 'links', 'notices', 'remarks', 'entities', '_extractedContacts'];
            const rows: [string, string][] = [];

            for (const [key, val] of Object.entries(data)) {
              if (excludeKeys.includes(key)) continue;
              
              const formattedVal = sanitizeValue(val);
              if (!formattedVal) continue;

              rows.push([key, formattedVal]);
            }

            resultContent.innerHTML = rows.length > 0 ? renderTable(rows) : `<p class="text-slate-400 font-semibold text-sm">No se encontraron datos públicos para mostrar.</p>`;
          }
        } else {
          resultContent.innerHTML = `<p class="text-rose-400 font-semibold text-sm">Error: ${result.error}</p>`;
        }
        container.classList.remove('hidden');
      } catch (err) {
        resultContent.innerHTML = `<p class="text-rose-400 font-semibold text-sm">Error de conexión con el servidor.</p>`;
        container.classList.add('hidden');
      } finally {
        btn.textContent = 'Consultar WHOIS';
        btn.removeAttribute('disabled');
      }
    });
  </script>
</Layout>