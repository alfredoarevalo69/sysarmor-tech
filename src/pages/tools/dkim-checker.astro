---
// src/pages/tools/dkim-checker.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Validador de Registros DKIM y Selector DNS | SysArmor Tech">
  <main class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-slate-200 border-t border-slate-300 text-slate-900">
    <div class="max-w-3xl mx-auto space-y-8">
      
      <div>
        <a 
          href="/tools" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg transition-colors shadow-sm"
        >
          <span>←</span> Volver a Herramientas
        </a>
      </div>

      <!-- Cabecera ajustada al estándar visual de SysArmor Tech -->
      <header class="bg-slate-100 border border-slate-300 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-slate-300">
          <span class="inline-flex items-center px-3 py-1 bg-amber-200 text-amber-900 text-xs font-bold rounded-full shadow-sm w-fit">
            Seguridad de Correo & DNS
          </span>
          <div class="flex items-center gap-4 text-xs font-medium text-slate-600">
            <time datetime="2026-09-23">Actualizado: 23 Sept, 2026</time>
            <span>•</span>
            <span>Versión: 1.2.0</span>
          </div>
        </div>
        <div class="space-y-2 text-center max-w-2xl mx-auto pt-2">
          <h1 class="text-3xl md:text-4xl font-display font-bold text-slate-950 tracking-wide uppercase">
            Validador de Registros DKIM y Selector DNS
          </h1>
          <p class="text-slate-700 font-medium text-base">
            Herramienta avanzada para administradores de sistemas e infraestructura TI. Comprueba la clave pública, la sintaxis y la integridad de los registros DomainKeys Identified Mail (DKIM) bajo selectores personalizados para asegurar el correo saliente corporativo.
          </p>
        </div>
      </header>

      <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl space-y-6">
        <form id="dkim-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2 space-y-1">
              <label for="domain" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">Dominio</label>
              <input
                type="text"
                id="domain"
                required
                value=""
                autocomplete="off"
                placeholder="ej. bancofalabella.com"
                class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white font-mono text-sm focus:outline-none focus:border-amber-500 shadow-inner placeholder-slate-500 transition-colors"
              />
            </div>
            <div class="space-y-1">
              <label for="selector" class="block text-xs font-bold text-slate-400 uppercase tracking-wide">Selector</label>
              <input
                type="text"
                id="selector"
                required
                value=""
                autocomplete="off"
                placeholder="ej. 200608, mailjet"
                class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-white font-mono text-sm focus:outline-none focus:border-amber-500 shadow-inner placeholder-slate-500 transition-colors"
              />
            </div>
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-6 py-3 rounded-xl transition-colors text-sm shadow-sm cursor-pointer h-[46px]"
          >
            Verificar DKIM
          </button>
        </form>
      </div>

      <div id="results" class="hidden bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl space-y-6">
        <h2 class="text-xl font-bold text-slate-950 border-b border-slate-800 pb-3">
          Resultado del Análisis
        </h2>
        
        <div id="results-content" class="space-y-6">
          <!-- Inyectado por JS -->
        </div>
      </div>

      <!-- Bloque de Contenido Técnico y Semántico Inferior (SEO Crawlers) -->
      <section class="bg-slate-950 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl text-slate-300 space-y-6">
        <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-3">
          Guía Técnica: ¿Cómo Funciona la Validación de Registros DKIM?
        </h2>
        
        <div class="space-y-4 text-sm leading-relaxed text-slate-300">
          <p>
            El protocolo <strong>DKIM (DomainKeys Identified Mail)</strong> es un estándar de autenticación de correo electrónico diseñado para detectar la suplantación de identidad (spoofing) mediante la incorporación de una firma digital cifrada en las cabeceras del mensaje. Esta herramienta interactúa directamente con los servidores de nombres de dominio (DNS) para consultar el registro TXT asociado al selector específico dentro del subdominio de correo (<code class="text-amber-400 font-mono">selector._domainkey.dominio.com</code>).
          </p>

          <h3 class="text-base font-bold text-white pt-2">Parámetros Críticos Analizados en el Registro TXT</h3>
          <ul class="list-disc pl-5 space-y-2 text-slate-300">
            <li><strong class="text-amber-400 font-mono">v (Version):</strong> Especifica la versión del protocolo DKIM utilizada (habitualmente <code class="font-mono">DKIM1</code>). Debe ser obligatoriamente el primer parámetro de la cadena.</li>
            <li><strong class="text-amber-400 font-mono">k (Key Type):</strong> Define el algoritmo criptográfico empleado para generar la clave pública, siendo <code class="font-mono">rsa</code> el estándar más extendido en la industria de servidores de correo corporativo.</li>
            <li><strong class="text-amber-400 font-mono">p (Public Key):</strong> Contiene la llave pública codificada en formato Base64. Los MTA (Mail Transfer Agents) receptores utilizan esta clave para descifrar y validar la firma criptográfica de los correos salientes. Si este valor está vacío, el registro se considera revocado o inválido.</li>
            <li><strong class="text-amber-400 font-mono">h (Hash Algorithm):</strong> Indica las funciones hash permitidas para procesar el mensaje (ej. <code class="font-mono">sha256</code>).</li>
          </ul>

          <h3 class="text-base font-bold text-white pt-2">Buenas Prácticas para Sysadmins y Seguridad de Infraestructura de Correo</h3>
          <p>
            Una correcta implementación de DKIM, combinada con políticas estrictas de <abbr title="Sender Policy Framework">SPF</abbr> y <abbr title="Domain-based Message Authentication, Reporting, and Conformance">DMARC</abbr>, previene que los correos corporativos sean clasificados como <em>Spam</em> o bloqueados por proveedores de servicios de internet (ISPs) como Google Workspace, Microsoft 365 o servidores postfix autohospedados. Se recomienda la rotación periódica de selectores y el uso de longitudes de clave RSA de al menos 2048 bits para garantizar la resiliencia criptográfica frente a ataques de fuerza bruta.
          </p>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('dkim-form') as HTMLFormElement;
  const resultsDiv = document.getElementById('results');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const resultsContent = document.getElementById('results-content') as HTMLDivElement;

  const dkimMeta: Record<string, { name: string; desc: string }> = {
    v: { name: 'Version', desc: 'Identifica el registro como un registro DKIM. Debe ser el primer tag.' },
    k: { name: 'Key Type', desc: 'El tipo de llave criptográfica utilizada por el tag (p).' },
    p: { name: 'Public Key', desc: 'La sintaxis y semántica de este valor antes de ser codificado en base64 son definidas por el tag (k).' },
    h: { name: 'Hash Algorithm', desc: 'Algoritmos de hash aceptados para la firma (ej. sha256).' },
    s: { name: 'Service Type', desc: 'Tipos de servicio restringidos para el uso de esta clave.' },
    t: { name: 'Flags', desc: 'Banderas de prueba o políticas estrictas (ej. y para testing).' }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = (document.getElementById('domain') as HTMLInputElement).value.trim();
    const selector = (document.getElementById('selector') as HTMLInputElement).value.trim();

    if (!domain || !selector) return;

    if (submitBtn) {
      submitBtn.textContent = 'Consultando Servidores DNS...';
      submitBtn.setAttribute('disabled', 'true');
    }
    resultsDiv?.classList.add('hidden');

    try {
      const response = await fetch('/api/check-dkim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ domain, selector }),
      });

      const data = await response.json();
      resultsDiv?.classList.remove('hidden');

      if (response.ok) {
        if (data.status === 'PASS') {
          let rowsHtml = data.tags.map((t: any) => {
            const meta = dkimMeta[t.tag.toLowerCase()] || { name: t.name || t.tag.toUpperCase(), desc: t.description || 'Parámetro personalizado o extendido de DKIM.' };
            return `
              <tr class="border-b border-slate-800 hover:bg-slate-900/50 transition-colors">
                <td class="px-4 py-3 font-mono font-bold text-amber-400 uppercase">${t.tag}</td>
                <td class="px-4 py-3 font-mono text-xs text-amber-300 break-all">${t.value}</td>
                <td class="px-4 py-3 font-semibold text-slate-200">${meta.name}</td>
                <td class="px-4 py-3 text-slate-400 text-xs">${meta.desc}</td>
              </tr>
            `;
          }).join('');

          resultsContent.innerHTML = `
            <div class="p-4 bg-slate-900 border border-slate-800 text-slate-200 rounded-xl space-y-2 shadow-inner">
              <div class="flex items-center justify-between">
                <div class="font-bold text-sm uppercase tracking-wide text-amber-400">Estado DKIM: PASS (${data.qname})</div>
              </div>
              <p class="text-xs font-mono break-all bg-slate-950 p-3 rounded-lg border border-slate-800 text-amber-300 shadow-inner">${data.record}</p>
            </div>

            <div class="overflow-x-auto border border-slate-800 rounded-xl shadow-xl bg-slate-950">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="bg-slate-900 border-b border-slate-800 text-slate-300 font-bold text-xs uppercase tracking-wider">
                    <th class="px-4 py-3">Tag</th>
                    <th class="px-4 py-3">TagValue</th>
                    <th class="px-4 py-3">Name</th>
                    <th class="px-4 py-3">Description</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800 text-slate-300">
                  ${rowsHtml}
                </tbody>
              </table>
            </div>
          `;
        } else {
          resultsContent.innerHTML = `
            <div class="p-4 bg-slate-900 border border-slate-800 text-slate-200 rounded-xl space-y-1 shadow-inner">
              <div class="font-bold text-sm uppercase tracking-wide text-amber-400">Consulta: ${data.qname}</div>
              <p class="text-xs text-slate-300">No se halló un registro DKIM válido para el selector provisto. Verifica que el selector y el dominio sean correctos.</p>
            </div>
          `;
        }
      } else {
        resultsContent.innerHTML = `<p class="text-red-400 font-bold text-sm">Error: ${data.error || 'Ocurrió un error en la validación.'}</p>`;
      }
    } catch (err) {
      resultsContent.innerHTML = `<p class="text-red-400 font-bold text-sm">Error de red al conectar con el servidor.</p>`;
    } finally {
      if (submitBtn) {
        submitBtn.textContent = 'Verificar DKIM';
        submitBtn.removeAttribute('disabled');
      }
    }
  });
</script>