---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';

// Obtener todos los artículos de la colección 'recursos'
const posts = await getCollection('recursos');

// Ordenar por fecha (los más recientes primero)
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).getTime();
  const dateB = new Date(b.data.pubDate || 0).getTime();
  return dateB - dateA;
});

// Extraer categorías únicas para los botones de filtro
const categories = ['Todos', ...new Set(posts.map((post) => post.data.category).filter(Boolean))];
---

<Layout title="Blog de Ingeniería y Operaciones | SysArmor Tech">
  
  {/* --- 1. HERO BANNER PRINCIPAL (AHORA FULL-WIDTH DE BORDE A BORDE) --- */}
  <section class="w-full bg-[#050a14] overflow-hidden">
    <img 
      src="/images/Imagen_blog.png" 
      alt="Blog de Ingeniería & Operaciones - SysArmor Tech" 
      class="w-full h-auto max-h-[450px] object-cover object-center block"
    />
  </section>

  {/* --- 2. FRANJA CON BOTONES DE FILTRO Y BÚSQUEDA --- */}
  <section class="bg-white py-4 border-b border-slate-200 shadow-sm sticky top-0 z-30">
    <div class="container mx-auto max-w-6xl px-4 flex flex-col md:flex-row items-center justify-between gap-4">
      
      {/* Botones de Categoría (Chips) */}
      <div class="flex flex-wrap gap-2">
        {categories.map((category) => (
          <button
            class={`category-filter px-4 py-2 rounded-lg text-xs font-semibold transition-all ${
              category === 'Todos'
                ? 'bg-slate-900 text-white active-filter'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
            data-category={category.toLowerCase()}
          >
            {category}
          </button>
        ))}
      </div>

      {/* Buscador de documentos por título/palabra clave */}
      <div class="w-full md:w-72 relative">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar documentos..."
          class="w-full pl-9 pr-4 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
        />
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

    </div>
  </section>

  {/* --- 3. SECCIÓN DE ARTÍCULOS CON FONDO CLARO TENUE --- */}
  <main class="bg-slate-100 min-h-screen py-10 text-slate-800">
    <div class="container mx-auto max-w-6xl px-4">
      
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Últimos Artículos</h2>

      {/* Grid de Tarjetas */}
      {sortedPosts.length > 0 ? (
        <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <div 
              class="article-item" 
              data-category={post.data.category?.toLowerCase() || ''}
              data-title={post.data.title?.toLowerCase() || ''}
              data-description={post.data.description?.toLowerCase() || ''}
            >
              <ArticleCard 
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                pubDate={post.data.pubDate}
                slug={post.id}
                image={post.data.image}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-xl border border-slate-200 shadow-sm">
          <p class="text-slate-500">No hay artículos disponibles en este momento.</p>
        </div>
      )}

      {/* Mensaje cuando no hay coincidencias de búsqueda */}
      <div id="no-results" class="hidden text-center py-12 bg-white rounded-xl border border-slate-200 shadow-sm">
        <p class="text-slate-500">No se encontraron documentos que coincidan con la búsqueda.</p>
      </div>

    </div>
  </main>

</Layout>

{/* --- SCRIPT PARA BÚSQUEDA Y FILTRADO POR CATEGORÍA EN TIEMPO REAL --- */}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.category-filter');
    const articles = document.querySelectorAll('.article-item');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const noResults = document.getElementById('no-results');

    let currentCategory = 'todos';
    let currentQuery = '';

    function filterArticles() {
      let visibleCount = 0;

      articles.forEach((article) => {
        const cat = article.getAttribute('data-category') || '';
        const title = article.getAttribute('data-title') || '';
        const desc = article.getAttribute('data-description') || '';

        const matchesCategory = currentCategory === 'todos' || cat === currentCategory;
        const matchesQuery = !currentQuery || title.includes(currentQuery) || desc.includes(currentQuery);

        if (matchesCategory && matchesQuery) {
          (article as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (article as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    // Evento de clic en Categorías
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'todos';

        // Estilos exactos: Oscuro para el activo, Claro para inactivos
        filterButtons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'active-filter');
          b.classList.add('bg-slate-100', 'text-slate-700');
        });

        btn.classList.remove('bg-slate-100', 'text-slate-700');
        btn.classList.add('bg-slate-900', 'text-white', 'active-filter');

        filterArticles();
      });
    });

    // Evento de búsqueda dinámica en el input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterArticles();
      });
    }
  });
</script>