---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';

// Obtener todos los artículos de la colección 'recursos'
const posts = await getCollection('recursos');

// Ordenar por fecha (los más recientes primero)
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).getTime();
  const dateB = new Date(b.data.pubDate || 0).getTime();
  return dateB - dateA;
});

// Extraer categorías únicas para los botones de filtro
const categories = ['Todos', ...new Set(posts.map((post) => post.data.category).filter(Boolean))];

// URL canónica para posicionamiento e indexación SEO
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout 
  title="Blog de Ingeniería y Operaciones | SysArmor Tech"
  description="Artículos técnicos sobre Active Directory, Azure, Intune y hardening de infraestructura TI."
  canonical={canonicalUrl}
>
  
  {/* --- 1. HERO BANNER PRINCIPAL --- */}
  <section class="w-full bg-zinc-900 text-white pt-10 pb-8 border-b-2 border-zinc-700 relative overflow-hidden">
    <div class="container mx-auto max-w-6xl px-4 relative z-10">
      
      {/* Bloque Superior: Título + Badges */}
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 mb-6">
        
        {/* Contenido principal */}
        <div class="max-w-2xl space-y-3">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-amber-500/15 border-2 border-amber-500/40 text-amber-400 text-xs font-mono uppercase tracking-wider font-bold shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            Blog de Ingeniería & Operaciones
          </div>
          
          <h1 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight leading-snug uppercase">
            Artículos de ingeniería, <span class="text-amber-400">hardening</span> y operaciones de infraestructura
          </h1>
          
          <p class="text-zinc-300 text-sm leading-relaxed font-sans font-medium">
            Aprendizajes, soluciones y buenas prácticas sobre seguridad, automatización e infraestructura IT.
          </p>
        </div>

        {/* Badges de Especialidades */}
        <div class="flex flex-col gap-2.5 shrink-0 w-full lg:w-72">
          <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 mb-0.5 font-bold">Categorías Principales</span>
          
          <div class="flex items-center gap-2.5 py-2 px-3 rounded-lg bg-zinc-800 border-2 border-zinc-700 text-zinc-200 text-xs font-semibold shadow-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shrink-0"></span>
            Windows Server & Active Directory
          </div>
          
          <div class="flex items-center gap-2.5 py-2 px-3 rounded-lg bg-zinc-800 border-2 border-zinc-700 text-zinc-200 text-xs font-semibold shadow-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shrink-0"></span>
            Microsoft 365 & Intune
          </div>
          
          <div class="flex items-center gap-2.5 py-2 px-3 rounded-lg bg-zinc-800 border-2 border-zinc-700 text-zinc-200 text-xs font-semibold shadow-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shrink-0"></span>
            Azure & Cloud Security
          </div>
        </div>

      </div>

      {/* Bloque Inferior: Franja con Pilares Técnicos */}
      <div class="pt-6 border-t border-zinc-700 grid grid-cols-2 md:grid-cols-4 gap-4">
        
        <div class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <div>
            <span class="font-bold text-white text-xs block leading-tight font-display">Seguridad</span>
            <span class="text-[11px] text-zinc-400 font-medium font-sans">Nivel empresarial</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 md:border-l md:border-zinc-700 md:pl-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <div>
            <span class="font-bold text-white text-xs block leading-tight font-display">Infraestructura</span>
            <span class="text-[11px] text-zinc-400 font-medium font-sans">Resiliente y eficiente</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 md:border-l md:border-zinc-700 md:pl-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <div>
            <span class="font-bold text-white text-xs block leading-tight font-display">Expertos Certificados</span>
            <span class="text-[11px] text-zinc-400 font-medium font-sans">Soporte Nivel 2 y 3</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 md:border-l md:border-zinc-700 md:pl-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <div>
            <span class="font-bold text-white text-xs block leading-tight font-display">Automatización</span>
            <span class="text-[11px] text-zinc-400 font-medium font-sans">E innovación constante</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* --- 2. FRANJA CON BOTONES DE FILTRO Y BÚSQUEDA --- */}
  <section class="bg-zinc-200 py-3 border-b-2 border-zinc-300 sticky top-[76px] z-30 shadow-sm">
    <div class="container mx-auto max-w-6xl px-4 flex flex-col md:flex-row items-center justify-between gap-3">
      
      <div class="flex flex-wrap gap-1.5">
        {categories.map((category) => (
          <button
            class={`category-filter px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${
              category === 'Todos'
                ? 'bg-amber-600/20 text-amber-800 border-2 border-amber-600/70 active-filter shadow-sm'
                : 'bg-white text-zinc-700 hover:bg-zinc-100 border-2 border-zinc-300 hover:border-zinc-400'
            }`}
            data-category={category.toLowerCase()}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="w-full md:w-64 relative">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar documentos..."
          class="w-full pl-9 pr-3 py-1.5 bg-white border-2 border-zinc-300 rounded-lg text-xs text-zinc-900 placeholder-zinc-500 focus:outline-none focus:ring-1 focus:ring-amber-600 focus:border-amber-600 transition-all font-medium shadow-sm"
        />
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 0114 0z" />
          </svg>
        </div>
      </div>

    </div>
  </section>

  {/* --- 3. SECCIÓN DE ARTÍCULOS --- */}
  <main class="bg-zinc-200 min-h-screen py-8 text-neutral-900">
    <div class="container mx-auto max-w-6xl px-4">
      
      <h2 class="text-xl font-display font-bold text-neutral-900 mb-6 uppercase tracking-wide">Últimos Artículos</h2>

      {sortedPosts.length > 0 ? (
        <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedPosts.map((post) => (
            <div 
              class="article-item" 
              data-category={post.data.category?.toLowerCase() || ''}
              data-title={post.data.title?.toLowerCase() || ''}
              data-description={post.data.description?.toLowerCase() || ''}
            >
              <ArticleCard 
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                pubDate={post.data.pubDate}
                slug={post.id}
                image={post.data.image}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-10 bg-white rounded-xl border-2 border-zinc-300 shadow-sm">
          <p class="text-zinc-700 text-sm font-medium">No hay artículos disponibles en este momento.</p>
        </div>
      )}

      <div id="no-results" class="hidden text-center py-10 bg-white rounded-xl border-2 border-zinc-300 shadow-sm">
        <p class="text-zinc-700 text-sm font-medium">No se encontraron documentos que coincidan con la búsqueda.</p>
      </div>

    </div>
  </main>

</Layout>

<script>
  const setupBlogFilters = () => {
    const filterButtons = document.querySelectorAll('.category-filter');
    const articles = document.querySelectorAll('.article-item');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const noResults = document.getElementById('no-results');

    let currentCategory = 'todos';
    let currentQuery = '';
    let debounceTimer: ReturnType<typeof setTimeout>;

    function filterArticles() {
      let visibleCount = 0;

      articles.forEach((article) => {
        const cat = article.getAttribute('data-category') || '';
        const title = article.getAttribute('data-title') || '';
        const desc = article.getAttribute('data-description') || '';

        const matchesCategory = currentCategory === 'todos' || cat === currentCategory;
        const matchesQuery = !currentQuery || title.includes(currentQuery) || desc.includes(currentQuery);

        if (matchesCategory && matchesQuery) {
          (article as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (article as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'todos';

        filterButtons.forEach((b) => {
          b.classList.remove('bg-amber-600/20', 'text-amber-800', 'border-2', 'border-amber-600/70', 'active-filter', 'shadow-sm');
          b.classList.add('bg-white', 'text-zinc-700', 'border-2', 'border-zinc-300');
        });

        btn.classList.remove('bg-white', 'text-zinc-700', 'border-2', 'border-zinc-300');
        btn.classList.add('bg-amber-600/20', 'text-amber-800', 'border-2', 'border-amber-600/70', 'active-filter', 'shadow-sm');

        filterArticles();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
          filterArticles();
        }, 150);
      });
    }
  };

  document.addEventListener('DOMContentLoaded', setupBlogFilters);
  document.addEventListener('astro:page-load', setupBlogFilters);
</script>