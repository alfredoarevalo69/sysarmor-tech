---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Definir rutas estáticas
export async function getStaticPaths() {
  const posts = await getCollection('recursos');
  return posts.map((post) => {
    const slug = post.slug || post.id;
    return {
      params: { slug },
      props: { post },
    };
  });
}

// 2. Extraer datos
const { post } = Astro.props;
const data = post?.data || {};
const title = data.title || "Artículo del Blog";
const category = data.category || "Infraestructura TI";

// 3. Ruta del PDF y URL absoluta para el visor móvil
const pdfPath = data.pdfUrl || "/docs/optimizacion-dns-active-directory-hub-spoke-hibrido.pdf";
const siteUrl = Astro.site ? Astro.site.origin : 'https://sysarmortech.com';
const fullPdfUrl = new URL(pdfPath, siteUrl).href;
const googleDocsViewerUrl = `https://docs.google.com/viewer?url=${encodeURIComponent(fullPdfUrl)}&embedded=true`;
---

<Layout title={`${title} | SysArmor Tech`} bgColor="#ffffff">
  
  <main class="bg-white min-h-screen py-6 text-slate-800" style="background-color: #ffffff !important;">
    <div class="container mx-auto max-w-6xl px-4">
      
      {/* --- BARRA SUPERIOR DE NAVEGACIÓN --- */}
      <div class="flex items-center justify-between bg-slate-950 p-4 rounded-xl shadow-lg mb-6 border border-slate-800">
        <a 
          href="/blog" 
          class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold text-xs md:text-sm transition-colors cursor-pointer"
        >
          &larr; Volver al Blog
        </a>

        <div class="flex items-center gap-2 md:gap-3">
          {category && (
            <span class="hidden md:inline-block text-xs font-semibold px-3 py-1 bg-slate-900 text-amber-400 rounded-full border border-slate-800 uppercase tracking-wide">
              {category}
            </span>
          )}
          <a 
            href={pdfPath} 
            download 
            class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3 py-2 md:px-4 md:py-2 rounded-lg text-xs transition-colors flex items-center gap-1 shadow-sm"
          >
            Descargar PDF &darr;
          </a>
        </div>
      </div>

      {/* --- CONTENEDOR DEL VISOR (Diferenciado para PC y Móvil) --- */}
      <div class="w-full bg-white rounded-xl overflow-hidden border border-slate-200 shadow-xl" style="height: 78vh;">
        
        {/* Visor Nativo para Desktop / Laptop */}
        <iframe 
          src={pdfPath} 
          class="w-full h-full border-none hidden md:block"
          title={title}
        ></iframe>

        {/* Visor Embed de Google Docs para Celulares (Android / iOS) */}
        <iframe 
          src={googleDocsViewerUrl} 
          class="w-full h-full border-none block md:hidden"
          title={title}
        >
          <p class="p-6 text-center text-slate-600">
            Tu navegador no soporta la visualización del PDF.
            <a href={pdfPath} class="text-amber-500 underline font-semibold ml-1">
              Descarga el documento aquí.
            </a>
          </p>
        </iframe>

      </div>

    </div>
  </main>

</Layout>