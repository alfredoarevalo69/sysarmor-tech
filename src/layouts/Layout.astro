---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Feedback from '../components/Feedback.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'home' | 'legal' | 'tool' | 'blog';
  ogImage?: string;
  bgColor?: string;
  lcpImage?: string;
  toolCategory?: string;
  toolLastUpdated?: string;
  toolVersion?: string;
  blogCategory?: string;
  pubDate?: string;
  author?: string;
  enfoque?: string;
}

const { 
  title, 
  description = "Ingeniería de Infraestructura y Seguridad IT. Evaluaciones técnicas y hardening sin compromiso.", 
  ogImage = '/images/og-image.png',
  bgColor = '#cbd5e1',
  lcpImage,
  variant,
  toolCategory,
  toolLastUpdated,
  toolVersion,
  blogCategory,
  pubDate,
  author = "Alfredo Arévalo",
  enfoque
} = Astro.props;

const siteURL = Astro.site ? Astro.site.origin : 'https://sysarmortech.com';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const fullOgImageUrl = new URL(ogImage, siteURL).href;

const pageTitle = title.includes('SysArmor Tech') ? title : `${title} | SysArmor Tech`;

const schemaOrgData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteURL}/#organization`,
      "name": "SysArmor Tech",
      "alternateName": ["SysArmor Tech Colombia", "SysArmorTech"],
      "url": siteURL,
      "logo": {
        "@type": "ImageObject",
        "@url": `${siteURL}/favicon.png?v=5`
      },
      "description": "Firma de consultoría e ingeniería especializada en infraestructura crítica, ecosistema Microsoft, Nivel 3 y SecOps.",
      "address": {
        "@type": "PostalAddress",
        "@addressLocality": "Engativá, Bogotá",
        "@addressRegion": "Cundinamarca",
        "@addressCountry": "CO"
      },
      "sameAs": [
        "https://www.linkedin.com/company/sysarmortech"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteURL}/#website`,
      "url": siteURL,
      "name": "SysArmor Tech",
      "description": description,
      "publisher": {
        "@id": `${siteURL}/#organization`
      },
      "inLanguage": "es-CO"
    },
    ...(variant === 'blog' ? [{
      "@type": "TechArticle",
      "@id": `${canonicalURL}#article`,
      "isPartOf": {
        "@id": `${siteURL}/#website`
      },
      "headline": title,
      "description": description,
      "image": fullOgImageUrl,
      "datePublished": pubDate,
      "author": {
        "@type": "Person",
        "name": author
      },
      "publisher": {
        "@id": `${siteURL}/#organization`
      },
      "mainEntityOfPage": canonicalURL
    }] : [])
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    {lcpImage && (
      <link rel="preload" href={lcpImage} as="image" type="image/webp" />
    )}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=5" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png?v=5" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png?v=5" />
    
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta property="og:type" content={variant === 'blog' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    {pubDate && <meta property="article:published_time" content={pubDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />

    <style is:global>
      @media (max-width: 768px) {
        section[id], div[id] {
          scroll-margin-top: 90px;
        }
      }
    </style>
  </head>
  
  <body 
    class="text-slate-900 selection:bg-amber-500/30 min-h-screen flex flex-col antialiased" 
    style={`background-color: ${bgColor} !important;`}
  >
    <Navbar />
    
    <main class="flex-grow w-full">
      {variant === 'tool' && (
        <div class="max-w-5xl mx-auto pt-12 px-4 sm:px-6">
          <div class="mb-6">
            <a href="/tools" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-400 hover:bg-amber-500 border border-amber-500 rounded-lg text-neutral-900 font-bold text-xs uppercase tracking-wider transition-colors shadow-xs">
              <span>←</span> Volver a Herramientas
            </a>
          </div>

          <header class="space-y-4 max-w-3xl mx-auto bg-slate-200 border-2 border-slate-400 p-6 sm:p-8 rounded-2xl shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-slate-600 border-b border-slate-300 pb-4">
              {toolCategory && (
                <span class="bg-indigo-100 text-indigo-800 font-medium px-2.5 py-1 rounded-full border border-indigo-200">
                  {toolCategory}
                </span>
              )}
              <div class="flex items-center gap-4 font-mono text-slate-600 ml-auto">
                {toolLastUpdated && <span>Actualizado: <time datetime={toolLastUpdated}>{toolLastUpdated}</time></span>}
                {toolVersion && <span>Versión: {toolVersion}</span>}
              </div>
            </div>

            <div class="space-y-2 text-center">
              <h1 class="text-3xl md:text-4xl font-display font-bold text-neutral-900 tracking-wide">
                {title.split('|')[0]}
              </h1>
              <p class="text-neutral-700 font-medium text-base leading-relaxed">
                {description}
              </p>
            </div>
          </header>
        </div>
      )}

      {variant === 'blog' ? (
        <div class="max-w-4xl mx-auto pt-12 px-4 sm:px-6 w-full">
          <div class="mb-6">
            <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-900 text-amber-400 border border-slate-700 rounded-lg font-bold text-xs uppercase tracking-wider transition-colors shadow-xs">
              <span>←</span> Volver al Blog
            </a>
          </div>

          <header class="space-y-4 bg-slate-200 border border-slate-300 p-6 sm:p-8 rounded-xl shadow-xs mb-8 w-full">
            {blogCategory && (
              <div>
                <span class="bg-amber-100 text-amber-800 font-bold px-3 py-1 rounded-full border border-amber-300 uppercase tracking-wider text-[10px]">
                  {blogCategory}
                </span>
              </div>
            )}

            <div class="space-y-3 text-left">
              <h1 class="text-2xl sm:text-4xl font-display font-bold text-neutral-900 tracking-tight leading-tight">
                {title.split('|')[0]}
              </h1>
              <p class="text-neutral-700 text-sm sm:text-base leading-relaxed">
                {description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-300 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-700 font-mono">
              {pubDate && <span>📅 Publicado el: {pubDate}</span>}
              {author && <span>👤 {author}</span>}
              <span>💻 SYSARMOR TECH</span>
            </div>

            {enfoque && (
              <div class="text-xs text-slate-700 font-mono pt-1">
                <strong>Enfoque:</strong> {enfoque}
              </div>
            )}
          </header>

          <div class="mb-16 w-full bg-white p-6 sm:p-10 rounded-xl border border-slate-200 shadow-xs">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>
    
    <Feedback />
    
    <Footer />
    
    <Analytics />
  </body>
</html>